elData","tags":"","url":"interface/setmodeldata.html"},{"title":"copyModelData – ReMKiT1D","text":"interface private module subroutine copyModelData(this, modelData) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: this class( ModelboundData ), intent(inout), allocatable :: modelData Description Copy model data from this model into modelData","tags":"","url":"interface/copymodeldata.html"},{"title":"copyModelboundDataEntry – ReMKiT1D","text":"interface private module subroutine copyModelboundDataEntry(this, varName, container) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: this character(len=*), intent(in) :: varName Name of data real(kind=rk), intent(inout), allocatable, dimension(..) :: container Container to copy into Description Copy modelbound variable data with given name. Will throw error if no modelbound data is found","tags":"","url":"interface/copymodelbounddataentry.html"},{"title":"calculateMatValsByName – ReMKiT1D","text":"interface private pure module subroutine calculateMatValsByName(this, name, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: this character(len=*), intent(in) :: name type( VariableContainer ), intent(in) :: varCont Description Calculate matrix values of a term by name","tags":"","url":"interface/calculatematvalsbyname.html"},{"title":"updateTermByName – ReMKiT1D","text":"interface private module subroutine updateTermByName(this, name, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: this character(len=*), intent(in) :: name type( VariableContainer ), intent(in) :: varCont Description Update a term by name","tags":"","url":"interface/updatetermbyname.html"},{"title":"initGenerator – ReMKiT1D","text":"interface private module subroutine initGenerator(this, stencilObj, columnVecs, periodicDim, coordInterval) Implementation → Arguments