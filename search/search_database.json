mension(:)","tags":"","url":"proc/radrecombratehydrogen.html"},{"title":"excitationCrossSectionHydrogen – ReMKiT1D","text":"pure module function excitationCrossSectionHydrogen(eGrid, n, m) result(cs) Interface → Calculates hydrogen electron impact excitation cross-section from state n to state m  on given energy grid. Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: eGrid Electron energy grid in eV integer(kind=ik), intent(in) :: n Initial atomic state integer(kind=ik), intent(in) :: m Final atomic state Return Value real(kind=rk), allocatable, dimension(:)","tags":"","url":"proc/excitationcrosssectionhydrogen.html"},{"title":"ionizationCrossSectionHydrogen – ReMKiT1D","text":"pure module function ionizationCrossSectionHydrogen(eGrid, n) result(cs) Interface → Calculates hydrogen electron impact ionization cross-section from state n on given energy grid. Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: eGrid Electron energy grid in eV integer(kind=ik), intent(in) :: n Initial atomic state Return Value real(kind=rk), allocatable, dimension(:)","tags":"","url":"proc/ionizationcrosssectionhydrogen.html"},{"title":"getProcDoF – ReMKiT1D","text":"pure module function getProcDoF(this) result(procDoF) Interface → Getter for procDoFs Arguments Type Intent Optional Attributes Name class( Indexing ), intent(in) :: this Return Value integer(kind=ik), allocatable, dimension(:)","tags":"","url":"proc/getprocdof.html"},{"title":"getNumH – ReMKiT1D","text":"pure module function getNumH(this) result(numH) Interface → Getter for numH Arguments Type Intent Optional Attributes Name class( Indexing ), intent(in) :: this Return Value integer(kind=ik)","tags":"","url":"proc/getnumh~2.html"},{"title":"getNumX – ReMKiT1D","text":"pure module function getNumX(this) result(numX) Interface → Getter for numX Arguments Type Intent Optional Attributes Name class( Indexing ), intent(in) :: this Return Value integer(kind=ik)","tags":"","url":"proc/getnumx.html"},{"title":"getNumV – ReMKiT1D","text":"pure module function getNumV(this) result(numV) Interface → Getter for numV Arguments Type Intent Optional Attributes Name class( Indexing ), intent(in) :: this Return Value integer(kind=ik)","tags":"","url":"proc/getnumv~2.html"},{"title":"findIndex – ReMKiT1D","text":"pure module function findIndex(this, name, xInd, hInd, vInd, local) result(ind) Interface → Return index of degree of freedom associated with variable with given name and with coordinates given by xInd,hInd,vInd\nIf local is true return index in the local implicit vector Arguments Type Intent Optional Attributes Name class( Indexing ), intent(in) :: this character(len=*), intent(in) :: name integer(kind=ik), intent(in) :: xInd integer(kind=ik), intent(in), optional :: hInd integer(kind=ik), intent(in), optional :: vInd logical, intent(in), optional :: local Return Value integer(kind=ik)","tags":"","url":"proc/findindex.html"},{"title":"findDistIndex – ReMKiT1D","text":"pure module function findDistIndex(this, xInd, hInd, vInd, allH, locXInd) result(ind) Interface → Return linear index of distribution corresponding to xInd,hInd,vInd - if allH is true return indexing assuming all harmonics\nare indexed locally. If present locXInd is used to identify the processor Arguments Type Intent Optional Attributes Name class( Indexing ), intent(in) :: this integer(kind=ik), intent(in) :: xInd integer(kind=ik), intent(in) :: hInd integer(kind=ik), intent(in) :: vInd logical, intent(in) :: allH integer(kind=ik), intent(in), optional :: locXInd Return Value integer(kind=ik)","tags":"","url":"proc/finddistindex.html"},{"title":"mapToGlobalIndices – ReMKiT1D","text":"pure module function mapToGlobalIndices(this, name, inputIndices) result(ind) Interface → Returns list of global indices associated with all possible combinations of inputIndices (IntArray of size 1 or 3) and \ngiven variable name Arguments Type Intent Optional Attributes Name class( Indexing ), intent(in) :: this character(len=*), intent(in) :: name type( IntArray ), intent(in), dimension(:) :: inputIndices Return Value integer(kind=ik), allocatable, dimension(:)","tags":"","url":"proc/maptoglobalindices.html"},{"title":"findLocalXIndex – ReMKiT1D","text":"pure module function findLocalXIndex(this, xInd, locXInd) result(ind) Interface → Return local non-distribution variable index corresponding to xInd,if present, locXInd is used to identify the processor Arguments Type Intent Optional Attributes Name class( Indexing ), intent(in) :: this integer(kind=ik), intent(in) :: xInd integer(kind=ik), intent(in), optional :: locXInd Return Value integer(kind=ik)","tags":"","url":"proc/findlocalxindex.html"},{"title":"getAllIndicesOfVar – ReMKiT1D","text":"pure module function getAllIndicesOfVar(this, varInd, procRank) result(ind) Interface → Returns all local indices corresponding to variable with a given index on given processor, accounting for dual grid variables Arguments Type Intent Optional Attributes Name class( Indexing ), intent(in) :: this integer(kind=ik), intent(in) :: varInd integer(kind=ik), intent(in) :: procRank Return Value integer(kind=ik), allocatable, dimension(:)","tags":"","url":"proc/getallindicesofvar.html"},{"title":"initIndexing – ReMKiT1D","text":"pure module subroutine initIndexing(this, part, gridData, varList, xHaloWidth) Interface → Indexing object initialization routine Arguments Type Intent Optional Attributes Name class( Indexing ), intent(inout) :: this type( Partition ), intent(in) :: part Partition component of initialized Indexing object type( Grid ), intent(in) :: gridData Grid object used to initialize Indexing type( VariableList ), intent(in) :: varList Implicit variable list integer(kind=ik), intent(in), optional :: xHaloWidth Width of halo in x-direction - if passed will assume the x-grid is periodic","tags":"","url":"proc/initindexing.html"},{"title":"getCurrentTime – ReMKiT1D","text":"pure module function getCurrentTime(this) result(time) Interface → Getter for currentTime Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(in) :: this Return Value real(kind=rk)","tags":"","url":"proc/getcurrenttime.html"},{"title":"initCompositeIntegrator – ReMKiT1D","text":"pure module subroutine initCompositeIntegrator(this, initialTime, initialTimestep, numIntegrators, dtController) Interface → Composite integraotr initialization routine Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(inout) :: this real(kind=rk), intent(in) :: initialTime Time value before first step real(kind=rk), intent(in) :: initialTimestep Default timestep integer(kind=ik), intent(in) :: numIntegrators Number of integrators expected class( TimestepController ), intent(in), optional :: dtController Optional timestep controller","tags":"","url":"proc/initcompositeintegrator.html"},{"title":"addIntegrator – ReMKiT1D","text":"pure module subroutine addIntegrator(this, integ) Interface → Add Integrator object to composite integrator Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(inout) :: this class( Integrator ), intent(in) :: integ","tags":"","url":"proc/addintegrator.html"},{"title":"addIntegrationStage – ReMKiT1D","text":"pure module subroutine addIntegrationStage(this, integStage) Interface → Add integration stage to composite integrator Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(inout) :: this type( IntegratorCallStep ), intent(in) :: integStage","tags":"","url":"proc/addintegrationstage.html"},{"title":"setTimestepController – ReMKiT1D","text":"pure module subroutine setTimestepController(this, controller) Interface → Setter for dtController Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(inout) :: this class( TimestepController ), intent(in) :: controller","tags":"","url":"proc/settimestepcontroller.html"},{"title":