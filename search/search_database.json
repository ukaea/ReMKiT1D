rity will be derived. If derivDepth is present only variables at that derivation depth are calculated,\notherwise all variables are calculated in derivation depth order Arguments Type Intent Optional Attributes Name class( VariableContainer ), intent(inout) :: this integer(kind=ik), intent(in), optional :: derivPriority integer(kind=ik), intent(in), optional :: derivDepth","tags":"","url":"proc/calculatederivedvars.html"},{"title":"extractImplicitVars – ReMKiT1D","text":"pure module subroutine extractImplicitVars(this, vec) Interface → Extract implicit variables from a locally linearly indexed real vector Arguments Type Intent Optional Attributes Name class( VariableContainer ), intent(inout) :: this real(kind=rk), intent(in), dimension(:) :: vec","tags":"","url":"proc/extractimplicitvars.html"},{"title":"copyImplicitVarsToVec – ReMKiT1D","text":"pure module subroutine copyImplicitVarsToVec(this, vec, ignoreStationary) Interface → Copy variables into a locally linearly indexed real vector. If ignoreStationary is true copies any stationary variables as 0 Arguments Type Intent Optional Attributes Name class( VariableContainer ), intent(inout) :: this real(kind=rk), intent(inout), dimension(:) :: vec logical, intent(in), optional :: ignoreStationary","tags":"","url":"proc/copyimplicitvarstovec.html"},{"title":"copyNamedVarsToVec – ReMKiT1D","text":"module subroutine copyNamedVarsToVec(this, vec, names) Interface → Copy variables into locally indexed vector by name Arguments Type Intent Optional Attributes Name class( VariableContainer ), intent(inout) :: this real(kind=rk), intent(inout), allocatable, dimension(:) :: vec type( StringArray ), intent(in), dimension(:) :: names","tags":"","url":"proc/copynamedvarstovec.html"},{"title":"copyNamedVarsFromVec – ReMKiT1D","text":"pure module subroutine copyNamedVarsFromVec(this, vec, names) Interface → Copy variables from locally indexed vector by name Arguments Type Intent Optional Attributes Name class( VariableContainer ),