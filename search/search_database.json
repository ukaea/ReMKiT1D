onDensity – ReMKiT1D","text":"interface private pure module subroutine setIncludeElectronDensity(this, includeDens) Implementation → Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this logical, intent(in) :: includeDens Description Setter for rateContainsElDensity","tags":"","url":"interface/setincludeelectrondensity.html"},{"title":"noUpdate – ReMKiT1D","text":"interface private module subroutine noUpdate(this, varCont, hostModel, hostData, updatePriority) Implementation → Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont Variable container used in update class( ModelSurrogate ), intent(in), optional :: hostModel Optional host model reference for callbacks during update class( ModelboundData ), intent(in), optional :: hostData Optional host data reference for callbacks during update integer(kind=ik), intent(in), optional :: updatePriority Priority for this update call Description Default update routine - does nothing","tags":"","url":"interface/noupdate~2.html"},{"title":"setCSDim – ReMKiT1D","text":"interface private pure module subroutine setCSDim(this, csDim) Implementation → Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this integer(kind=ik), intent(in) :: csDim Description Setter for csDim","tags":"","url":"interface/setcsdim.html"},{"title":"preparePrinter – ReMKiT1D","text":"public module subroutine preparePrinter(rankIn) Prepare printer utility for use - currently only sets rank Arguments Type Intent Optional Attributes Name integer(kind=ik), intent(in) :: rankIn","tags":"","url":"proc/prepareprinter.html"},{"title":"printNamedInt – ReMKiT1D","text":"private module subroutine printNamedInt(name, input, allProcs) Generic printNamedValue interface component - prints name: input for integer input. Prefaces with rank number if allProcs is true Arguments Type Intent Optional Attributes Name characte