rl":"interface/initlinextrapolationfromjson.html"},{"title":"initLogExtrapolationFromJSON – ReMKiT1D","text":"interface private module subroutine initLogExtrapolationFromJSON(extObj, jsonPrefix, partObj, gridObj, geometryObj, jsonCont, mpiCont, linInterp) Implementation → Arguments Type Intent Optional Attributes Name class( Extrapolation ), intent(inout), allocatable :: extObj character(len=*), intent(in) :: jsonPrefix type( Partition ), intent(in) :: partObj type( Grid ), intent(in) :: gridObj type( Geometry ), intent(in) :: geometryObj type( JSONController ), intent(inout) :: jsonCont type( MPIController ), intent(inout) :: mpiCont logical, intent(in) :: linInterp Description Initialize logarithmic extrapolation from JSON data","tags":"","url":"interface/initlogextrapolationfromjson.html"},{"title":"getScalarParams – ReMKiT1D","text":"interface private pure module function getScalarParams(this) result(params) Implementation → Arguments Type Intent Optional Attributes Name class( ModelBuilder ), intent(in) :: this Return Value type( NamedScalarContainer ) Description Getter for ModelBuilder scalarParams","tags":"","url":"interface/getscalarparams.html"},{"title":"getArrayParams – ReMKiT1D","text":"interface private pure module function getArrayParams(this) result(params) Implementation → Arguments Type Intent Optional Attributes Name class( ModelBuilder ), intent(in) :: this Return Value type( NamedArrayContainer ) Description Getter for ModelBuilder arrayParams","tags":"","url":"interface/getarrayparams.html"},{"title":"loadParams – ReMKiT1D","text":"interface private module subroutine loadParams(this, jsonCont, mpiCont) Implementation → Arguments Type Intent Optional Attributes Name class( ModelBuilder ), intent(inout) :: this type( JSONController ), intent(inout) :: jsonCont JSONController object responsible for reading the config file type( MPIController ), intent(inout) :: mpiCont MPIController object to be used with JSON IO Description Load parameters from \