","text":"interface private module function getGlobalMax(this, input) result(max) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this real(kind=rk), intent(inout) :: input Return Value real(kind=rk) Description Return maximum value of real input computed on all processes using the MPI controller of the modeller","tags":"","url":"interface/getglobalmax.html"},{"title":"initModeller – ReMKiT1D","text":"interface private module subroutine initModeller(this, numModels, initVars, mpiCont, petscCont, commData) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: numModels Number of models this modeller expects to be added type( VariableContainer ), intent(in) :: initVars Initial variable container type( MPIController ), intent(in) :: mpiCont Main MPIController type( PETScController ), intent(in), optional :: petscCont Optional PETSc controller - should be supplied if any integration/manipulation routine uses PETSc type( CommunicationData ), intent(in), optional :: commData Default MPI communication data Description Modeller initialization routine","tags":"","url":"interface/initmodeller.html"},{"title":"addModel – ReMKiT1D","text":"interface private pure module subroutine addModel(this, newModel) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this class( Model ), intent(inout), allocatable :: newModel Description Add a Model to this modeller","tags":"","url":"interface/addmodel.html"},{"title":"copyVarValuesFrom – ReMKiT1D","text":"interface private pure module subroutine copyVarValuesFrom(this, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont Description Copy values of variables from outside variable container into this modeller's container","tags":"","url":"interface/copyvarvaluesfrom.html"},{"title":"copyVarValuesTo – ReMKiT1D","text":"interface private pure module subroutine copyVarValuesTo(this, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( VariableContainer ), intent(inout) :: varCont Description Copy values of variables to outside variable container from this modeller's container","tags":"","url":"interface/copyvarvaluesto.html"},{"title":"setIntegrator – ReMKiT1D","text":"interface private pure module subroutine setIntegrator(this, integ) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this class( Manipulator ), intent(in) :: integ Description Setter for integrator object","tags":"","url":"interface/setintegrator.html"},{"title":"setManipulator – ReMKiT1D","text":"interface private pure module subroutine setManipulator(this, manip) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this class( CompositeManipulator ), intent(in) :: manip Description Setter for manipulator object","tags":"","url":"interface/setmanipulator.html"},{"title":"updateModelTermGroup – ReMKiT1D","text":"interface private module subroutine updateModelTermGroup(this, modelIndex, groupIndex, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: modelIndex integer(kind=ik), intent(in) :: groupIndex type( VariableContainer ), intent(in), optional :: varCont Description Call the update routine of model with given index for the given term group - optionally use variable container other than the\none stored in the modeller","tags":"","url":"interface/updatemodeltermgroup.html"},{"title":"updateModelTermByName – ReMKiT1D","text":"interface private module subroutine updateModelTermByName(this, modelIndex, termName, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: modelIndex character(len=*), intent(in) :: termName type( VariableContainer ), intent(in), optional :: varCont Description Call the update routine of model with given index for the given term name- optionally use variable container other than the\none stored in the modeller","tags":"","url":"interface/updatemodeltermbyname.html"},{"title":"calculateMatGroupValsInModel – ReMKiT1D","text":"interface private pure module subroutine calculateMatGroupValsInModel(this, modelIndex, groupIndex, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: modelIndex integer(kind=ik), intent(in) :: groupIndex type( VariableContainer ), intent(in), optional :: varCont Description Calculate matrix value in implicit term group given by groupIndex in model given by modelIndex, and optionally using variable\ncontainer other than the one stored in the modeller","tags":"","url":"interface/calculatematgroupvalsinmodel.html"},{"title":"calculateMatValsByTermName – ReMKiT1D","text":"interface private pure module subroutine calculateMatValsByTermName(this, modelIndex, termName, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: modelIndex character(len=*), intent(in) :: termName type( VariableContainer ), intent(in), optional :: varCont Description Calculate matrix value in implicit term in model given by modelIndex, and optionally using variable\ncontainer other than the one stored in the modeller","tags":"","url":"interface/calculatematvalsbytermname.html"},{"title":"addModelMatGroupToPETSc – ReMKiT1D","text":"interface private module subroutine addModelMatGroupToPETSc(this, modelIndex, groupIndex, mult, petscGroup) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: modelIndex integer(kind=ik), intent(in) :: groupIndex real(kind=rk), intent(in) :: mult integer(kind=ik), intent(in), optional :: petscGroup Description Send off matrix values of given term group and model to the PETSc controller, multiplied by mult","tags":"","url":"interface/addmodelmatgrouptopetsc.html"},{"title":"assemble – ReMKiT1D","text":"interface private module subroutine assemble(this, withIdentityMat) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this logical, intent(in), optional :: withIdentityMat Description Assemble all of the matrix terms, preallocate PETScController objects and make sure modeller is ready for use. \nIf withIdentityMat is true preallocates diagonal elements for the identity matrix.","tags":"","url":"interface/assemble~2.html"},{"title":"performComm – ReMKiT1D","text":"interface private module subroutine performComm(this, commData, varCont, onlyDepth) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( CommunicationData ), intent(in), optional :: commData Optional non-default communication data type( VariableContainer ), intent(inout), optional :: varCont Optional variable container to perform communications on instead of the modeller's integer(kind=ik), intent(in), optional :: onlyDepth Only communicate variables at given derivation depth Description Perform communications using the modeller's MPI controller - optionally uses external CommunicationData instructions or \nexchanges data in external variable container","tags":"","url":"interface/performcomm.html"},{"title":"safeCommAndDeriv – ReMKiT1D","text":"interface private module subroutine safeCommAndDeriv(this, commData, varCont, derivPriority) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( CommunicationData ), intent(in), optional :: commData Optional non-default communication data type( VariableContainer ), intent(inout), optional :: varCont Optional variable container to perform communications on instead of the modeller's integer(kind=ik), intent(in), optional :: derivPriority Derivation priority for interlaced calls Description Perform communications interlaced with derivation calls of increasing derivation depth","tags":"","url":"interface/safecommandderiv.html"},{"title":"callManipulator – ReMKiT1D","text":"interface private module subroutine callManipulator(this, priority, inVars, outVars) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: priority type( VariableContainer ), intent(in), optional :: inVars type( VariableContainer ), intent(inout), optional :: outVars Description Call optional CompositeManipulator manipulate routine with inVars and outVars - the default for the optional VariableContainers is the modeller's VariableContainer","tags":"","url":"interface/callmanipulator.html"},{"title":"integrate – ReMKiT1D","text":"interface private module subroutine integrate(this, inVars, outVars, requestedTimestep) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( VariableContainer ), intent(in), optional :: inVars type( VariableContainer ), intent(inout), optional :: outVars real(kind=rk), intent(in), optional :: requestedTimestep Description Call manipulator affect routine with inVars and outVars - the default for the optional VariableContainers is the modeller's VariableContainer\nOptionally request a timestep length (only available with composite integrators)","tags":"","url":"interface/integrate.html"},{"title":"linearSolvePETSc – ReMKiT1D","text":"interface private module subroutine linearSolvePETSc(this, knownVec, unknownVec, addIdentityMat, convReason, petscGroup) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this real(kind=rk), intent(in), dimension(:) ::