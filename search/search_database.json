Data ), intent(in), optional :: commData Default MPI communication data","tags":"","url":"proc/initmodeller.html"},{"title":"copyVarValuesFrom – ReMKiT1D","text":"pure module subroutine copyVarValuesFrom(this, varCont) Interface → Copy values of variables from outside variable container into this modeller's container Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont","tags":"","url":"proc/copyvarvaluesfrom.html"},{"title":"copyVarValuesTo – ReMKiT1D","text":"pure module subroutine copyVarValuesTo(this, varCont) Interface → Copy values of variables to outside variable container from this modeller's container Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( VariableContainer ), intent(inout) :: varCont","tags":"","url":"proc/copyvarvaluesto.html"},{"title":"setIntegrator – ReMKiT1D","text":"pure module subroutine setIntegrator(this, integ) Interface → Setter for integrator object Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this class( Manipulator ), intent(in) :: integ","tags":"","url":"proc/setintegrator.html"},{"title":"setManipulator – ReMKiT1D","text":"pure module subroutine setManipulator(this, manip) Interface → Setter for manipulator object Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this class( CompositeManipulator ), intent(in) :: manip","tags":"","url":"proc/setmanipulator.html"},{"title":"updateModelTermGroup – ReMKiT1D","text":"module subroutine updateModelTermGroup(this, modelIndex, groupIndex, varCont) Interface → Call the update routine of model with given index for the given term group - optionally use variable container other than the\none stored in the modeller Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: modelIndex integer(kind=ik), intent(in) :: groupIndex type( VariableContainer ), intent(in), optional :: varCont","tags":"","url":"proc/updatemodeltermgroup.html"},{"title":"updateModelTermByName – ReMKiT1D","text":"module subroutine updateModelTermByName(this, modelIndex, termName, varCont) Interface → Call the update routine of model with given index for the given term name- optionally use variable container other than the\none stored in the modeller Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: modelIndex character(len=*), intent(in) :: termName type( VariableContainer ), intent(in), optional :: varCont","tags":"","url":"proc/updatemodeltermbyname.html"},{"title":"calculateMatGroupValsInModel – ReMKiT1D","text":"pure module subroutine calculateMatGroupValsInModel(this, modelIndex, groupIndex, varCont) Interface → Calculate matrix value in implicit term group given by groupIndex in model given by modelIndex, and optionally using variable\ncontainer other than the one stored in the modeller Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: modelIndex integer(kind=ik), intent(in) :: groupIndex type( VariableContainer ), intent(in), optional :: varCont","tags":"","url":"proc/calculatematgroupvalsinmodel.html"},{"title":"calculateMatValsByTermName – ReMKiT1D","text":"pure module subroutine calculateMatValsByTermName(this, modelIndex, termName, varCont) Interface → Calculate matrix value in implicit term in model given by modelIndex, and optionally using variable\ncontainer other than the one stored in the modeller Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: modelIndex character(len=*), intent(in) :: termName type( VariableContainer ), intent(in), optional :: varCont","tags":"","url":"proc/calculatematvalsbytermname.html"},{"title":"addModelMatGroupToPETSc – ReMKiT1D","text":"module subroutine addModelMatGroupToPETSc(this, modelIndex, groupIndex, mult, petscGroup) Interface → Send off matrix values of given term group and model to the PETSc controller, multiplied by mult Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: modelIndex integer(kind=ik), intent(in) :: groupIndex real(kind=rk), intent(in) :: mult integer(kind=ik), intent(in), optional :: petscGroup","tags":"","url":"proc/addmodelmatgrouptopetsc.html"},{"title":"addModel – ReMKiT1D","text":"pure module subroutine addModel(this, newModel) Interface → Add a Model to this modeller Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this class( Model ), intent(inout), allocatable :: newModel","tags":"","url":"proc/addmodel.html"},{"title":"assemble – ReMKiT1D","text":"module subroutine assemble(this, withIdentityMat) Interface → Assemble all of the matrix terms, preallocate PETScController objects and make sure modeller is ready for use. \nIf withIdentityMat is true preallocates diagonal elements for the identity matrix. Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this logical, intent(in), optional :: withIdentityMat","tags":"","url":"proc/assemble~2.html"},{"title":"performComm – ReMKiT1D","text":"module subroutine performComm(this, commData, varCont, onlyDepth) Interface → Perform communications using the modeller's MPI controller - optionally uses external CommunicationData instructions or \nexchanges data in external variable container Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( CommunicationData ), intent(in), optional :: commData Optional non-default communication data type( VariableContainer ), intent(inout), optional :: varCont Optional variable container to perform communications on instead of the modeller's integer(kind=ik), intent(in), optional :: onlyDepth Only communicate variables at given derivation depth","tags":"","url":"proc/performcomm.html"},{"title":"safeCommAndDeriv – ReMKiT1D","text":"module subroutine safeCommAndDeriv(this, commData, varCont, derivPriority) Interface → Perform communications interlaced with derivation calls of increasing derivation depth Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( CommunicationData ), intent(in), optional :: commData Optional non-default communication data type( VariableContainer ), intent(inout), optional :: varCont Optional variable container to perform communications on instead of the modeller's integer(kind=ik), intent(in), optional :: derivPriority Derivation priority for interlaced calls","tags":"","url":"proc/safecommandderiv.html"},{"title":"callManipulator – ReMKiT1D","text":"module subroutine callManipulator(this, priority, inVars, outVars) Interface → Call optional CompositeManipulator manipulate routine with inVars and outVars - the default for the optional VariableContainers is the modeller's VariableContainer Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: priority type( VariableContainer ), intent(in), optional :: inVars type( VariableContainer ), intent(inout), optional :: outVars","tags":"","url":"proc/callmanipulator.html"},{"title":"integrate – ReMKiT1D","text":"module subroutine integrate(this, inVars, outVars, requestedTimestep) Interface → Call manipulator affect routine with inVars and outVars - the default for the optional VariableContainers is the modeller's VariableContainer\nOptionally request a timestep length (only available with composite integrators) Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( VariableContainer ), intent(in), optional :: inVars type( VariableContainer ), intent(inout), optional :: outVars real(kind=rk), intent(in), optional :: requestedTimestep","tags":"","url":"proc/integrate.html"},{"title":"linearSolvePETSc – ReMKiT1D","text":"module subroutine linearSolvePETSc(this, knownVec, unknownVec, addIdentityMat, convReason, petscGroup) Interface → Call linearSolve routine on PETScController of this modeller. Creates PETSc objects if they've not yet been created. If \naddIdentityMat is true adds an identity matrix to the PETSc matrix. Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this real(kind=rk), intent(in), dimension(:) :: knownVec real(kind=rk), intent(out), dimension(:) :: unknownVec logical, intent(in) :: addIdentityMat integer(kind=ik), intent(inout) :: convReason integer(kind=ik), intent(in), optional :: petscGroup","tags":"","url":"proc/linearsolvepetsc.html"},{"title":"calculateIdentityMat – ReMKiT1D","text":"module subroutine calculateIdentityMat(this, indexingObj) Interface → Initializes the identity matrix of this modeller based on Indexing object Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( Indexing ), intent(in) :: indexingObj","tags":"","url":"proc/calculateidentitymat.html"},{"title":"updateModelData – ReMKiT1D","text":"module subroutine updateModelData(this, modelIndex, varCont, updatePriority) Interface → Update modelbound data of model with given index if that data is allocated Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this integer(kind=ik), intent(in) :: modelIndex Model index for model whose data is to be update type( VariableContainer ), intent(in) :: varCont Variable container to be used in update integer(kind=ik), intent(in), optional :: updatePriority Priority for this update call","tags":"","url":"proc/updatemodeldata~2.html"},{"title":"updateAllModelData – ReMKiT1D","text":"module subroutine updateAllModelData(this, varCont) Interface → Update the modelbound data of all models Arguments Type Intent Optional Attributes Name class( Modeller ), intent(inout) :: this type( VariableContainer ), intent(in), optional :: varCont Variable container