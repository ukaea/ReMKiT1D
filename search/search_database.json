nsion(:) :: controlRanges integer(kind=ik), intent(in), optional, dimension(:) :: derivIndices","tags":"","url":"proc/initrangefilterderiv.html"},{"title":"initInterpValGen – ReMKiT1D","text":"module subroutine initInterpValGen(this, partitionObj, geometryObj, procRank, staggeredGridMode) Interface → Central differentiation stencil value generator initialization routine Arguments Type Intent Optional Attributes Name class( InterpStencilGenerator ), intent(inout) :: this type( Partition ), intent(in) :: partitionObj Partition object used to determine local number of rows type( Geometry ), intent(in) :: geometryObj Geometry object used to get interpolation/extrapolation coefficients integer(kind=ik), intent(in) :: procRank Current processor rank logical, intent(in), optional :: staggeredGridMode If true will interpolate from staggered to regular grid.","tags":"","url":"proc/initinterpvalgen.html"},{"title":"calcInterpVals – ReMKiT1D","text":"module subroutine calcInterpVals(this, varCont, res, mbData, hostModel) Interface → Calculate interpolation stencil values in place (does not depend on varCont) Arguments Type Intent Optional Attributes Name class( InterpStencilGenerator ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont type( RealArray ), intent(inout), allocatable, dimension(:) :: res class( ModelboundData ), intent(in), optional :: mbData class( ModelSurrogate ), intent(in), optional :: hostModel","tags":"","url":"proc/calcinterpvals.html"},{"title":"getNonlinTol – ReMKiT1D","text":"pure module function getNonlinTol(this) result(nonlinTol) Interface → Getter for nonlinTol value Arguments Type Intent Optional Attributes Name class( PicardBDEIntegrator ), intent(in) :: this Return Value real(kind=rk)","tags":"","url":"proc/getnonlintol.html"},{"title":"getMaxIterations – ReMKiT1D","text":"pure module function getMaxIterations(this) result(maxIter) Interface → Geter for maxIterations value Arguments Type Intent Optional Attributes Name class