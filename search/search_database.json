nmentWrapper ), intent(inout) :: envObj character(len=*), intent(in) :: jsonPrefix prefix for JSON keys for this template character(len=*), intent(in) :: evolvedVar character(len=*), intent(in) :: implicitVar class( ModelboundCRMData ), intent(in) :: mbData Description Initialize variable mapping Boltzmann kinetic stencil template based on environment object and JSON file.","tags":"","url":"interface/initvariableboltzmannstencil.html"},{"title":"initVariableBoltzmannStencilDirect – ReMKiT1D","text":"interface public module subroutine initVariableBoltzmannStencilDirect(stencilTemplateObj, envObj, evolvedVar, implicitVar, mbData, evolvedHarmonic, transitionIndex, absorptionTerm, superelasticTerm) Implementation → Arguments Type Intent Optional Attributes Name type( StencilTemplate ), intent(inout) :: stencilTemplateObj type( EnvironmentWrapper ), intent(inout) :: envObj character(len=*), intent(in) :: evolvedVar character(len=*), intent(in) :: implicitVar class( ModelboundCRMData ), intent(in) :: mbData integer(kind=ik), intent(in) :: evolvedHarmonic integer(kind=ik), intent(in) :: transitionIndex logical, intent(in) :: absorptionTerm logical, intent(in) :: superelasticTerm Description Initialize variable mapping Boltzmann kinetic stencil template based on environment non-JSON inputs.","tags":"","url":"interface/initvariableboltzmannstencildirect.html"},{"title":"calculateTree – ReMKiT1D","text":"interface private module function calculateTree(this, inputArray, indices) result(output) Implementation → Arguments Type Intent Optional Attributes Name class( CalculationTreeDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk),allocatable,dimension(:)","tags":"","url":"interface/calculatetree.html"},{"title":"initCalculationTreeDeriv – ReMKiT1D","text":"interface private module subroutine initCalculationTreeDeriv(this, flattenedTree) Implementation → Arguments Type Intent Optional Attributes Name class( CalculationTreeDerivation ), intent(inout) :: this type( FlatTree ), intent(in) :: flattenedTree Description Initialize calculation tree derivation using flattened tree","tags":"","url":"interface/initcalculationtreederiv.html"},{"title":"initInterpValGen – ReMKiT1D","text":"interface private module subroutine initInterpValGen(this, partitionObj, geometryObj, procRank, staggeredGridMode) Implementation → Arguments Type Intent Optional Attributes Name class( InterpStencilGenerator ), intent(inout) :: this type( Partition ), intent(in) :: partitionObj Partition object used to determine local number of rows type( Geometry ), intent(in) :: geometryObj Geometry object used to get interpolation/extrapolation coefficients integer(kind=ik), intent(in) :: procRank Current processor rank logical, intent(in), optional :: staggeredGridMode If true will interpolate from staggered to regular grid. Description Central differentiation stencil value generator initialization routine","tags":"","url":"interface/initinterpvalgen.html"},{"title":"calcInterpVals – ReMKiT1D","text":"interface private module subroutine calcInterpVals(this, varCont, res, mbData, hostModel) Implementation → Arguments Type Intent Optional Attributes Name class( InterpStencilGenerator ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont type( RealArray ), intent(inout), allocatable, dimension(:) :: res class( ModelboundData ), intent(in), optional :: mbData class( ModelSurrogate ), intent(in), optional :: hostModel Description Calculate interpolation stencil values in place (does not depend on varCont)","tags":"","url":"interface/calcinterpvals.html"},{"title":"initEvaluator – ReMKiT1D","text":"interface private pure module subroutine initEvaluator(this, resultVarIndex, modelIndices, termNames, accumulate, update) Implementation → Arguments Type Intent Optional Attributes Name class( TermEvaluator ), intent(inout) :: this integer(kind=ik),