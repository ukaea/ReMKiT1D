g routine Arguments Type Intent Optional Attributes Name class( Stencil1D ), intent(in) :: this integer(kind=ik), intent(in) :: inputCoord Input coordinate value integer(kind=ik), intent(in) :: dimSize Size of dimension in which mapping is done logical, intent(in), optional :: periodic True if dimension is periodic Return Value integer(kind=ik), allocatable, dimension(:)","tags":"","url":"proc/mapcoords~2.html"},{"title":"getMask – ReMKiT1D","text":"pure module function getMask(this, coord, dimSize, periodic) result(res) Interface → Get logical mask for included stencil points for given coordinate and dimension size. If periodic, the stencil dimension is treated as being periodic with periodicity equal to dimSize. Arguments Type Intent Optional Attributes Name class( Stencil1D ), intent(in) :: this integer(kind=ik), intent(in) :: coord integer(kind=ik), intent(in) :: dimSize logical, intent(in), optional :: periodic Return Value logical, allocatable, dimension(:)","tags":"","url":"proc/getmask.html"},{"title":"getStencilDims – ReMKiT1D","text":"pure module function getStencilDims(this) result(dim) Interface → Returns size of stencil Arguments Type Intent Optional Attributes Name class( Stencil1D ), intent(in) :: this Return Value integer(kind=ik)","tags":"","url":"proc/getstencildims.html"},{"title":"isStencilFixed – ReMKiT1D","text":"pure module function isStencilFixed(this) result(stencilIsFixed) Interface → Check if stencil is fixed Arguments Type Intent Optional Attributes Name class( Stencil1D ), intent(in) :: this Return Value logical","tags":"","url":"proc/isstencilfixed.html"},{"title":"getFixedStencil – ReMKiT1D","text":"pure module function getFixedStencil(this) result(fixedStencil) Interface → Return values of fixed stencil Arguments Type Intent Optional Attributes Name class( Stencil1D ), intent(in) :: this Return Value type( IntArray ), allocatable, dimension(:)","tags":"","url":"proc/getfixedstencil.html"},{"title":"initStencil – ReMKiT1D","text":"pure module subroutine initStencil(this, rawStencil, fixedStencil) Interface → Stencil1D object initialization routine Arguments Type Intent Optional Attributes Name class( Stencil1D ), intent(inout) :: this integer(kind=ik), intent(in), optional, dimension(:) :: rawStencil Optional raw stencil, defaults to [0] - a diagonal stencil. type( IntArray ), intent(in), optional, dimension(:) :: fixedStencil Optional fixed stencil","tags":"","url":"proc/initstencil~2.html"},{"title":"getNumVars – ReMKiT1D","text":"pure module function getNumVars(this) result(numVars) Interface → Returns number of variables in list Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this Return Value integer(kind=ik)","tags":"","url":"proc/getnumvars.html"},{"title":"getVarNames – ReMKiT1D","text":"pure module function getVarNames(this) result(names) Interface → Getter of names Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this Return Value type( StringArray ), allocatable, dimension(:)","tags":"","url":"proc/getvarnames.html"},{"title":"getVarName – ReMKiT1D","text":"pure module function getVarName(this, ind) result(name) Interface → Return variable name at index ind Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value character(len=:), allocatable","tags":"","url":"proc/getvarname.html"},{"title":"getVarPriority – ReMKiT1D","text":"pure module function getVarPriority(this, ind) result(priority) Interface → Return priority of variable with given index Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value integer(kind=ik)","tags":"","url":"proc/getvarpriority.html"},{"title":"isVarNameRegistered – ReMKiT1D","text":"pure module function isVarNameRegistered(this, name) result(reg) Interface → Check whether variable with given name is registered Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this character(len=*), intent(in) :: name Return Value logical","tags":"","url":"proc/isvarnameregistered.html"},{"title":"isVarDist – ReMKiT1D","text":"pure module function isVarDist(this, ind) result(distf) Interface → Check whether variable with given index is a full distribution function Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value logical","tags":"","url":"proc/isvardist.html"},{"title":"isVarSingleHarmonic – ReMKiT1D","text":"pure module function isVarSingleHarmonic(this, ind) result(singleH) Interface → Check whether variable with given index is a  single harmonic Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value logical","tags":"","url":"proc/isvarsingleharmonic.html"},{"title":"isVarScalar – ReMKiT1D","text":"pure module function isVarScalar(this, ind) result(scal) Interface → Check whether variable with given index is a scalar Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value logical","tags":"","url":"proc/isvarscalar.html"},{"title":"isVarOnDualGrid – ReMKiT1D","text":"pure module function isVarOnDualGrid(this, ind) result(dual) Interface → Check whether variable with given index is a on dual grid Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value logical","tags":"","url":"proc/isvarondualgrid.html"},{"title":"isVarStationary – ReMKiT1D","text":"pure module function isVarStationary(this, ind) result(stat) Interface → Check whether variable with given index is stationary Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value logical","tags":"","url":"proc/isvarstationary.html"},{"title":"getVarIndex – ReMKiT1D","text":"pure module function getVarIndex(this, name) result(ind) Interface → Get index of variable with given name Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this character(len=*), intent(in) :: name Return Value integer(kind=ik)","tags":"","url":"proc/getvarindex.html"},{"title":"combineWith – ReMKiT1D","text":"pure module function combineWith(this, other) result(res) Interface → Combine two lists into one Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this type( VariableList ), intent(in) :: other Return Value type( VariableList )","tags":"","url":"proc/combinewith.html"},{"title":"initVarList – ReMKiT1D","text":"pure module subroutine initVarList(this) Interface → Variable list initialization routine Arguments Type Intent Optional Attributes Name class( VariableList ), intent(inout) :: this","tags":"","url":"proc/initvarlist.html"},{"title":"addVar – ReMKiT1D","text":"pure module subroutine addVar(this, name, isDist, isSingleHarmonic, isScalar, isOnDualGrid, isStationary, priority) Interface → Add variable with given name to list; isDist determines if variable is a distribution function and is .false. by default;\nisSingleHarmonic sets whether a given distribution is only a single harmonic - i.e. a function of just x and v\nisScalar tags variable as a scalar (will be stored as a dimension 1 array)\nisOnDualGrid marks variable as living on the dual/staggered grid (or having staggered harmonics if it's a distribution)\nisStationary marks variable as having d/dt=0\npriority is an integer governing operations such as variable derivation Arguments Type Intent Optional Attributes Name class( VariableList ), intent(inout) :: this character(len=*), intent(in) :: name logical, intent(in), optional :: isDist logical, intent(in), optional :: isSingleHarmonic logical, intent(in), optional :: isScalar logical, intent(in), optional :: isOnDualGrid logical, intent(in), optional :: isStationary integer(kind=ik), intent(in), optional :: priority","tags":"","url":"proc/addvar.html"},{"title":"calculateIJInt – ReMKiT1D","text":"module function calculateIJInt(this, inputArray, indices) result(output) Interface → Arguments Type Intent Optional Attributes Name class( IJIntDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk), allocatable, dimension(:)","tags":"","url":"proc/calculateijint.html"},{"title":"initIJInt – ReMKiT1D","text":"module subroutine initIJInt(this, vSpaceObj, ind, isJInt) Interface → Initialize Shkarofsky I/J integral derivation derivation Arguments Type Intent Optional Attributes Name class( IJIntDerivation ), intent(inout) :: this type( VSpace ), intent(in) :: vSpaceObj integer(kind=ik), intent(in) :: ind Index of indegral logical, intent(in), optional :: isJInt If true the lower triangular J integral is calculated instead of the I integral. Defaults to false.","tags":"","url":"proc/initijint.html"},{"title":"initVarBoltzGen – ReMKiT1D","text":"module subroutine initVarBoltzGen(this, vspaceObj, transitionIndex, lNum, absorptionTerm, superelasticTerm) Interface → Boltzmann emission/absorption stencil value generator initialization routine with variable cross-sections and weights Arguments Type Intent Optional Attributes Name class( VariableBoltzmannStencilGen ), intent(inout) :: this type( VSpace ), intent(in) :: vspaceObj VSpace object used to get grid integer(kind=ik), intent(in) :: transitionIndex Index of transition whose cross-section is required integer(kind=ik), intent(in), optional :: lNum Harmonic index of cross-section required. Used only if absorption term logical, intent(in), optional :: absorptionTerm True if this is an absorption term stencil generator. Defaults to false. logical, intent(in), optional :: superelasticTerm True if this is for a superelastic term (negative transition cost). Defaults to false.","tags":"","url":"proc/initvarboltzgen.html"},{"title":"calcVarBoltzVals – ReMKiT1D","text":"module subroutine calcVarBoltzVals(this, varCont, res, mbData, hostModel) Interface → Calculate Boltzmann emission/absorption stencil values in place (does not depend on varCont) Arguments Type Intent Optional Attributes Name class( VariableBoltzmannStencilGen ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont type( RealArray ), intent(inout), allocatable, dimension(:) :: res class( ModelboundData ), intent(in), optional :: mbData class( ModelSurrogate ), intent(in), optional :: hostModel","tags":"","url":"proc/calcvarboltzvals.html"},{"title":"hasIndices – ReMKiT1D","text":"pure module function hasIndices(this, row, column) result(found) Interface → Return true if all elements with indices (row,column) are present in sparsity pattern Arguments Type Intent Optional Attributes Name class( COOSparsityPattern ), intent(in) :: this integer(kind=ik), intent(in), dimension(:) :: row Row indices integer(kind=ik), intent(in), dimension(:) :: column Column indices Return Value logical","tags":"","url":"proc/hasindices.html"},{"title":"findLocationOfIndices – ReMKiT1D","text":"pure module function findLocationOfIndices(this, row, column) result(indices) Interface → Return indices with given values of (row,column) Arguments Type Intent Optional Attributes Name class( COOSparsityPattern ), intent(in) :: this integer(kind=ik), intent(in), dimension(:) :: row Row index integer(kind=ik), intent(in), dimension(:) :: column Column index Return Value integer(kind=ik), allocatable, dimension(:)","tags":"","url":"proc/findlocationofindices.html"},{"title":"initCooSparsityPattern – ReMKiT1D","text":"pure module subroutine initCooSparsityPattern(this, numRows, numCols, bufferSize, rowOffset) Interface → COO sparsity pattern initialization routine Arguments Type Intent Optional Attributes Name class( COOSparsityPattern ), intent(inout) :: this integer(kind=ik), intent(in) :: numRows Matrix number of rows integer(kind=ik), intent(in) :: numCols Matrix number of columns integer(kind=ik), intent(in), optional :: bufferSize Preallocated rolling buffer size integer(kind=ik), intent(in), optional :: rowOffset Row offset for distributed arrays","tags":"","url":"proc/initcoosparsitypattern.html"},{"title":"addEntry – ReMKiT1D","text":"pure module subroutine addEntry(this, row, column) Interface → Add entry if not already present Arguments Type Intent Optional Attributes Name class( COOSparsityPattern ), intent(inout) :: this integer(kind=ik), intent(in) :: row Row index integer(kind=ik), intent(in) :: column Column Index","tags":"","url":"proc/addentry.html"},{"title":"addPattern – ReMKiT1D","text":"pure module subroutine addPattern(this, pattern, rowOffset, colOffset) Interface → Add entries from existing pattern that are not already present Arguments Type Intent Optional Attributes Name class( COOSparsityPattern ), intent(inout) :: this type( COOSparsityPattern ), intent(in) :: pattern Pattern to add to this pattern integer(kind=ik), intent(in), dimension(:) :: rowOffset Array by which to offset pattern row indices before adding integer(kind=ik), intent(in), dimension(:) :: colOffset Array by which to offset pattern column indices before adding","tags":"","url":"proc/addpattern.html"},{"title":"initMultGen – ReMKiT1D","text":"module subroutine initMultGen(this, coreObj, fluidCol, initXVals, initHVals, initVVals) Interface → Multiplicative stencil value generator initialization routine Arguments Type Intent Optional Attributes Name class( MultiplicativeStencilGen ), intent(inout) :: this type( MultiplicativeGeneratorCore ), intent(inout), allocatable :: coreObj Multiplicative core - will be deallocated after call logical, intent(in), optional :: fluidCol True if the column variable for this stencil is fluid. type( RealArray ), intent(in), optional, dimension(:) :: initXVals Optional initial raw x stencil values. Defaults to unallocated. type( RealArray ), intent(in), optional, dimension(:) :: initHVals Optional initial raw h stencil values. Defaults to unallocated. type( RealArray ), intent(in), optional, dimension(:) :: initVVals Optional initial raw v stencil values. Defaults to unallocated.","tags":"","url":"proc/initmultgen.html"},{"title":"calcMultVals – ReMKiT1D","text":"module subroutine calcMultVals(this, varCont, res, mbData, hostModel) Interface → Calculate multiplicative stencil values in place Arguments Type Intent Optional Attributes Name class( MultiplicativeStencilGen ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont type( RealArray ), intent(inout), allocatable, dimension(:) :: res class( ModelboundData ), intent(in), optional :: mbData class( ModelSurrogate ), intent(in), optional :: hostModel","tags":"","url":"proc/calcmultvals.html"},{"title":"setXGen – ReMKiT1D","text":"module subroutine setXGen(this, gen) Interface → Setter for xStencilGen. Arguments Type Intent Optional Attributes Name class( MultiplicativeStencilGen ), intent(inout) :: this class( JaggedArrayGenerator ), intent(in) :: gen","tags":"","url":"proc/setxgen.html"},{"title":"setHGen – ReMKiT1D","text":"module subroutine setHGen(this, gen) Interface → Setter for hStencilGen. Arguments Type Intent Optional Attributes Name class( MultiplicativeStencilGen ), intent(inout) :: this class( JaggedArrayGenerator ), intent(in) :: gen","tags":"","url":"proc/sethgen.html"},{"title":"setVGen – ReMKiT1D","text":"module subroutine setVGen(this, gen) Interface → Setter for vStencilGen. Arguments Type Intent Optional Attributes Name class( MultiplicativeStencilGen ), intent(inout) :: this class( JaggedArrayGenerator ), intent(in) :: gen","tags":"","url":"proc/setvgen.html"},{"title":"initBoltzGen – ReMKiT1D","text":"module subroutine initBoltzGen(this, vspaceObj, transitionIndex, fixedWIndex, lNum, absorptionTerm, dbTerm) Interface → Boltzmann emission/absorption stencil value generator initialization routine Arguments Type Intent Optional Attributes Name class( FixedBoltzmannStencilGen ), intent(inout) :: this type( VSpace ), intent(in) :: vspaceObj VSpace object used to get grid integer(kind=ik), intent(in) :: transitionIndex Index of transition whose cross-section is required integer(kind=ik), intent(in) :: fixedWIndex Fixed inelastic mapping index associated with the transition integer(kind=ik), intent(in), optional :: lNum Harmonic index of cross-section required. Used only if absorption term logical, intent(in), optional :: absorptionTerm True if this is an absorption term stencil generator. Defaults to false. logical, intent(in), optional :: dbTerm True if this is a detailed balance term stencil generator. Defaults to false.","tags":"","url":"proc/initboltzgen.html"},{"title":"calcBoltzVals – ReMKiT1D","text":"module subroutine calcBoltzVals(this, varCont, res, mbData, hostModel) Interface → Calculate Boltzmann emission/absorption stencil values in place (does not depend on varCont) Arguments Type Intent Optional Attributes Name class( FixedBoltzmannStencilGen ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont type( RealArray ), intent(inout), allocatable, dimension(:) :: res class( ModelboundData ), intent(in), optional :: mbData class( ModelSurrogate ), intent(in), optional :: hostModel","tags":"","url":"proc/calcboltzvals.html"},{"title":"calculateLocVal – ReMKiT1D","text":"module function calculateLocVal(this, inputArray, indices) result(output) Interface → Arguments Type Intent Optional Attributes Name class( LocValExtractorDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk), allocatable, dimension(:)","tags":"","url":"proc/calculatelocval.html"},{"title":"initLocValDeriv – ReMKiT1D","text":"module subroutine initLocValDeriv(this, partObj, numProc, targetX) Interface → Initialize harmonic extractor derivation Arguments Type Intent Optional Attributes Name class( LocValExtractorDerivation ), intent(inout) :: this type( Partition ), intent(in) :: partObj integer(kind=ik), intent(in) :: numProc integer(kind=ik), intent(in) :: targetX x location to extract from - global indexing","tags":"","url":"proc/initlocvalderiv.html"},{"title":"logLee – ReMKiT1D","text":"pure module function logLee(Te, ne) result(res) Interface → Calculate Coulomb logarithm for electron-electron collisions (NRL Formulary 2013 page 34 equation a) Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Te Electron temperature in eV real(kind=rk), intent(in) :: ne Electron density in  m&#94;{-3} Return Value real(kind=rk)","tags":"","url":"proc/loglee.html"},{"title":"logLei – ReMKiT1D","text":"pure module function logLei(Te, ne, Z, removeDisc) result(res) Interface → Calculate Coulomb logarithm for electron-ion collisions (NRL Formulary 2013 page 34 equation b). Assumes Te > TiZm_e/m_i Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Te Electron temperature in eV real(kind=rk), intent(in) :: ne Electron density in m&#94;{-3} real(kind=rk), intent(in) :: Z Ion charge logical, intent(in), optional :: removeDisc Remove the discontinuity at 10eV by moving the branch switch to Te = Z 2 * e 2 eV. Defaults to .false. Return Value real(kind=rk)","tags":"","url":"proc/loglei.html"},{"title":"logLii – ReMKiT1D","text":"pure module function logLii(Z1, Z2, mRatio, n1, n2, T1, T2) result(res) Interface → Calculate Coulomb logarithm for ion-ion collisions (NRL Formulary 2013 page 34 equation c). Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Z1 Ion charge for first species real(kind=rk), intent(in) :: Z2 Ion charge for second species real(kind=rk), intent(in) :: mRatio Mass ratio m2/m1 real(kind=rk), intent(in) :: n1 First ion species density in m&#94;{-3} real(kind=rk), intent(in) :: n2 Second ion species density in m&#94;{-3} real(kind=rk), intent(in) :: T1 First ion temperature in eV real(kind=rk), intent(in) :: T2 Second ion temperature in eV Return Value real(kind=rk)","tags":"","url":"proc/loglii.html"},{"title":"shPotDrop – ReMKiT1D","text":"pure module function shPotDrop(massRatio, tempRatio) result(res) Interface → Calculate sheath potential drop for 2 component plasma in units of kTe/e Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: massRatio Mass ratio me/mi real(kind=rk), intent(in) :: tempRatio Ion to electron temperature ratio Return Value real(kind=rk)","tags":"","url":"proc/shpotdrop.html"},{"title":"collTimeei – ReMKiT1D","text":"pure module function collTimeei(Te, ne, Z, logL) result(res) Interface → Calculate electron-ion collision time in seconds. This is not the Braginskii time, which can be calculated as this value \nmultiplied by 3 sqrt(pi)/4 . Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Te Electron temperature in eV real(kind=rk), intent(in) :: ne Electron density in  m&#94;{-3} real(kind=rk), intent(in) :: Z Ion charge real(kind=rk), intent(in) :: logL Coulomb logarithm to be used Return Value real(kind=rk)","tags":"","url":"proc/colltimeei.html"},{"title":"elPlasmaOscFreq – ReMKiT1D","text":"pure module function elPlasmaOscFreq(ne) result(res) Interface → Calculate cold electron plasma oscillation frequency in s&#94;{-1} Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: ne Electron density in  m&#94;{-3} Return Value real(kind=rk)","tags":"","url":"proc/elplasmaoscfreq.html"},{"title":"elVthermal – ReMKiT1D","text":"pure module function elVthermal(Te) result(res) Interface → Mean thermal electron speed Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Te Electron temperature in eV Return Value real(kind=rk)","tags":"","url":"proc/elvthermal.html"},{"title":"vSonic – ReMKiT1D","text":"pure module function vSonic(Te, Ti, mi, ePolytropic, iPolytropic) result(res) Interface → Sonic speed caclulated as sqrt((ePoly Te + iPoly Ti)/mi) Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Te Electron temperature in eV real(kind=rk), intent(in) :: Ti Ion temperature in eV real(kind=rk), intent(in) :: mi Ion mass real(kind=rk), intent(in) :: ePolytropic Electron polytropic coefficient real(kind=rk), intent(in) :: iPolytropic Ion polytropic coefficient Return Value real(kind=rk)","tags":"","url":"proc/vsonic.html"},{"title":"normMaxwellian – ReMKiT1D","text":"pure module function normMaxwellian(n, T, vPoints) result(res) Interface → Returns a normalized stationary Maxwellian evaluated at vPoints. Assumes that velocity and temperature are normalized in \nsuch way that  m v_0&#94;2/2 = kT_0 , and the returned value is normalized to  1/v_0&#94;(3/2) . Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: n Density in arbitrary units real(kind=rk), intent(in) :: T Temperature in units compatible with velocity grid real(kind=rk), intent(in), dimension(:) :: vPoints Velocity grid Return Value real(kind=rk), allocatable, dimension(:)","tags":"","url":"proc/normmaxwellian.html"},{"title":"simpleMoment – ReMKiT1D","text":"pure module function simpleMoment(m, f, vPoints, vWidths, g) result(res) Interface → Returns the m-th moment of passed distribution function harmonic -  4 pi int(v&#94;(2+m) f dv) . Optionally takes moment of f*g\nwhere g conforms to f. The integration is a simple Riemann sum. Arguments Type Intent Optional Attributes Name integer(kind=ik), intent(in) :: m Moment degree real(kind=rk), intent(in), dimension(:) :: f Distribution function to take the moment of real(kind=rk), intent(in), dimension(:) :: vPoints Coordinates of cell centres in velocity space real(kind=rk), intent(in), dimension(:) :: vWidths Widths of velocity space cells real(kind=rk), intent(in), optional, dimension(:) :: g Optional velocity space array to include in moment integral Return Value real(kind=rk)","tags":"","url":"proc/simplemoment.html"},{"title":"initDiffusionStencilGen – ReMKiT1D","text":"module subroutine initDiffusionStencilGen(this, partitionObj, procRank, innerJ, outerJ, linInterp, xPeriodic, diffCoeffDerivRule, xHaloWidth, doNotInterpolateD) Interface → Diffusion stencil value generator initialization routine Arguments Type Intent Optional Attributes Name class( DiffusionStencilValGenerator ), intent(inout) :: this type( Partition ), intent(in) :: partitionObj Partition object used to determine local number of rows integer(kind=ik), intent(in) :: procRank Current processor rank real(kind=rk), intent(in), dimension(:) :: innerJ Inner/column jacobian/hodge star (should conform to x-grid) real(kind=rk), intent(in), dimension(:) :: outerJ Outer/row inverse jacobian/hodge star (should conform to x-grid) real(kind=rk), intent(in), dimension(:) :: linInterp Linear interpolation coefficients to right cell faces (should be size(xGrid)+1) logical, intent(in), optional :: xPeriodic Used to determine if outer processors should have their stencils trimmed. Defaults to .false. type( CalculationRule ), intent(in), optional :: diffCoeffDerivRule Rule for deriving the optional diffusion coefficient integer(kind=ik), intent(in), optional :: xHaloWidth Halo width in the x direction. Defaults to 1 and must always be >0 logical, intent(in), optional :: doNotInterpolateD Assume the diffusion coefficient is already calcuated at cell boundaries. Defaults to False.","tags":"","url":"proc/initdiffusionstencilgen.html"},{"title":"calcDiffusionStencilGen – ReMKiT1D","text":"module subroutine calcDiffusionStencilGen(this, varCont, res, mbData, hostModel) Interface → Calculate diffusion stencil values in place Arguments Type Intent Optional Attributes Name class( DiffusionStencilValGenerator ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont type( RealArray ), intent(inout), allocatable, dimension(:) :: res class( ModelboundData ), intent(in), optional :: mbData class( ModelSurrogate ), intent(in), optional :: hostModel","tags":"","url":"proc/calcdiffusionstencilgen.html"},{"title":"getAlternativeJSONPath – ReMKiT1D","text":"pure module function getAlternativeJSONPath(this) result(filepath) Interface → Get alternative default JSON filepath Arguments Type Intent Optional Attributes Name class( JSONController ), intent(in) :: this Return Value character(len=:), allocatable","tags":"","url":"proc/getalternativejsonpath.html"},{"title":"loadFile – ReMKiT1D","text":"module subroutine loadFile(this, mpiCont, filepath) Interface → Loads json file on rank 0. The default filepath here is \"./config.json\". Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( MPIController ), intent(inout) :: mpiCont MPIController object to be used by the JSONController for communication character(len=*), intent(in), optional :: filepath Non-default filepath","tags":"","url":"proc/loadfile.html"},{"title":"closeFile – ReMKiT1D","text":"module subroutine closeFile(this, mpiCont, saveFile, filepath) Interface → Closes currently open json file. If saveFile is true, saves the file being worked on before closing. \nThe default filepath here is \"./config.json\". Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( MPIController ), intent(inout) :: mpiCont MPIController object to be used by the JSONController for communication logical, intent(in), optional :: saveFile True if the file should be saved before closing character(len=*), intent(in), optional :: filepath Non-default filepath for saving","tags":"","url":"proc/closefile.html"},{"title":"loadScalarParams – ReMKiT1D","text":"module subroutine loadScalarParams(this, vars) Interface → Load named scalar parameters by calling individual load routines. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedScalarContainer ), intent(inout) :: vars Values to load","tags":"","url":"proc/loadscalarparams.html"},{"title":"setAlternativeJSONPath – ReMKiT1D","text":"module subroutine setAlternativeJSONPath(this, filepath) Interface → Set alternative default JSON filepath Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this character(len=*), intent(in) :: filepath","tags":"","url":"proc/setalternativejsonpath.html"},{"title":"loadArrayParams – ReMKiT1D","text":"module subroutine loadArrayParams(this, vars) Interface → Load named array parameters by calling individual load routines. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedArrayContainer ), intent(inout) :: vars Values to load","tags":"","url":"proc/loadarrayparams.html"},{"title":"loadNamedReals – ReMKiT1D","text":"module subroutine loadNamedReals(this, vars) Interface → Load named reals from currently open json file on rank 0, then broadcast them to all processors. If a variable isn't found, the\npassed value is not modified. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedReal ), intent(inout), dimension(:) :: vars Values to load","tags":"","url":"proc/loadnamedreals.html"},{"title":"loadNamedInts – ReMKiT1D","text":"module subroutine loadNamedInts(this, vars) Interface → Load named int from currently open json file on rank 0, then broadcast them to all processors. If a variable isn't found, the\npassed value is not modified. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedInteger ), intent(inout), dimension(:) :: vars Values to load","tags":"","url":"proc/loadnamedints.html"},{"title":"loadNamedLogicals – ReMKiT1D","text":"module subroutine loadNamedLogicals(this, vars) Interface → Load named logicals from currently open json file on rank 0, then broadcast them to all processors. If a variable isn't found, \nthe passed value is not modified. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedLogical ), intent(inout), dimension(:) :: vars Values to load","tags":"","url":"proc/loadnamedlogicals.html"},{"title":"loadNamedStrings – ReMKiT1D","text":"module subroutine loadNamedStrings(this, vars) Interface → Load named strings from currently open json file on rank 0, then broadcast them to all processors. If a variable isn't found, the\npassed value is not modified. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedString ), intent(inout), dimension(:) :: vars Values to load","tags":"","url":"proc/loadnamedstrings.html"},{"title":"loadNamedRealArrays – ReMKiT1D","text":"module subroutine loadNamedRealArrays(this, vars) Interface → Load named real arrays from currently open json file on rank 0, then broadcast them to all processors. If a variable isn't found, \nthe passed value is not modified. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedRealArray ), intent(inout), dimension(:) :: vars Values to load","tags":"","url":"proc/loadnamedrealarrays.html"},{"title":"loadNamedIntArrays – ReMKiT1D","text":"module subroutine loadNamedIntArrays(this, vars) Interface → Load named int arrays from currently open json file on rank 0, then broadcast them to all processors. If a variable isn't found, \nthe passed value is not modified. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedIntegerArray ), intent(inout), dimension(:) :: vars Values to load","tags":"","url":"proc/loadnamedintarrays.html"},{"title":"loadNamedLogicalArrays – ReMKiT1D","text":"module subroutine loadNamedLogicalArrays(this, vars) Interface → Load named logical arrays from currently open json file on rank 0, then broadcast them to all processors. If a variable isn't \nfound, the passed value is not modified. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedLogicalArray ), intent(inout), dimension(:) :: vars Values to load","tags":"","url":"proc/loadnamedlogicalarrays.html"},{"title":"loadNamedStringArrays – ReMKiT1D","text":"module subroutine loadNamedStringArrays(this, vars) Interface → Load named string arrays from currently open json file on rank 0, then broadcast them to all processors. If a variable isn't \nfound, the passed value is not modified. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedStringArray ), intent(inout), dimension(:) :: vars Values to load","tags":"","url":"proc/loadnamedstringarrays.html"},{"title":"outputScalarParamsToFile – ReMKiT1D","text":"module subroutine outputScalarParamsToFile(this, vars) Interface → Outputs named scalar parameters to json file from rank 0. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedScalarContainer ), intent(inout) :: vars Values to output","tags":"","url":"proc/outputscalarparamstofile.html"},{"title":"outputArrayParamsToFile – ReMKiT1D","text":"module subroutine outputArrayParamsToFile(this, vars) Interface → Outputs named array parameters to json file from rank 0. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedArrayContainer ), intent(inout) :: vars Values to output","tags":"","url":"proc/outputarrayparamstofile.html"},{"title":"outputNamedRealsToFile – ReMKiT1D","text":"module subroutine outputNamedRealsToFile(this, vars) Interface → Outputs named reals to json file from rank 0. First attempts to update the variable, and if it is not found it is added. Arguments Type Intent Optional Attributes Name class( JSONController ), intent(inout) :: this type( NamedReal ), intent(inout), dimension(:) :: vars Values to output","tags":"","url":"proc/outputnamedrealstofile.html"},{"title":"outputNamedIntsToFile – ReMKiT1D