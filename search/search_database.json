 Attributes Name class( Modeller ), intent(in) :: this Return Value logical Description Return true if modeller is assembled and ready to evolve variables","tags":"","url":"interface/isassembled~2.html"},{"title":"evaluateModelTermGroup – ReMKiT1D","text":"interface private module function evaluateModelTermGroup(this, modelIndex, groupIndex, varCont) result(res) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(in) :: this integer(kind=ik), intent(in) :: modelIndex integer(kind=ik), intent(in) :: groupIndex type( VariableContainer ), intent(in), optional :: varCont Return Value real(kind=rk),allocatable,dimension(:) Description Call the evaluateTermGroup routine on model with given index and for given term group - optionally use variable container other\nthan the one stored in the modeller","tags":"","url":"interface/evaluatemodeltermgroup.html"},{"title":"evaluateModelTermByName – ReMKiT1D","text":"interface private module function evaluateModelTermByName(this, modelIndex, name, varCont) result(res) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(in) :: this integer(kind=ik), intent(in) :: modelIndex character(len=*), intent(in) :: name type( VariableContainer ), intent(in), optional :: varCont Return Value real(kind=rk),allocatable,dimension(:) Description Call the evaluateTermByName routine on model with given index and for given term name - optionally use variable container other\nthan the one stored in the modeller","tags":"","url":"interface/evaluatemodeltermbyname.html"},{"title":"isModelTermGroupMixed – ReMKiT1D","text":"interface private pure module function isModelTermGroupMixed(this, groupIndex, modelIndex) result(mixed) Implementation → Arguments Type Intent Optional Attributes Name class( Modeller ), intent(in) :: this integer(kind=ik), intent(in) :: groupIndex integer(kind=ik), intent(in) :: modelIndex Return Value logical Description Return true if group with given index