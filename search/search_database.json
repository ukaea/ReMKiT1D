eElectronGamma – ReMKiT1D","text":"module function calculateElectronGamma(this, inputArray, indices) result(output) Interface → Arguments Type Intent Optional Attributes Name class( ElectronSheathGammaDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk), allocatable, dimension(:)","tags":"","url":"proc/calculateelectrongamma.html"},{"title":"initElectronSheathGamma – ReMKiT1D","text":"module subroutine initElectronSheathGamma(this, massRatio, boundaryIndex) Interface → Initialize electron sheath gamma derivation object Arguments Type Intent Optional Attributes Name class( ElectronSheathGammaDerivation ), intent(inout) :: this real(kind=rk), intent(in) :: massRatio integer(kind=ik), intent(in) :: boundaryIndex","tags":"","url":"proc/initelectronsheathgamma.html"},{"title":"inelWeights – ReMKiT1D","text":"pure module function inelWeights(space, E) result(wMat) Interface → Calculate velocity space inelastic mapping weight matrix for transition with energy E on given velocity space. Assumes that \nvelocity and energy are suitably normalized (i.e. v&#94;2 is an energy) Arguments Type Intent Optional Attributes Name type( VSpace ), intent(in) :: space Velocity space object to calculate the mapping on real(kind=rk), intent(in) :: E Mapping transition energy Return Value type( SparseRowData )","tags":"","url":"proc/inelweights.html"},{"title":"fillEmissionVector – ReMKiT1D","text":"pure module subroutine fillEmissionVector(wMat, emit) Interface → Fills passed velocity space vector emit with zeros or ones, depending on whether there are any entries in the corresponding \ncolumn of passed mapping weight matrix Arguments Type Intent Optional Attributes Name type( SparseRowData ), intent(in) :: wMat real(kind=rk), intent(inout), dimension(:) :: emit","tags":"","url":"proc/fillemissionvector.html"},{"title":"calculateSimple – ReMKiT1D","text":"module function