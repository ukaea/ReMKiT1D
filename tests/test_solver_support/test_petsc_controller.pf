module test_petsc_controller 
    use MPI
    use pFunit
    use mpi_controller_class
    use partition_class
    use grid_class
    use indexing_class
    use support_types 
    use petsc_controller_class
    use sparse_row_data_class
    use variable_list_class
    implicit none

    contains

    @test( npes=[8])
    subroutine test_controller(this)

    
        class (MpiTestMethod), intent(inout) :: this
        type(MPIController) :: testMPIController 
        type(sparseRowData) :: testSRMatrix ,testSRMatrixOverlap ,offDiag
        type(petscController) :: testPETScController 
        type(solverOptions) :: solOptions 

        type(partition) :: testPart
        type(grid) :: testGrid
        type(variableList) :: testList
        type(indexing) :: testIndexing

        real(rk) ,dimension(3) :: locVecUnknown, locVecKnown ,expectedSol
        integer(ik) ,dimension(3) :: locRows 
        type(intArray) ,dimension(3) :: locCols
        integer(ik) ,dimension(1) :: overlapRows
        type(intArray) ,dimension(1) :: overlapCols

        integer(ik) :: i

        call testMPIController%init(8,1)

        call testPart%initSimplePartition(8,1,24,1)
        call testGrid%init(real([(i,i=1,12)],kind=rk),real([(i,i=1,5)],kind=rk),0,0)

        call testList%init()
        call testList%addVar("n")

        call testIndexing%init(testPart,testGrid,testList)


        solOptions%kspSolverType = "bcgs"
        solOptions%hyprePC = ""
        solOptions%petscOptions = ""
        call testPETScController%init(testIndexing,testMPIController,solOptions,numObjs=2)
        locRows = [1,2,3] + testMPIController%getWorldRank()*3
        locCols = [intArray([testMPIController%getWorldRank()*3+1]),&
        intArray([testMPIController%getWorldRank()*3+2]),&
        intArray([testMPIController%getWorldRank()*3+3])]
        call testSRMatrix%init(locRows,locCols)
        testSRMatrix%values = [realArray(real([locRows(1)],kind=rk)),&
                               realArray(real([locRows(2)],kind=rk)),&
                               realArray(real([locRows(3)],kind=rk))]

        overlapRows = [locRows(2)]
        overlapCols = [intArray([locRows(2)])]
        call testSRMatrixOverlap%init(overlapRows,overlapCols)
        testSRMatrixOverlap%values = [realArray(real([locRows(2)],kind=rk))]

        locVecUnknown = 0.0 
        locVecKnown = real(locRows,kind=rk)

        call testPETScController%addRowDataToPreallocation(testSRMatrix)
        call testPETScController%addRowDataToPreallocation(testSRMatrixOverlap)
        ! Register (row 1, col 2) after all three diagonal entries so COO order is not sorted.
        call offDiag%init([locRows(1)],[IntArray([locRows(2)])])
        offDiag%values(1)%entry = 0.5d0
        call testPETScController%addRowDataToPreallocation(offDiag)
        call testPETScController%createPETScObjs()
        call testPETScController%addRowValuesToMatrix(testSRMatrix)

        @assertTrue(testPETScController%objectsCreated())

        call testPETScController%linearSolve(locVecKnown,locVecUnknown)

        @assertTrue(testPETScController%getLastConvergedReason()>0)
        @assertEqual(testPETScController%getLastNumIterations(),1)

        @assertEqual(locVecUnknown,real([1.0d00,1.0d00,1.0d00],kind=rk))

        call testPETScController%addRowValuesToMatrix(testSRMatrix)
        call testPETScController%linearSolve(locVecKnown,locVecUnknown)
        @assertTrue(testPETScController%getLastConvergedReason()>0)
        @assertEqual(testPETScController%getLastNumIterations(),0)
        @assertEqual(locVecUnknown,real([1.0d00,1.0d00,1.0d00],kind=rk))

        call testPETScController%addRowValuesToMatrix(testSRMatrix,0.5d0)
        call testPETScController%addRowValuesToMatrix(testSRMatrix,0.5d0)
        if (testMPIController%getWorldRank() == 0) then
            call testPETScController%addRowValuesToMatrix(testSRMatrixOverlap,1.0d0)
        end if
        call testPETScController%linearSolve(2.0d0*locVecKnown,locVecUnknown)
        @assertTrue(testPETScController%getLastConvergedReason()>0)
        expectedSol = real([2.0d00,2.0d00,2.0d00],kind=rk)
        if (testMPIController%getWorldRank() == 0) expectedSol(2) = 1.0d00
        @assertEqual(locVecUnknown,expectedSol,tolerance=1.0d-12)

        expectedSol = [1.0d0,2.0d0,3.0d0]
        locVecKnown = real(locRows,kind=rk) * expectedSol
        locVecKnown(1) = locVecKnown(1) + 0.5d0 * expectedSol(2)
        do i = 1,2
            call testPETScController%addRowValuesToMatrix(testSRMatrix,objGroup=i)
            call testPETScController%addRowValuesToMatrix(offDiag,objGroup=i)
            locVecUnknown = 0.0d0
            call testPETScController%linearSolve(locVecKnown,locVecUnknown,objGroup=i)
            @assertTrue(testPETScController%getLastConvergedReason()>0)
            @assertEqual(locVecUnknown,expectedSol,tolerance=1.0d-12)
        end do

        call checkPCReusePerGroup(testIndexing,testMPIController)
        call checkPCReuseFreshRetry(testIndexing,testMPIController)
        call checkPCReuseTerminalFailure(testIndexing,testMPIController)
        call checkPCReusePreonlyFallback(testIndexing,testMPIController)
        call checkRelRedMultiGroupAndZeroRHS(testIndexing,testMPIController)
        call checkRelRedNormNone(testIndexing,testMPIController)
        call checkRelRedDelegatedMaxits(testIndexing,testMPIController)

        call testPETScController%finalize()



    end subroutine test_controller

    subroutine checkPCReusePerGroup(testIndexing,testMPIController)
        ! Three distinct diagonal entries distinguish a stale Jacobi PC (3 GMRES iterations)
        ! from a refreshed one (1 iteration) independently per PETSc object group.
        type(indexing) ,intent(in) :: testIndexing
        type(MPIController) ,intent(in) :: testMPIController
        type(PETScController) :: controller
        type(SolverOptions) :: options
        type(SparseRowData) :: matrix
        integer(ik) ,dimension(3) :: rows
        type(IntArray) ,dimension(3) :: cols
        real(rk) ,dimension(3) :: solution
        integer(ik) :: group

        options%kspSolverType = "gmres"
        options%hyprePC = ""
        options%petscOptions = "-pc_type jacobi"
        options%solverToleranceRel = 1.0d-10
        options%solverToleranceAbs = 1.0d-14
        call controller%init(testIndexing,testMPIController,options,numObjs=2)
        rows = [1,2,3] + testMPIController%getWorldRank()*3
        cols = [IntArray([rows(1)]),IntArray([rows(2)]),IntArray([rows(3)])]
        call matrix%init(rows,cols)
        call controller%addRowDataToPreallocation(matrix)
        call controller%createPETScObjs()

        do group = 1,2
            matrix%values = [RealArray([1.0d0]),RealArray([1.0d0]),RealArray([1.0d0])]
            call controller%addRowValuesToMatrix(matrix,objGroup=group)
            solution = 0.0d0
            call controller%linearSolve([1.0d0,1.0d0,1.0d0],solution,objGroup=group)
            @assertEqual(controller%getLastNumIterations(),1)
        end do

        ! Each group retains its own PC even after solves on the other group.
        do group = 1,2
            matrix%values = [RealArray([1.0d0]),RealArray([2.0d0]),RealArray([3.0d0])]
            call controller%addRowValuesToMatrix(matrix,objGroup=group)
            solution = 0.0d0
            call controller%linearSolve([1.0d0,2.0d0,3.0d0],solution,objGroup=group,reusePC=.true.)
            @assertTrue(controller%getLastConvergedReason()>0)
            @assertEqual(controller%getLastNumIterations(),3)
            @assertEqual(solution,[1.0d0,1.0d0,1.0d0],tolerance=1.0d-10)

            call controller%addRowValuesToMatrix(matrix,objGroup=group)
            solution = 0.0d0
            if (group == 1) then
                call controller%linearSolve([1.0d0,2.0d0,3.0d0],solution,objGroup=group,reusePC=.false.)
            else
                call controller%linearSolve([1.0d0,2.0d0,3.0d0],solution,objGroup=group)
            end if
            @assertEqual(controller%getLastNumIterations(),1)
            @assertEqual(solution,[1.0d0,1.0d0,1.0d0],tolerance=1.0d-10)
        end do
    end subroutine checkPCReusePerGroup

    subroutine checkPCReuseFreshRetry(testIndexing,testMPIController)
        ! Stale Jacobi PC cannot solve diag(1,2,3) in 1 GMRES iteration; only the fresh-PC retry succeeds.
        type(indexing) ,intent(in) :: testIndexing
        type(MPIController) ,intent(in) :: testMPIController
        type(PETScController) :: retryController
        type(SolverOptions) :: options
        type(SparseRowData) :: matrix
        integer(ik) ,dimension(3) :: rows
        type(IntArray) ,dimension(3) :: cols
        real(rk) ,dimension(3) :: solution

        options%kspSolverType = "gmres"
        options%hyprePC = ""
        options%petscOptions = "-pc_type jacobi"
        options%solverToleranceRel = 1.0d-10
        options%solverToleranceAbs = 1.0d-14
        options%maxSolverIters = 1
        call retryController%init(testIndexing,testMPIController,options)
        rows = [1,2,3] + testMPIController%getWorldRank()*3
        cols = [IntArray([rows(1)]),IntArray([rows(2)]),IntArray([rows(3)])]
        call matrix%init(rows,cols)
        call retryController%addRowDataToPreallocation(matrix)
        call retryController%createPETScObjs()

        matrix%values = [RealArray([1.0d0]),RealArray([1.0d0]),RealArray([1.0d0])]
        call retryController%addRowValuesToMatrix(matrix)
        solution = 0.0d0
        call retryController%linearSolve([1.0d0,1.0d0,1.0d0],solution)

        matrix%values = [RealArray([1.0d0]),RealArray([2.0d0]),RealArray([3.0d0])]
        call retryController%addRowValuesToMatrix(matrix)
        solution = 0.0d0
        call retryController%linearSolve([1.0d0,2.0d0,3.0d0],solution,reusePC=.true.)
        @assertTrue(retryController%getLastConvergedReason()>0)
        @assertEqual(retryController%getLastNumIterations(),1)
        @assertEqual(solution,[1.0d0,1.0d0,1.0d0],tolerance=1.0d-10)
    end subroutine checkPCReuseFreshRetry

    subroutine checkPCReuseTerminalFailure(testIndexing,testMPIController)
        ! Without a preconditioner, diag(1,2,3) needs 3 GMRES iterations on both the reused-PC attempt
        ! and the fresh-PC retry; verify the retry loop terminates and propagates KSP_DIVERGED_ITS (-3).
        type(indexing) ,intent(in) :: testIndexing
        type(MPIController) ,intent(in) :: testMPIController
        type(PETScController) :: failController
        type(SolverOptions) :: options
        type(SparseRowData) :: matrix
        integer(ik) ,dimension(3) :: rows
        type(IntArray) ,dimension(3) :: cols
        real(rk) ,dimension(3) :: solution

        options%kspSolverType = "gmres"
        options%hyprePC = ""
        options%petscOptions = "-pc_type none"
        options%solverToleranceRel = 1.0d-10
        options%solverToleranceAbs = 1.0d-14
        options%maxSolverIters = 1
        call failController%init(testIndexing,testMPIController,options)
        rows = [1,2,3] + testMPIController%getWorldRank()*3
        cols = [IntArray([rows(1)]),IntArray([rows(2)]),IntArray([rows(3)])]
        call matrix%init(rows,cols)
        call failController%addRowDataToPreallocation(matrix)
        call failController%createPETScObjs()

        matrix%values = [RealArray([1.0d0]),RealArray([1.0d0]),RealArray([1.0d0])]
        call failController%addRowValuesToMatrix(matrix)
        solution = 0.0d0
        call failController%linearSolve([1.0d0,1.0d0,1.0d0],solution)
        @assertTrue(failController%getLastConvergedReason()>0)

        matrix%values = [RealArray([1.0d0]),RealArray([2.0d0]),RealArray([3.0d0])]
        call failController%addRowValuesToMatrix(matrix)
        solution = 0.0d0
        call failController%linearSolve([1.0d0,2.0d0,3.0d0],solution,reusePC=.true.)
        @assertEqual(failController%getLastConvergedReason(),-3)
        @assertEqual(failController%getLastNumIterations(),1)
    end subroutine checkPCReuseTerminalFailure

    subroutine checkPCReusePreonlyFallback(testIndexing,testMPIController)
        ! KSPPREONLY automatically disables reusePC so changed operators refresh the PC cleanly.
        type(indexing) ,intent(in) :: testIndexing
        type(MPIController) ,intent(in) :: testMPIController
        type(PETScController) :: preonlyController
        type(SolverOptions) :: options
        type(SparseRowData) :: matrix
        integer(ik) ,dimension(3) :: rows
        type(IntArray) ,dimension(3) :: cols
        real(rk) ,dimension(3) :: solution

        options%kspSolverType = "preonly"
        options%hyprePC = ""
        options%petscOptions = "-pc_type jacobi"
        call preonlyController%init(testIndexing,testMPIController,options)
        rows = [1,2,3] + testMPIController%getWorldRank()*3
        cols = [IntArray([rows(1)]),IntArray([rows(2)]),IntArray([rows(3)])]
        call matrix%init(rows,cols)
        call preonlyController%addRowDataToPreallocation(matrix)
        call preonlyController%createPETScObjs()

        matrix%values = [RealArray([1.0d0]),RealArray([1.0d0]),RealArray([1.0d0])]
        call preonlyController%addRowValuesToMatrix(matrix)
        solution = 0.0d0
        call preonlyController%linearSolve([1.0d0,1.0d0,1.0d0],solution)
        @assertEqual(solution,[1.0d0,1.0d0,1.0d0],tolerance=1.0d-12)

        matrix%values = [RealArray([1.0d0]),RealArray([2.0d0]),RealArray([3.0d0])]
        call preonlyController%addRowValuesToMatrix(matrix)
        solution = 0.0d0
        call preonlyController%linearSolve([1.0d0,2.0d0,3.0d0],solution,reusePC=.true.)
        @assertTrue(preonlyController%getLastConvergedReason()>0)
        @assertEqual(solution,[1.0d0,1.0d0,1.0d0],tolerance=1.0d-12)
    end subroutine checkPCReusePreonlyFallback

    subroutine initDiagController(controller,matrix,testIndexing,testMPIController,options,numObjs)
        type(PETScController) ,intent(out) :: controller
        type(SparseRowData)   ,intent(out) :: matrix
        type(Indexing)        ,intent(in)  :: testIndexing
        type(MPIController)   ,intent(in)  :: testMPIController
        type(SolverOptions)   ,intent(in)  :: options
        integer(ik) ,optional ,intent(in)  :: numObjs

        integer(ik) ,dimension(3) :: rows

        call controller%init(testIndexing,testMPIController,options,numObjs=numObjs)
        rows = [1,2,3] + testMPIController%getWorldRank()*3
        call matrix%init(rows,[IntArray([rows(1)]),IntArray([rows(2)]),IntArray([rows(3)])])
        call controller%addRowDataToPreallocation(matrix)
        call controller%createPETScObjs()
    end subroutine initDiagController

    subroutine setScaledIdentity(matrix,alpha)
        type(SparseRowData) ,intent(inout) :: matrix
        real(rk)            ,intent(in)    :: alpha

        matrix%values = [RealArray([alpha]),RealArray([alpha]),RealArray([alpha])]
    end subroutine setScaledIdentity

    subroutine checkRelRedMultiGroupAndZeroRHS(testIndexing,testMPIController)
        ! Richardson with -pc_type none on A = alpha*I satisfies r_k = (1 - alpha)^k * r_0:
        ! alpha = 0.9 drops the residual 10x per iteration; alpha = 1.0 solves in 1 iteration;
        ! alpha = 0.5 drops 2x per iteration.
        type(Indexing)      ,intent(in) :: testIndexing
        type(MPIController) ,intent(in) :: testMPIController
        type(PETScController) :: controller
        type(SolverOptions)   :: options
        type(SparseRowData)   :: matrix
        real(rk) ,dimension(3) :: solution
        logical :: usedExact

        options%kspSolverType = "richardson"
        options%hyprePC = ""
        options%petscOptions = "-pc_type none"
        options%solverToleranceRel = 1.0d-10
        options%solverToleranceAbs = 1.0d-14
        options%maxSolverIters = 3
        call initDiagController(controller,matrix,testIndexing,testMPIController,options,numObjs=2)

        ! Group 1 inexact solve: 0.9*I drops residual to 0.1 (iter 1) then 0.01 <= 0.05 (iter 2) -> early stop.
        call setScaledIdentity(matrix,0.9d0)
        call controller%addRowValuesToMatrix(matrix,objGroup=1)
        solution = 0.0d0
        call controller%linearSolve([0.9d0,0.9d0,0.9d0],solution,objGroup=1,rtol=0.05d0,usedExactTol=usedExact)
        @assertTrue(controller%getLastConvergedReason()>0)
        @assertEqual(controller%getLastNumIterations(),2)
        @assertFalse(usedExact)

        ! Interleaved group 2 solve: 1.0*I hits exact residual 0 in 1 iter despite loose rtol -> usedExact = .true.
        call setScaledIdentity(matrix,1.0d0)
        call controller%addRowValuesToMatrix(matrix,objGroup=2)
        solution = 0.0d0
        call controller%linearSolve([1.0d0,1.0d0,1.0d0],solution,objGroup=2,rtol=0.05d0,usedExactTol=usedExact)
        @assertTrue(controller%getLastConvergedReason()>0)
        @assertEqual(controller%getLastNumIterations(),1)
        @assertTrue(usedExact)
        @assertEqual(solution,[1.0d0,1.0d0,1.0d0],tolerance=1.0d-12)

        ! Group 1 zero-RHS with nonzero initial guess: PETSc KSPConvergedDefault handles ||b|| == 0 cleanly.
        call setScaledIdentity(matrix,0.9d0)
        call controller%addRowValuesToMatrix(matrix,objGroup=1)
        solution = [1.0d0,1.0d0,1.0d0]
        call controller%linearSolve([0.0d0,0.0d0,0.0d0],solution,objGroup=1,rtol=0.05d0,usedExactTol=usedExact)
        @assertTrue(controller%getLastConvergedReason()>0)
        @assertEqual(controller%getLastNumIterations(),2)
        @assertFalse(usedExact)

        ! Exact solve (rtol omitted) on group 1 converges to exact tolerance and reports usedExact = .true.
        call setScaledIdentity(matrix,1.0d0)
        call controller%addRowValuesToMatrix(matrix,objGroup=1)
        solution = [1.0d0,1.0d0,1.0d0]
        call controller%linearSolve([0.0d0,0.0d0,0.0d0],solution,objGroup=1,usedExactTol=usedExact)
        @assertTrue(controller%getLastConvergedReason()>0)
        @assertEqual(controller%getLastNumIterations(),1)
        @assertTrue(usedExact)
        @assertEqual(solution,[0.0d0,0.0d0,0.0d0],tolerance=1.0d-12)

        ! Diverged solve (0.5*I reaches only 0.5^3 = 0.125 in 3 iters) must report usedExact = .false.
        call setScaledIdentity(matrix,0.5d0)
        call controller%addRowValuesToMatrix(matrix,objGroup=1)
        solution = 0.0d0
        call controller%linearSolve([0.5d0,0.5d0,0.5d0],solution,objGroup=1,usedExactTol=usedExact)
        @assertTrue(controller%getLastConvergedReason()<0)
        @assertEqual(controller%getLastNumIterations(),3)
        @assertFalse(usedExact)
    end subroutine checkRelRedMultiGroupAndZeroRHS

    subroutine checkRelRedNormNone(testIndexing,testMPIController)
        ! With -ksp_norm_type none, relative-reduction wrapping is skipped so Richardson runs all
        ! maxSolverIters steps (x = 0 -> 0.5 -> 0.75 for 0.5*x = 0.5) instead of stopping at iter 0.
        type(Indexing)      ,intent(in) :: testIndexing
        type(MPIController) ,intent(in) :: testMPIController
        type(PETScController) :: controller
        type(SolverOptions)   :: options
        type(SparseRowData)   :: matrix
        real(rk) ,dimension(3) :: solution
        logical :: usedExact

        options%kspSolverType = "richardson"
        options%hyprePC = ""
        options%petscOptions = "-pc_type none -ksp_norm_type none"
        options%maxSolverIters = 2
        call initDiagController(controller,matrix,testIndexing,testMPIController,options)

        call setScaledIdentity(matrix,0.5d0)
        call controller%addRowValuesToMatrix(matrix)
        solution = 0.0d0
        call controller%linearSolve([0.5d0,0.5d0,0.5d0],solution,rtol=0.05d0,usedExactTol=usedExact)
        @assertTrue(controller%getLastConvergedReason()>0)
        @assertEqual(controller%getLastNumIterations(),2)
        @assertTrue(usedExact)
        @assertEqual(solution,[0.75d0,0.75d0,0.75d0],tolerance=1.0d-12)
    end subroutine checkRelRedNormNone

    subroutine checkRelRedDelegatedMaxits(testIndexing,testMPIController)
        ! Delegating to PETSc's configured KSPConvergedDefault preserves options such as -ksp_converged_maxits:
        ! 1 Richardson step on 0.5*x = 0.5 leaves 0.5*||r_0|| > 0.05*||r_0|| and returns KSP_CONVERGED_ITS (>0).
        type(Indexing)      ,intent(in) :: testIndexing
        type(MPIController) ,intent(in) :: testMPIController
        type(PETScController) :: controller
        type(SolverOptions)   :: options
        type(SparseRowData)   :: matrix
        real(rk) ,dimension(3) :: solution
        logical :: usedExact

        options%kspSolverType = "richardson"
        options%hyprePC = ""
        options%petscOptions = "-pc_type none -ksp_norm_type preconditioned -ksp_converged_maxits"
        options%solverToleranceRel = 1.0d-10
        options%solverToleranceAbs = 1.0d-14
        options%maxSolverIters = 1
        call initDiagController(controller,matrix,testIndexing,testMPIController,options)

        call setScaledIdentity(matrix,0.5d0)
        call controller%addRowValuesToMatrix(matrix)
        solution = 0.0d0
        call controller%linearSolve([0.5d0,0.5d0,0.5d0],solution,rtol=0.05d0,usedExactTol=usedExact)
        @assertTrue(controller%getLastConvergedReason()>0)
        @assertEqual(controller%getLastNumIterations(),1)
        @assertTrue(usedExact)
        @assertEqual(solution,[0.5d0,0.5d0,0.5d0],tolerance=1.0d-12)
    end subroutine checkRelRedDelegatedMaxits

end module