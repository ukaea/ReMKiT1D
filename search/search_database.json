 this integer(kind=ik), intent(in) :: groupIndex Group index to evaluate type( VariableContainer ), intent(in) :: varCont Variable container used to evaluate this group Return Value real(kind=rk),allocatable,dimension(:) Description Evaluate a term group, returning the sum of all explicit results from the term group \n- if groupIndex > size(implicitGroup) it is taken to be in the general group","tags":"","url":"interface/evaluatetermgroup.html"},{"title":"isGroupMixed – ReMKiT1D","text":"interface private pure module function isGroupMixed(this, groupIndex) result(mixed) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: this integer(kind=ik), intent(in) :: groupIndex Return Value logical Description Return true if group with given index is mixed","tags":"","url":"interface/isgroupmixed.html"},{"title":"getGroupVarName – ReMKiT1D","text":"interface private pure module function getGroupVarName(this, groupIndex) result(name) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: this integer(kind=ik), intent(in) :: groupIndex Return Value character(len=:),allocatable Description Return evolved variable name for given group index - works only for groups that are not mixed","tags":"","url":"interface/getgroupvarname.html"},{"title":"getImplicitTermRowData – ReMKiT1D","text":"interface private pure module function getImplicitTermRowData(this, termIndex) result(rowData) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: this integer(kind=ik), intent(in) :: termIndex Return Value type( SparseRowData ) Description Return row data of implicit term with given term index","tags":"","url":"interface/getimplicittermrowdata.html"},{"title":"getImplicitTermIndexingData – ReMKiT1D","text":"interface private pure module function getImplicitTermIndexingData(this, termIndex) result(indexingData) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: this integer(kind=ik), intent(in) :: termIndex Return Value type( MatrixTermIndexingData ) Description Return indexing data of implicit term with given term index","tags":"","url":"interface/getimplicittermindexingdata.html"},{"title":"isTermNameRegistered – ReMKiT1D","text":"interface private pure module function isTermNameRegistered(this, name) result(reg) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: this character(len=*), intent(in) :: name Return Value logical Description Check whether term with given name is registered","tags":"","url":"interface/istermnameregistered.html"},{"title":"isTermNameImplicit – ReMKiT1D","text":"interface private pure module function isTermNameImplicit(this, name) result(reg) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: this character(len=*), intent(in) :: name Return Value logical Description Check whether term with given name is implicit","tags":"","url":"interface/istermnameimplicit.html"},{"title":"getImplicitTermIndex – ReMKiT1D","text":"interface private pure module function getImplicitTermIndex(this, name) result(ind) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: this character(len=*), intent(in) :: name Return Value integer(kind=ik) Description Get index of implicit term with given name","tags":"","url":"interface/getimplicittermindex.html"},{"title":"getGeneralTermIndex – ReMKiT1D","text":"interface private pure module function getGeneralTermIndex(this, name) result(ind) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: this character(len=*), intent(in) :: name Return Value integer(kind=ik) Description Get index of general term with given name","tags":"","url":"interface/getgeneraltermindex.html"},{"title":"evaluateTermByName – ReMKiT1D","text":"interface private module function evaluateTermByName(this, name, varCont) result(res) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(in) :: this character(len=*), intent(in) :: name type( VariableContainer ), intent(in) :: varCont Variable container used to evaluate this term Return Value real(kind=rk),allocatable,dimension(:) Description Evaluate a term by name","tags":"","url":"interface/evaluatetermbyname.html"},{"title":"initModel – ReMKiT1D","text":"interface private pure module subroutine initModel(this, numImplicitTerms, numGeneralTerms, numImplicitGroups, numGeneralGroups) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: this integer(kind=ik), intent(in), optional :: numImplicitTerms Number of MatrixTerm objects this model expects to be added integer(kind=ik), intent(in), optional :: numGeneralTerms Number of general Term objects this model expects to be added integer(kind=ik), intent(in), optional :: numImplicitGroups Number of implicit/matrix term groups registered with this model integer(kind=ik), intent(in), optional :: numGeneralGroups Number of general term groups registered with this model Description Model initialization routine","tags":"","url":"interface/initmodel.html"},{"title":"setNumImplicitTerms – ReMKiT1D","text":"interface private pure module subroutine setNumImplicitTerms(this, numImplicitTerms) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: this integer(kind=ik), intent(in) :: numImplicitTerms Number of MatrixTerm objects this model expects to be added Description Set number of implicit terms and perform allocation","tags":"","url":"interface/setnumimplicitterms.html"},{"title":"setNumGeneralTerms – ReMKiT1D","text":"interface private pure module subroutine setNumGeneralTerms(this, numGeneralTerms) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: this integer(kind=ik), intent(in) :: numGeneralTerms Number of general Term objects this model expects to be added Description Set number of general terms and perform allocation","tags":"","url":"interface/setnumgeneralterms.html"},{"title":"setNumImplicitGroups – ReMKiT1D","text":"interface private pure module subroutine setNumImplicitGroups(this, numImplicitGroups) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: this integer(kind=ik), intent(in) :: numImplicitGroups Number of implicit/matrix term groups registered with this model Description Set number of implicit groups and perform allocation","tags":"","url":"interface/setnumimplicitgroups.html"},{"title":"setNumGeneralGroups – ReMKiT1D","text":"interface private pure module subroutine setNumGeneralGroups(this, numGeneralGroups) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: this integer(kind=ik), intent(in) :: numGeneralGroups Number of general term groups registered with this model Description Set number of general groups and perform allocation","tags":"","url":"interface/setnumgeneralgroups.html"},{"title":"addImplicitTerm – ReMKiT1D","text":"interface private pure module subroutine addImplicitTerm(this, impTerm, implicitGroups, generalGroups, termName, skipPattern) Implementation → Arguments Type Intent Optional Attributes Name class( Model ), intent(inout) :: this class( MatrixTerm ), intent(inout), allocatable :: impTerm MatrixTerm object to be reallocated to this model integer(kind=ik), intent(in), dimension(:) :: implicitGroups Implicit groups the added term should belong to integer(kind=ik), intent(in), dimension(:) :: generalGroups General groups the added term should belong to character(len=*), intent(in) :: termName Name of added term for indexing purposes logical, intent(in), optional :: skipPattern True if the matrix term pattern should not be added to PETSc preallocation Description Add a MatrixTerm object to the model (deallocating the source!), and specify which implicit and 