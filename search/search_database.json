tent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for absolute value. String name \"abs\".","tags":"","url":"interface/unaryabs.html"},{"title":"unarySign – ReMKiT1D","text":"interface public pure module function unarySign(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for sign function. String name \"sign\".","tags":"","url":"interface/unarysign.html"},{"title":"unaryTan – ReMKiT1D","text":"interface public pure module function unaryTan(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for tan. String name \"tan\".","tags":"","url":"interface/unarytan.html"},{"title":"unaryAsin – ReMKiT1D","text":"interface public pure module function unaryAsin(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for arcsin. String name \"asin\".","tags":"","url":"interface/unaryasin.html"},{"title":"unaryAcos – ReMKiT1D","text":"interface public pure module function unaryAcos(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for arccos. String name \"acos\".","tags":"","url":"interface/unaryacos.html"},{"title":"unaryAtan – ReMKiT1D","text":"interface public pure module function unaryAtan(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for arctan. String name \"atan\".","tags":"","url":"interface/unaryatan.html"},{"title":"unaryErf – ReMKiT1D","text":"interface public pure module function unaryErf(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for the error function. String name \"erf\".","tags":"","url":"interface/unaryerf.html"},{"title":"unaryErfc – ReMKiT1D","text":"interface public pure module function unaryErfc(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for the complementary error function. String name \"erfc\".","tags":"","url":"interface/unaryerfc.html"},{"title":"unaryPowReal – ReMKiT1D","text":"interface public pure module function unaryPowReal(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for the raising to a real power. String name \"rpow\". Uses realParams(1) as the power.","tags":"","url":"interface/unarypowreal.html"},{"title":"unaryPowInt – ReMKiT1D","text":"interface public pure module function unaryPowInt(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for the raising to an integer power. String name \"ipow\". Uses intParams(1) as the power.","tags":"","url":"interface/unarypowint.html"},{"title":"unaryShift – ReMKiT1D","text":"interface public pure module function unaryShift(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper cyclically permuting input. String name \"shift\". Uses intParams(1) as the shift amount.","tags":"","url":"interface/unaryshift.html"},{"title":"unaryContract – ReMKiT1D","text":"interface public pure module function unaryContract(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper contracting an array with a smaller array. String name \"cont\". Uses realParams as the contracting array.\nThe input size is assumed to be evenly divided by size(realParams) and by intParams(1). The input does not have to have size \nequal to size(realParams)*intParams(1). intParams(1) determines the expected size of the output, while intParams(2)\ndetermines which of the strided slices is returnd. See below for example. Contraction is performed on strided slices of the input of length size(realParams). The strides are determined by intParams(1). \nFor example, contracting [1,2,3,4,5,6,7,8] with [1,2] yields the intermediate\nresult [5,11,17,23]. Then if intParams(1) is , we are looking to get a result of length 1. If intParams(2) is then 2, we get [11].\nIf intParams(1) is 2, we want a result of length 2, sampled evenly from the contracted array (this is useful for ReMKiT1D's\nflattened represenation of distributions). If intParams(2) is 1, we get [5,17], and if intParams(2) is 2, we get [11,23]","tags":"","url":"interface/unarycontract.html"},{"title":"unaryExpand – ReMKiT1D","text":"interface public pure module function unaryExpand(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper expanding an array with another array. String name \"expand\". Uses realParams as the expanding array.\nAfter expansion it uses intParams(1) to determine how many times the result should be copied. The result is\noutput((i-1) size(input) size(realParams)+(j-1) size(realParams)+k) = input(j) realParams(k) where j=1,size(input) and i=1,intParams(1)","tags":"","url":"interface/unaryexpand.html"},{"title":"unarySlopeRatio – ReMKiT1D","text":"interface public pure module function unarySlopeRatio(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper calculating r_i = (u_i - u_{i-n})/(u_{i+n}-u_i) where n is intParams[1]. If the absolute value of the denominator is less than\nrealParams[1], the result will be realParams[2] (with the appropriate sign) if the numerator is not less than realParams[1],\nand 1 otherwise","tags":"","url":"interface/unarysloperatio.html"},{"title":"unarySuperbee – ReMKiT1D","text":"interface public pure module function unarySuperbee(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for the superbee limiter.","tags":"","url":"interface/unarysuperbee.html"},{"title":"unaryMinmod – ReMKiT1D","text":"interface public pure module function unaryMinmod(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary wrapper for the minmod limiter.","tags":"","url":"interface/unaryminmod.html"},{"title":"unaryAbsFloor – ReMKiT1D","text":"interface public pure module function unaryAbsFloor(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Floor value filter unary wrapper, uses the absolute value of the first real param as the floor value.\nThe result it sign(input) * max(abs(input),abs(realParams(1)))","tags":"","url":"interface/unaryabsfloor.html"},{"title":"unaryStep – ReMKiT1D","text":"interface public pure module function unaryStep(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary step function, takes no params. Returns 1 where input is > 0, else 0.","tags":"","url":"interface/unarystep.html"},{"title":"unaryFilter – ReMKiT1D","text":"interface public pure module function unaryFilter(input, realParams, intParams, logicalParams) result(output) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: input real(kind=rk), intent(in), optional, dimension(:) :: realParams integer(kind=ik), intent(in), optional, dimension(:) :: intParams logical, intent(in), optional, dimension(:) :: logicalParams Return Value real(kind=rk),allocatable,dimension(:) Description Unary filter function, takes in two realParams, and returns the input, except where input realParams(2)","tags":"","url":"interface/unaryfilter.html"},{"title":"associateFunctionPointer – ReMKiT1D","text":"interface public module subroutine associateFunctionPointer(name, funcPointer) Implementation → Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name procedure( realArrayFunctionGenParam ), intent(inout), pointer :: funcPointer Description Returns a function pointer to a unary transformation based on a string name","tags":"","url":"interface/associatefunctionpointer.html"},{"title":"mergeSort – ReMKiT1D","text":"pure recursive subroutine mergeSort(buffer, start, end, array) Arguments Type Intent Optional Attributes Name integer(kind=ik), intent(inout), dimension(:) :: buffer integer(kind=ik), intent(in) :: start integer(kind=ik), intent(in) :: end integer(kind=ik), intent(inout), dimension(:) :: array","tags":"","url":"proc/mergesort.html"},{"title":"merge – ReMKiT1D","text":"pure subroutine merge(inputArray, start, mid, end, outputArray) Arguments Type Intent Optional Attributes Name integer(kind=ik), intent(inout), dimension(:) :: inputArray integer(kind=ik), intent(in) :: start integer(kind=ik), intent(in) :: mid integer(kind=ik), intent(in) :: end integer(kind=ik), intent(inout), dimension(:) :: outputArray","tags":"","url":"proc/merge.html"},{"title":"addModelboundDataToModel – ReMKiT1D","text":"interface public module subroutine addModelboundDataToModel(modelObj, modelTag, envObj, normObj) Implementation → Arguments Type Intent Optional Attributes Name type( Model ), intent(inout) :: modelObj character(len=*), intent(in) :: modelTag type( EnvironmentWrapper ), intent(inout) :: envObj class( Normalization ), intent(in) :: normObj Description Initialize modelbound data and add to corresponding model object","tags":"","url":"interface/addmodelbounddatatomodel.html"},{"title":"addCustomVarlikeMBDataToModel – ReMKiT1D","text":"interface private module subroutine addCustomVarlikeMBDataToModel(modelObj, modelTag, envObj) Implementation → Arguments Type Intent Optional Attributes Name type( Model ), intent(inout) :: modelObj character(len=*), intent(in) :: modelTag type( EnvironmentWrapper ), intent(inout) :: envObj Description Initialize varlike modelbound data and add to corresponding model object","tags":"","url":"interface/addcustomvarlikembdatatomodel.html"},{"title":"addCustomCRMDataToModel – ReMKiT1D","text":"interface private module subroutine addCustomCRMDataToModel(modelObj, modelTag, envObj, normObj) Implementation → Arguments Type Intent Optional Attributes Name type( Model ), intent(inout) :: modelObj character(len=*), intent(in) :: modelTag type( EnvironmentWrapper ), intent(inout) :: envObj class( Normalization ), intent(in) :: normObj Description Initialize custom CRM modelbound data and add to corresponding model object","tags":"","url":"interface/addcustomcrmdatatomodel.html"},{"title":"addCustomLBCDataToModel – ReMKiT1D","text":"interface private module subroutine addCustomLBCDataToModel(modelObj, modelTag, envObj, normObj) Implementation → Arguments Type Intent Optional Attributes Name type( Model ), intent(inout) :: modelObj character(len=*), intent(in) :: modelTag type( EnvironmentWrapper ), intent(inout) :: envObj class( Normalization ), intent(in) :: normObj Description Initialize custom LBC modelbound data and add to corresponding model object","tags":"","url":"interface/addcustomlbcdatatomodel.html"},{"title":"initNormalizationFromJSON – ReMKiT1D","text":"interface private module subroutine initNormalizationFromJSON(this, jsonCont, mpiCont) Implementation → Arguments Type Intent Optional Attributes Name class( BasicNormalization ), intent(inout) :: this type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController Description Initialize normalization based on config.json, loading temperature, density, and reference ion charge. \nThe resulting object will have the following normalization quantities: density (in m&#94;{-3}) temperature (in eV) reference ion Z velocity (used for the velocity grid) speed (here equal to the velocity) time (normalized to e-i collision time) length (velocity * time) EField (here elMass * velocity/(elCharge * time)) heatFlux (here elMass * density * velocity&#94;3 /2) crossSection (here 1/(time density velocity)) All names taken from key_names module","tags":"","url":"interface/initnormalizationfromjson.html"},{"title":"calculateConst – ReMKiT1D","text":"interface private module function calculateConst(this, time, period, params) result(res) Implementation → Arguments Type Intent Optional Attributes Name class( ConstSignal ), intent(inout) :: this real(kind=rk), intent(in) :: time real(kind=rk), intent(in) :: period real(kind=rk), intent(in), optional, dimension(:) :: params Return Value real(kind=rk)","tags":"","url":"interface/calculateconst.html"},{"title":"radRecombRateHydrogen – ReMKiT1D","text":"interface public pure module function radRecombRateHydrogen(temp, n) result(rate) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: temp Temperature array in eV integer(kind=ik), intent(in) :: n Final atomic state after recombination Return Value real(kind=rk),allocatable,dimension(:) Description Radiative recombination rate given by formulas (21) and (22) from Janev Section 2.1.4. The recombination for n=2 is obtained\nby a simple sum over the two l states. Result in 10&#94;-14 cm&#94;3/s","tags":"","url":"interface/radrecombratehydrogen.html"},{"title":"excitationCrossSectionHydrogen – ReMKiT1D","text":"interface public pure module function excitationCrossSectionHydrogen(eGrid, n, m) result(cs) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: eGrid Electron energy grid in eV integer(kind=ik), intent(in) :: n Initial atomic state integer(kind=ik), intent(in) :: m Final atomic state Return Value real(kind=rk),allocatable,dimension(:) Description Calculates hydrogen electron impact excitation cross-section from state n to state m  on given energy grid.\nNOTE: The returned value is in 10&#94;-16 cm&#94;2!","tags":"","url":"interface/excitationcrosssectionhydrogen.html"},{"title":"ionizationCrossSectionHydrogen – ReMKiT1D","text":"interface public pure module function ionizationCrossSectionHydrogen(eGrid, n) result(cs) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: eGrid Electron energy grid in eV integer(kind=ik), intent(in) :: n Initial atomic state Return Value real(kind=rk),allocatable,dimension(:) Description Calculates hydrogen electron impact ionization cross-section from state n on given energy grid.\nNOTE: The returned value is in 10&#94;-16 cm&#94;2!","tags":"","url":"interface/ionizationcrosssectionhydrogen.html"},{"title":"calculatePolyFun – ReMKiT1D","text":"interface private module function calculatePolyFun(this, inputArray, indices) result(output) Implementation → Arguments Type Intent Optional Attributes Name class( PolyFunDeriv ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk),allocatable,dimension(:)","tags":"","url":"interface/calculatepolyfun.html"},{"title":"initPolyFunDeriv – ReMKiT1D","text":"interface private module subroutine initPolyFunDeriv(this, polyPowers, polyCoeffs, constCoeff) Implementation → Arguments Type Intent Optional Attributes Name class( PolyFunDeriv ), intent(inout) :: this real(kind=rk), intent(in), dimension(:) :: polyPowers real(kind=rk), intent(in), dimension(:) :: polyCoeffs real(kind=rk), intent(in), optional :: constCoeff Description Initialize polynomial function derivation object","tags":"","url":"interface/initpolyfunderiv.html"},{"title":"calculateHat – ReMKiT1D","text":"interface private module function calculateHat(this, time, period, params) result(res) Implementation → Arguments Type Intent Optional Attributes Name class( HatSignal ), intent(inout) :: this real(kind=rk), intent(in) :: time real(kind=rk), intent(in) :: period real(kind=rk), intent(in), optional, dimension(:) :: params Return Value real(kind=rk)","tags":"","url":"interface/calculatehat.html"},{"title":"getID – ReMKiT1D","text":"interface private pure module function getID(this) result(id) Implementation → Arguments Type Intent Optional Attributes Name class( Species ), intent(in) :: this Return Value integer(kind=ik) Description Getter for id","tags":"","url":"interface/getid.html"},{"title":"getMass – ReMKiT1D","text":"interface private pure module function getMass(this) result(mass) Implementation → Arguments Type Intent Optional Attributes Name class( Species ), intent(in) :: this Return Value real(kind=rk) Description Getter for mass","tags":"","url":"interface/getmass.html"},{"title":"getCharge – ReMKiT1D","text":"interface private pure module function getCharge(this) result(charge) Implementation → Arguments Type Intent Optional Attributes Name class( Species ), intent(in) :: this Return Value real(kind=rk) Description Getter for charge","tags":"","url":"interface/getcharge.html"},{"title":"getName – ReMKiT1D","text":"interface private pure module function getName(this) result(name) Implementation → Arguments Type Intent Optional Attributes Name class( Species ), intent(in) :: this Return Value character(len=:),allocatable Description Getter for name","tags":"","url":"interface/getname.html"},{"title":"getAssociatedVars – ReMKiT1D","text":"interface private pure module function getAssociatedVars(this) result(associatedVars) Implementation → Arguments Type Intent Optional Attributes Name class( Species ), intent(in) :: this Return Value type( StringArray ),allocatable,dimension(:) Description Getter for associatedVars","tags":"","url":"interface/getassociatedvars.html"},{"title":"initFromJSON – ReMKiT1D","text":"interface private module subroutine initFromJSON(this, name, jsonCont, mpiCont) Implementation → Arguments Type Intent Optional Attributes Name class( Species ), intent(inout) :: this character(len=*), intent(in) :: name type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController Description Initialize species from JSON file. Here for extensibility","tags":"","url":"interface/initfromjson.html"},{"title":"initSpecies – ReMKiT1D","text":"interface private module subroutine initSpecies(this, id, name, Z, A, vars) Implementation → Arguments Type Intent Optional Attributes Name class( Species ), intent(inout) :: this integer(kind=ik), intent(in) :: id character(len=*), intent(in) :: name real(kind=rk), intent(in) :: Z real(kind=rk), intent(in) :: A type( StringArray ), intent(in), dimension(:) :: vars Description Species initialization. Z is the charge and A the atomic mass (in amus). A/Z are ignored if id = 0, which is reserved for electrons. vars is a StringArray containing names of associated variables for easy access","tags":"","url":"interface/initspecies.html"},{"title":"initCore – ReMKiT1D","text":"interface private module subroutine initCore(this, gridObj, partitionObj, procRank, rowCoords, fluidCol, fixedVVals, vValsDependOnX) Implementation → Arguments Type Intent Optional Attributes Name class( MultiplicativeGeneratorCore ), intent(inout) :: this type( Grid ), intent(in) :: gridObj Grid object used to determine local number of rows type( Partition ), intent(in) :: partitionObj Partition object used to determine local number of rows integer(kind=ik), intent(in) :: procRank Current processor rank integer(kind=ik), intent(in), dimension(:,:) :: rowCoords Global row coordinate values logical, intent(in), optional :: fluidCol True if column variable is fluid. Defaults to false. real(kind=rk), intent(in), optional, dimension(:) :: fixedVVals Fixed velocity stencil values when the row variable is fluid and the column variable is kinetic logical, intent(in), optional :: vValsDependOnX True if v stencil has spatial dependence. Defaults to false. Description Multiplicative generator core initialization routine","tags":"","url":"interface/initcore.html"},{"title":"calcCoreVals – ReMKiT1D","text":"interface private module subroutine calcCoreVals(this, res, xVals, hVals, vVals) Implementation → Arguments Type Intent Optional Attributes Name class( MultiplicativeGeneratorCore ), intent(inout) :: this type( RealArray ), intent(inout), allocatable, dimension(:) :: res type( RealArray ), intent(in), dimension(:) :: xVals x stencil values type( RealArray ), intent(in), optional, dimension(:) :: hVals h stencil values type( RealArray ), intent(in), optional, dimension(:) :: vVals v stencil values Description Calculate multiplicative core values. All passed stencil values should be indexed starting at the first evolved point. If there are\nany gaps in the row values those must also be included for indexing to work.","tags":"","url":"interface/calccorevals.html"},{"title":"addSimpleTransitionToCRMData – ReMKiT1D","text":"subroutine addSimpleTransitionToCRMData(crmData, envObj, tTag, fixedEnergies) Add custom simple transition to CRM data object based on JSON file Arguments Type Intent Optional Attributes Name type( ModelboundCRMData ), intent(inout) :: crmData type( EnvironmentWrapper ), intent(inout) :: envObj character(len=*), intent(in) :: tTag real(kind=rk), intent(in), dimension(:) :: fixedEnergies","tags":"","url":"proc/addsimpletransitiontocrmdata.html"},{"title":"addDerivedTransitionToCRMData – ReMKiT1D","text":"subroutine addDerivedTransitionToCRMData(crmData, envObj, tTag, fixedEnergies) Add custom derived transition to CRM data object based on JSON file Arguments Type Intent Optional Attributes Name type( ModelboundCRMData ), intent(inout) :: crmData type( EnvironmentWrapper ), intent(inout) :: envObj character(len=*), intent(in) :: tTag real(kind=rk), intent(in), dimension(:) :: fixedEnergies","tags":"","url":"proc/addderivedtransitiontocrmdata.html"},{"title":"addFixedECSTransitionToCRMData – ReMKiT1D","text":"subroutine addFixedECSTransitionToCRMData(crmData, envObj, tTag, fixedEnergies) Add custom fixed energy/cross-section transition to CRM data object based on JSON file Arguments Type Intent Optional Attributes Name type( ModelboundCRMData ), intent(inout) :: crmData type( EnvironmentWrapper ), intent(inout) :: envObj character(len=*), intent(in) :: tTag real(kind=rk), intent(in), dimension(:) :: fixedEnergies","tags":"","url":"proc/addfixedecstransitiontocrmdata.html"},{"title":"addVariableECSTransitionToCRMData – ReMKiT1D","text":"subroutine addVariableECSTransitionToCRMData(crmData, envObj, tTag) Add custom variable energy/cross-section transition to CRM data object based on JSON file Arguments Type Intent Optional Attributes Name type( ModelboundCRMData ), intent(inout) :: crmData type( EnvironmentWrapper ), intent(inout) :: envObj character(len=*), intent(in) :: tTag","tags":"","url":"proc/addvariableecstransitiontocrmdata.html"},{"title":"addDBTransitionToCRMData – ReMKiT1D","text":"subroutine addDBTransitionToCRMData(crmData, envObj, tTag, fixedEnergies) Add custom detailed balance transition to CRM data object based on JSON file. Arguments Type Intent Optional Attributes Name type( ModelboundCRMData ), intent(inout) :: crmData type( EnvironmentWrapper ), intent(inout) :: envObj character(len=*), intent(in) :: tTag real(kind=rk), intent(in), dimension(:) :: fixedEnergies","tags":"","url":"proc/adddbtransitiontocrmdata.html"},{"title":"addJanevRadRecombTransitionToCRMData – ReMKiT1D","text":"subroutine addJanevRadRecombTransitionToCRMData(crmData, envObj, tTag, normObj) Add Janev data radiative recombination transition to CRM data object based on JSON file Arguments Type Intent Optional Attributes Name type( ModelboundCRMData ), intent(inout) :: crmData type( EnvironmentWrapper ), intent(inout) :: envObj character(len=*), intent(in) :: tTag class( Normalization ), intent(in) :: normObj","tags":"","url":"proc/addjanevradrecombtransitiontocrmdata.html"},{"title":"addJanevCollExIonTransitionToCRMData – ReMKiT1D","text":"subroutine addJanevCollExIonTransitionToCRMData(crmData, envObj, tTag, normObj) Add Janev data collisional excitation/ionization transition to CRM data object based on JSON file Arguments Type Intent Optional Attributes Name type( ModelboundCRMData ), intent(inout) :: crmData type( EnvironmentWrapper ), intent(inout) :: envObj character(len=*), intent(in) :: tTag class( Normalization ), intent(in) :: normObj","tags":"","url":"proc/addjanevcollexiontransitiontocrmdata.html"},{"title":"addJanevCollDeexRecombTransitionToCRMData – ReMKiT1D","text":"subroutine addJanevCollDeexRecombTransitionToCRMData(crmData, envObj, tTag, normObj) Add Janev data collisional deexcitation/recombination transition to CRM data object based on JSON file Arguments Type Intent Optional Attributes Name type( ModelboundCRMData ), intent(inout) :: crmData type( EnvironmentWrapper ), intent(inout) :: envObj character(len=*), intent(in) :: tTag class( Normalization ), intent(in) :: normObj","tags":"","url":"proc/addjanevcolldeexrecombtransitiontocrmdata.html"},{"title":"calculateCentralDiffDeriv – ReMKiT1D","text":"interface private module function calculateCentralDiffDeriv(this, inputArray, indices) result(output) Implementation → Arguments Type Intent Optional Attributes Name class( CentralDiffDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk),allocatable,dimension(:)","tags":"","url":"interface/calculatecentraldiffderiv.html"},{"title":"initCentralDiffDeriv – ReMKiT1D","text":"interface private module subroutine initCentralDiffDeriv(this, refGeometry, refPartition, procRank, varPowers, multConst) Implementation → Arguments Type Intent Optional Attributes Name class( CentralDiffDerivation ), intent(inout) :: this type( Geometry ), intent(in) :: refGeometry Geometry object used to calculate central difference type( Partition ), intent(in) :: refPartition Partition object used to calculate central difference integer(kind=ik), intent(in) :: procRank Current processor rank real(kind=rk), intent(in), optional, dimension(:) :: varPowers Optional fluid variable powers real(kind=rk), intent(in), optional :: multConst Optional multiplicative constant - default 1 Description Initialize central difference derivation object","tags":"","url":"interface/initcentraldiffderiv.html"},{"title":"hasBoundary – ReMKiT1D","text":"interface private pure module function hasBoundary(this) result(active) Implementation → Arguments Type Intent Optional Attributes Name class( Extrapolation ), intent(in) :: this Return Value logical Description Getter for active","tags":"","url":"interface/hasboundary.html"},{"title":"isLeftBoundary – ReMKiT1D","text":"interface private pure module function isLeftBoundary(this) result(leftBoundary) Implementation → Arguments Type Intent Optional Attributes Name class( Extrapolation ), intent(in) :: this Return Value logical Description Getter for leftBoundary","tags":"","url":"interface/isleftboundary.html"},{"title":"usesStaggeredVars – ReMKiT1D","text":"interface private pure module function usesStaggeredVars(this) result(staggeredVars) Implementation → Arguments Type Intent Optional Attributes Name class( Extrapolation ), intent(in) :: this Return Value logical Description Getter for staggeredVars","tags":"","url":"interface/usesstaggeredvars.html"},{"title":"getHaloWidth – ReMKiT1D","text":"interface private pure module function getHaloWidth(this) result(haloWidth) Implementation → Arguments Type Intent Optional Attributes Name class( Extrapolation ), intent(in) :: this Return Value integer(kind=ik) Description Getter for haloWidth","tags":"","url":"interface/gethalowidth.html"},{"title":"setOnBoundary – ReMKiT1D","text":"interface private module subroutine setOnBoundary(this, partObj, gridObj, numProc) Implementation → Arguments Type Intent Optional Attributes Name class( Extrapolation ), intent(inout) :: this type( Partition ), intent(in) :: partObj type( Grid ), intent(in) :: gridObj integer(kind=ik), intent(in) :: numProc Description Check if this processor has the boundary corresponding with this extrapolation and set active","tags":"","url":"interface/setonboundary.html"},{"title":"setLeftBoundary – ReMKiT1D","text":"interface private module subroutine setLeftBoundary(this, leftBoundary) Implementation → Arguments Type Intent Optional Attributes Name class( Extrapolation ), intent(inout) :: this logical, intent(in) :: leftBoundary Description Setter for leftBoundary","tags":"","url":"interface/setleftboundary.html"},{"title":"setStaggeredVars – ReMKiT1D","text":"interface private module subroutine setStaggeredVars(this, stagVars) Implementation → Arguments Type Intent Optional Attributes Name class( Extrapolation ), intent(inout) :: this logical, intent(in) :: stagVars Description Setter for staggeredVars","tags":"","url":"interface/setstaggeredvars.html"},{"title":"setHaloWidth – ReMKiT1D","text":"interface private module subroutine setHaloWidth(this, haloWidth) Implementation → Arguments Type Intent Optional Attributes Name class( Extrapolation ), intent(inout) :: this integer(kind=ik), intent(in) :: haloWidth Description Setter for haloWidth","tags":"","url":"interface/sethalowidth.html"},{"title":"isSignalRegistered – ReMKiT1D","text":"interface private pure module function isSignalRegistered(this, name) result(reg) Implementation → Arguments Type Intent Optional Attributes Name class( SignalCollection ), intent(in) :: this character(len=*), intent(in) :: name Return Value logical Description Check whether signal with given name is registered in the collection","tags":"","url":"interface/issignalregistered.html"},{"title":"initSignalCollection – ReMKiT1D","text":"interface private pure module subroutine initSignalCollection(this) Implementation → Arguments Type Intent Optional Attributes Name class( SignalCollection ), intent(inout) :: this Description SignalCollection object initialization","tags":"","url":"interface/initsignalcollection.html"},{"title":"addSignal – ReMKiT1D","text":"interface private module subroutine addSignal(this, sig, name) Implementation → Arguments Type Intent Optional Attributes Name class( SignalCollection ), intent(inout) :: this class( TimeSignal ), intent(in) :: sig character(len=*), intent(in) :: name Description Add named signal to collection","tags":"","url":"interface/addsignal.html"},{"title":"copySignal – ReMKiT1D","text":"interface private pure module subroutine copySignal(this, name, sig) Implementation → Arguments Type Intent Optional Attributes Name class( SignalCollection ), intent(in) :: this character(len=*), intent(in) :: name class( TimeSignal ), intent(inout), allocatable :: sig Description Copy signal with given name into passed sig object, overwriting any existing allocation","tags":"","url":"interface/copysignal.html"},{"title":"initCRMElEnergyTermGenerator – ReMKiT1D","text":"interface private module subroutine initCRMElEnergyTermGenerator(this, envObj, crmData, generatorTag, electronEnergyVarName, includedTransitionIndices) Implementation → Arguments Type Intent Optional Attributes Name class( CRMElEnergyTermGenerator ), intent(inout) :: this type( EnvironmentWrapper ), intent(in), target :: envObj Environment wrapper used to get species data, partition info, etc. type( ModelboundCRMData ), intent(in) :: crmData CRM data object used to get transition data character(len=*), intent(in) :: generatorTag character(len=*), intent(in) :: electronEnergyVarName Name of electron energy variable (used as evolved var) integer(kind=ik), intent(in), optional, dimension(:) :: includedTransitionIndices Optional list of transitions to be included \nin source calculations by this generator.\nDefaults to all transitions that include electrons in ingoingStates Description Constructor routine for CRM energy source/sink term generator","tags":"","url":"interface/initcrmelenergytermgenerator.html"},{"title":"generateElEnergySourceTerms – ReMKiT1D","text":"interface private module subroutine generateElEnergySourceTerms(this, mbData) Implementation → Arguments Type Intent Optional Attributes Name class( CRMElEnergyTermGenerator ), intent(inout) :: this class( ModelboundData ), intent(in), optional :: mbData Description Generates and allocates parent implicit energy source terms","tags":"","url":"interface/generateelenergysourceterms.html"},{"title":"finalizeCRMElEnergyGenerator – ReMKiT1D","text":"interface private elemental module subroutine finalizeCRMElEnergyGenerator(this) Implementation → Arguments Type Intent Optional Attributes Name type( CRMElEnergyTermGenerator ), intent(inout) :: this Description Deallocate pointer component","tags":"","url":"interface/finalizecrmelenergygenerator.html"},{"title":"initDDVValGen – ReMKiT1D","text":"interface private module subroutine initDDVValGen(this, partitionObj, vspaceObj, procRank, activeXCoords, fixedC, fixedInterp, mbC, mbInterp, cfAtZero) Implementation → Arguments Type Intent Optional Attributes Name class( DDVStencilGenerator ), intent(inout) :: this type( Partition ), intent(in) :: partitionObj Partition object used to determine local number of rows type( VSpace ), intent(in) :: vspaceObj VSpace object used to get interpolation object integer(kind=ik), intent(in) :: procRank Current processor rank integer(kind=ik), intent(in), dimension(:) :: activeXCoords List of active global x coords real(kind=rk), intent(in), optional, dimension(:) :: fixedC Fixed C values (size numV). Defaults to ones. real(kind=rk), intent(in), optional, dimension(:) :: fixedInterp Fixed vel interpolation values (size numV). Defaults to values from VSpace. character(len=*), intent(in), optional :: mbC Optional modelbound value for C (single harmonic variable). Overrides fixed values. character(len=*), intent(in), optional :: mbInterp Optional modelbound value for interpolation weight (single harmonic variable). Overrides fixed values. real(kind=rk), intent(in), optional, dimension(2) :: cfAtZero Optional extrapolation of C f at zero in the form A1 f(v1)+A2*f(v2) where all A's are fixed. Defaults to 0. Description d/dv stencil value generator initialization routine","tags":"","url":"interface/initddvvalgen.html"},{"title":"calcDDVVals – ReMKiT1D","text":"interface private module subroutine calcDDVVals(this, varCont, res, mbData, hostModel) Im