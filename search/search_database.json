tCSDim(this) result(csDim) Interface → Getter for csDim Arguments Type Intent Optional Attributes Name class( Transition ), intent(in) :: this Return Value integer(kind=ik)","tags":"","url":"proc/getcsdim.html"},{"title":"getRateSize – ReMKiT1D","text":"pure module function getRateSize(this) result(rateSize) Interface → Getter for rate array length Arguments Type Intent Optional Attributes Name class( Transition ), intent(in) :: this Return Value integer(kind=ik)","tags":"","url":"proc/getratesize.html"},{"title":"setStates – ReMKiT1D","text":"pure module subroutine setStates(this, inStates, outStates) Interface → Setter for both ingoing and outgoing states Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this integer(kind=ik), intent(in), dimension(:) :: inStates Ingoing state IDs integer(kind=ik), intent(in), dimension(:) :: outStates Outgoing state IDs","tags":"","url":"proc/setstates.html"},{"title":"setRate – ReMKiT1D","text":"pure module subroutine setRate(this, rate) Interface → Setter for rate values Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this real(kind=rk), intent(in), dimension(:) :: rate","tags":"","url":"proc/setrate.html"},{"title":"setRateMomentum – ReMKiT1D","text":"pure module subroutine setRateMomentum(this, rate) Interface → Setter for rateMomentum values Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this real(kind=rk), intent(in), dimension(:) :: rate","tags":"","url":"proc/setratemomentum.html"},{"title":"setRateEnergy – ReMKiT1D","text":"pure module subroutine setRateEnergy(this, rate) Interface → Setter for rateEnergy Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this real(kind=rk), intent(in), dimension(:) :: rate","tags":"","url":"proc/setrateenergy.html"},{"title":"setCrossSectionCol – ReMKiT1D","text":"pure module subroutine setCrossSectionCol(this, crossSection, col) Interface → Set cross-section values in column col Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this real(kind=rk), intent(in), dimension(:) :: crossSection integer(kind=ik), intent(in) :: col","tags":"","url":"proc/setcrosssectioncol.html"},{"title":"setCrossSection – ReMKiT1D","text":"pure module subroutine setCrossSection(this, crossSection) Interface → Setter for crossSection Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this real(kind=rk), intent(in), dimension(:,:) :: crossSection","tags":"","url":"proc/setcrosssection.html"},{"title":"setIncludeElectronDensity – ReMKiT1D","text":"pure module subroutine setIncludeElectronDensity(this, includeDens) Interface → Setter for rateContainsElDensity Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this logical, intent(in) :: includeDens","tags":"","url":"proc/setincludeelectrondensity.html"},{"title":"setCSDim – ReMKiT1D","text":"pure module subroutine setCSDim(this, csDim) Interface → Setter for csDim Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this integer(kind=ik), intent(in) :: csDim","tags":"","url":"proc/setcsdim.html"},{"title":"noUpdate – ReMKiT1D","text":"module subroutine noUpdate(this, varCont, hostModel, hostData, updatePriority) Interface → Default update routine - does nothing Arguments Type Intent Optional Attributes Name class( Transition ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont Variable container used in update class( ModelSurrogate ), intent(in), optional :: hostModel Optional host model reference for callbacks during update class( ModelboundData ), intent(in), optional :: hostData Optional host data reference for callbacks during update integer(kind=ik), intent(in), optional :: updatePriority Priority for this update call","tags":"","url":"proc/noupdate~2.html"},{"title":"getEnergy – ReMKiT1D","text":"pure module function getEnergy(this) result(energyCost) Interface → Returns array representing energy cost of this transition Arguments Type Intent Optional Attributes Name class( DerivedTransition ), intent(in) :: this Return Value real(kind=rk), allocatable, dimension(:)","tags":"","url":"proc/getenergy~5.html"},{"title":"initDerivedTransition – ReMKiT1D","text":"pure module subroutine initDerivedTransition(this, locNumX, inStates, outStates, energy, rateDeriv, rateDerivIndices, momentumRateDeriv, momentumRateDerivIndices, energyRateDeriv, energyRateDerivIndices) Interface → Initialization routine for DerivedTransition object Arguments Type Intent Optional Attributes Name class( DerivedTransition ), intent(inout) :: this integer(kind=ik), intent(in) :: locNumX Local number of spatial cells integer(kind=ik), intent(in), dimension(:) :: inStates Pre-transition states integer(kind=ik), intent(in), dimension(:) :: outStates Post-transition states real(kind=rk), intent(in) :: energy Transition energy class( Derivation ), intent(in) :: rateDeriv Derivation object used in rate calculation integer(kind=ik), intent(in), dimension(:) :: rateDerivIndices Indices for rate derivation class( Derivation ), intent(in), optional :: momentumRateDeriv Derivation object used in momentum rate calculation integer(kind=ik), intent(in), optional, dimension(:) :: momentumRateDerivIndices Indices for momentum rate derivation class( Derivation ), intent(in), optional :: energyRateDeriv Derivation object used in energy rate calculation integer(kind=ik), intent(in), optional, dimension(:) :: energyRateDerivIndices Indices for energy rate derivation","tags":"","url":"proc/initderivedtransition.html"},{"title":"updateRates – ReMKiT1D","text":"module subroutine updateRates(this, varCont, hostModel, hostData, updatePriority) Interface → Update transition rates using derivation object Arguments Type Intent Optional Attributes Name class( DerivedTransition ), intent(inout) :: this type( VariableContainer ), intent(in) :: var