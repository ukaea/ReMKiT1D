ption PETSc controller initialization routine","tags":"","url":"interface/initpetsccontroller.html"},{"title":"addRowDataToPreallocation – ReMKiT1D","text":"interface private pure module subroutine addRowDataToPreallocation(this, rowData) Implementation → Arguments Type Intent Optional Attributes Name class( PETScController ), intent(inout) :: this type( SparseRowData ), intent(in) :: rowData Description Add sparse row data structure to total preallocation sparsity pattern","tags":"","url":"interface/addrowdatatopreallocation.html"},{"title":"addRowValuesToMatrix – ReMKiT1D","text":"interface private module subroutine addRowValuesToMatrix(this, rowData, multConst, objGroup) Implementation → Arguments Type Intent Optional Attributes Name class( PETScController ), intent(inout) :: this type( SparseRowData ), intent(in) :: rowData real(kind=rk), intent(in), optional :: multConst integer(kind=ik), intent(in), optional :: objGroup Description Add row data to matrix, optionally multiplied by a real constant","tags":"","url":"interface/addrowvaluestomatrix.html"},{"title":"createPETScObjs – ReMKiT1D","text":"interface private module subroutine createPETScObjs(this) Implementation → Arguments Type Intent Optional Attributes Name class( PETScController ), intent(inout) :: this Description Assemble the preallocation object, create PETSc objects, and deallocate the preallocation object","tags":"","url":"interface/createpetscobjs.html"},{"title":"linearSolve – ReMKiT1D","text":"interface private module subroutine linearSolve(this, knownVec, unknownVec, objGroup) Implementation → Arguments Type Intent Optional Attributes Name class( PETScController ), intent(inout) :: this real(kind=rk), intent(in), dimension(:) :: knownVec real(kind=rk), intent(out), dimension(:) :: unknownVec integer(kind=ik), intent(in), optional :: objGroup Description Solve the equation petscMat * unknownVec = knownVec where the vectors are local to each processor - assembles and zeros out the\nmatrix before/after the solve","tags":"","url":"interface/linearsolve.html"},{"title":"finalize – ReMKiT1D","text":"interface private module subroutine finalize(this) Implementation → Arguments Type Intent Optional Attributes Name class( PETScController ), intent(inout) :: this Description Finalizes PETSc and destroys all PETSc objects","tags":"","url":"interface/finalize.html"},{"title":"calculateAdditive – ReMKiT1D","text":"interface private module function calculateAdditive(this, inputArray, indices) result(output) Implementation → Arguments Type Intent Optional Attributes Name class( AdditiveDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk),allocatable,dimension(:)","tags":"","url":"interface/calculateadditive.html"},{"title":"initAdditiveDeriv – ReMKiT1D","text":"interface private module subroutine initAdditiveDeriv(this, numDerivs, expectedNumIndices, resultPower, linearCoefficients) Implementation → Arguments Type Intent Optional Attributes Name class( AdditiveDerivation ), intent(inout) :: this integer(kind=ik), intent(in) :: numDerivs integer(kind=ik), intent(in) :: expectedNumIndices real(kind=rk), intent(in), optional :: resultPower real(kind=rk), intent(in), optional, dimension(:) :: linearCoefficients Description Initialize additive derivation object, allocating the expected number of derivation objects","tags":"","url":"interface/initadditivederiv.html"},{"title":"addDerivation – ReMKiT1D","text":"interface private module subroutine addDerivation(this, deriv, activeIndices) Implementation → Arguments Type Intent Optional Attributes Name class( AdditiveDerivation ), intent(inout) :: this class( Derivation ), intent(in) :: deriv integer(kind=ik), intent(in), dimension(:) :: activeIndices Entries of indices object passed to calculateAdditive to be passed to added derivation Description Adds derivation to additive derivation object","tags":"","url":"interface/addderivation~2.html"},{"title":"getNormalizationConst – ReMKiT1D","text":"interface private pure module function getNormalizationConst(this) result(norm) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(in) :: this Return Value real(kind=rk) Description Getter for normalizationConst","tags":"","url":"interface/getnormalizationconst.html"},{"title":"evaluateMatTerm – ReMKiT1D","text":"interface private module function evaluateMatTerm(this, varCont) result(res) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(in) :: this type( VariableContainer ), intent(in) :: varCont Return Value real(kind=rk),allocatable,dimension(:) Description Get explicit value for the term by crudely dotting each sparse row with the locally stored implicit variable vector in varCont","tags":"","url":"interface/evaluatematterm.html"},{"title":"getMultConst – ReMKiT1D","text":"interface private pure module function getMultConst(this) result(multConst) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(in) :: this Return Value type( RealArray ),allocatable,dimension(:) Description Getter for multConst","tags":"","url":"interface/getmultconst.html"},{"title":"getRowVarName – ReMKiT1D","text":"interface private pure module function getRowVarName(this) result(name) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(in) :: this Return Value character(len=:),allocatable Description Get name of the evolved variable of this term","tags":"","url":"interface/getrowvarname.html"},{"title":"getIndexingData – ReMKiT1D","text":"interface private pure module function getIndexingData(this) result(indData) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(in) :: this Return Value type( MatrixTermIndexingData ) Description Getter for indexingData","tags":"","url":"interface/getindexingdata.html"},{"title":"getRowData – ReMKiT1D","text":"interface private pure module function getRowData(this) result(rowData) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(in) :: this Return Value type( SparseRowData ) Description Getter for rowData","tags":"","url":"interface/getrowdata.html"},{"title":"unityRow – ReMKiT1D","text":"interface private pure module subroutine unityRow(this, varCont, rowVals, indexingData) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont real(kind=rk), intent(inout), dimension(:) :: rowVals type( MatrixTermIndexingData ), intent(in) :: indexingData Description Default row function. In general should use the passed variable container, row buffer, and matrix indexing data\nto provide values which is only a function of the row","tags":"","url":"interface/unityrow.html"},{"title":"unityCol – ReMKiT1D","text":"interface private pure module subroutine unityCol(this, varCont, colVals, indexingData) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont type( RealArray ), intent(inout), dimension(:) :: colVals type( MatrixTermIndexingData ), intent(in) :: indexingData Description Default column function. In general should provide values for each column","tags":"","url":"interface/unitycol.html"},{"title":"calculateValues – ReMKiT1D","text":"interface private pure module subroutine calculateValues(this, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont Description Default matrix entry calculation routine - loops over each row and applies rowFun and colFun to variables in provided container","tags":"","url":"interface/calculatevalues.html"},{"title":"setNormalizationConst – ReMKiT1D","text":"interface private pure module subroutine setNormalizationConst(this, norm) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this real(kind=rk), intent(in) :: norm Description Setter for normalizationConst","tags":"","url":"interface/setnormalizationconst.html"},{"title":"setReqVars – ReMKiT1D","text":"interface private pure module subroutine setReqVars(this, rowReqVars, colReqVars, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this type( StringArray ), intent(in), dimension(:) :: rowReqVars type( StringArray ), intent(in), dimension(:) :: colReqVars type( VariableContainer ), intent(in) :: varCont Description Set variable names required by the row and column functions and find their indices in variable container","tags":"","url":"interface/setreqvars.html"},{"title":"setEvolvedAndImplicitVar – ReMKiT1D","text":"interface private pure module subroutine setEvolvedAndImplicitVar(this, rowVarName, colVarName, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this character(len=*), intent(in) :: rowVarName character(len=*), intent(in) :: colVarName type( VariableContainer ), intent(in) :: varCont Description Set evolved (row) and implicit (column) variable names, and check if evolved variable is stationary using varCont","tags":"","url":"interface/setevolvedandimplicitvar.html"},{"title":"initRowData – ReMKiT1D","text":"interface private module subroutine initRowData(this, rowCoords, rowToColMapping, indexingObj) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this integer(kind=ik), intent(in), dimension(:,:) :: rowCoords procedure( coordMapping ) :: rowToColMapping type( Indexing ), intent(in) :: indexingObj Description Initialize row data objects based on a set of evolved global coordinates, the row/col var name, and a function that returns \ncolumn coordinates given a row coordinate input. Requires a reference Indexing object.","tags":"","url":"interface/initrowdata.html"},{"title":"addRowDataToPreallocationData – ReMKiT1D","text":"interface private module subroutine addRowDataToPreallocationData(this, petscPreallocData) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this type( PETScPreallocationData ), intent(inout) :: petscPreallocData Description Add this term's row data to a PETSc preallocation object","tags":"","url":"interface/addrowdatatopreallocationdata.html"},{"title":"addRowDataPatternToController – ReMKiT1D","text":"interface private module subroutine addRowDataPatternToController(this, petscCont) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(in) :: this type( PETScController ), intent(inout) :: petscCont Description Add this term's row data to a petsc preallocation object in PETSc controller","tags":"","url":"interface/addrowdatapatterntocontroller.html"},{"title":"addRowValuesToPETScMatrix – ReMKiT1D","text":"interface private module subroutine addRowValuesToPETScMatrix(this, petscCont, mult, petscGroup) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(in) :: this type( PETScController ), intent(inout) :: petscCont real(kind=rk), intent(in) :: mult integer(kind=ik), intent(in), optional :: petscGroup Description Add this term's row values to a petsc matrix object in PETSc controller, multiplied by mult. If evolved variable is\nstationary mult is ignored and set to -1","tags":"","url":"interface/addrowvaluestopetscmatrix.html"},{"title":"setMultConst – ReMKiT1D","text":"interface private pure module subroutine setMultConst(this, multConst) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: multConst Description Setter for multConst","tags":"","url":"interface/setmultconst.html"},{"title":"setFixedMatrix – ReMKiT1D","text":"interface private pure module subroutine setFixedMatrix(this, isFixed) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this logical, intent(in) :: isFixed Description Set whether the matrix is fixed -> only calculated once","tags":"","url":"interface/setfixedmatrix.html"},{"title":"setNonTrivialRowFun – ReMKiT1D","text":"interface private pure module subroutine setNonTrivialRowFun(this, nontriv) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this logical, intent(in) :: nontriv Description Set whether the matrix has a non-trivial row function","tags":"","url":"interface/setnontrivialrowfun.html"},{"title":"setNonTrivialColFun – ReMKiT1D","text":"interface private pure module subroutine setNonTrivialColFun(this, nontriv) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this logical, intent(in) :: nontriv Description Set whether the matrix has a non-trivial col function","tags":"","url":"interface/setnontrivialcolfun.html"},{"title":"matTermUpdate – ReMKiT1D","text":"interface private module subroutine matTermUpdate(this, varCont, modelData, hostModel) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont class( ModelboundData ), intent(in), optional :: modelData class( ModelSurrogate ), intent(in), optional :: hostModel Description Default matrix term update, call matrixTermUpdate","tags":"","url":"interface/mattermupdate.html"},{"title":"matrixNoUpdate – ReMKiT1D","text":"interface private module subroutine matrixNoUpdate(this, varCont, indexingData, modelData, hostModel) Implementation → Arguments Type Intent Optional Attributes Name class( MatrixTerm ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont type( MatrixTermIndexingData ), intent(in) :: indexingData class( ModelboundData ), intent(in), optional :: modelData class( ModelSurrogate ), intent(in), optional :: hostModel Description Default MatrixTerm updateMatTerm function - does nothing","tags":"","url":"interface/matrixnoupdate.html"},{"title":"getNumVars – ReMKiT1D","text":"interface private pure module function getNumVars(this) result(numVars) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this Return Value integer(kind=ik) Description Returns number of variables in list","tags":"","url":"interface/getnumvars.html"},{"title":"getVarNames – ReMKiT1D","text":"interface private pure module function getVarNames(this) result(names) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this Return Value type( StringArray ),allocatable,dimension(:) Description Getter of names","tags":"","url":"interface/getvarnames.html"},{"title":"getVarName – ReMKiT1D","text":"interface private pure module function getVarName(this, ind) result(name) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value character(len=:),allocatable Description Return variable name at index ind","tags":"","url":"interface/getvarname~2.html"},{"title":"getVarPriority – ReMKiT1D","text":"interface private pure module function getVarPriority(this, ind) result(priority) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value integer(kind=ik) Description Return priority of variable with given index","tags":"","url":"interface/getvarpriority.html"},{"title":"isVarDist – ReMKiT1D","text":"interface private pure module function isVarDist(this, ind) result(distf) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value logical Description Check whether variable with given index is a full distribution function","tags":"","url":"interface/isvardist~2.html"},{"title":"isVarSingleHarmonic – ReMKiT1D","text":"interface private pure module function isVarSingleHarmonic(this, ind) result(singleH) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value logical Description Check whether variable with given index is a single harmonic","tags":"","url":"interface/isvarsingleharmonic.html"},{"title":"isVarScalar – ReMKiT1D","text":"interface private pure module function isVarScalar(this, ind) result(scal) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value logical Description Check whether variable with given index is a scalar","tags":"","url":"interface/isvarscalar~2.html"},{"title":"isVarOnDualGrid – ReMKiT1D","text":"interface private pure module function isVarOnDualGrid(this, ind) result(dual) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value logical Description Check whether variable with given index is a on dual grid","tags":"","url":"interface/isvarondualgrid~2.html"},{"title":"isVarStationary – ReMKiT1D","text":"interface private pure module function isVarStationary(this, ind) result(stat) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value logical Description Check whether variable with given index is stationary","tags":"","url":"interface/isvarstationary.html"},{"title":"isVarNameRegistered – ReMKiT1D","text":"interface private pure module function isVarNameRegistered(this, name) result(reg) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this character(len=*), intent(in) :: name Return Value logical Description Check whether variable with given name is registered","tags":"","url":"interface/isvarnameregistered~2.html"},{"title":"getVarIndex – ReMKiT1D","text":"interface private pure module function getVarIndex(this, name) result(ind) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this character(len=*), intent(in) :: name Return Value integer(kind=ik) Description Get index of variable with given name","tags":"","url":"interface/getvarindex~2.html"},{"title":"combineWith – ReMKiT1D","text":"interface private pure module function combineWith(this, other) result(res) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(in) :: this type( VariableList ), intent(in) :: other Return Value type( VariableList ) Description Combine two lists into one","tags":"","url":"interface/combinewith.html"},{"title":"initVarList – ReMKiT1D","text":"interface private pure module subroutine initVarList(this) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(inout) :: this Description Variable list initialization routine","tags":"","url":"interface/initvarlist.html"},{"title":"addVar – ReMKiT1D","text":"interface private pure module subroutine addVar(this, name, isDist, isSingleHarmonic, isScalar, isOnDualGrid, isStationary, priority) Implementation → Arguments Type Intent Optional Attributes Name class( VariableList ), intent(inout) :: this character(len=*), intent(in) :: name logical, intent(in), optional :: isDist logical, intent(in), optional :: isSingleHarmonic logical, intent(in), optional :: isScalar logical, intent(in), optional :: isOnDualGrid logical, intent(in), optional :: isStationary integer(kind=ik), intent(in), optional :: priority Description Add variable with given name to list; isDist determines if variable is a distribution function and is .false. by default;\nisSingleHarmonic sets whether a given distribution is only a single harmonic - i.e. a function of just x and v\nisScalar tags variable as a scalar (will be stored as a dimension 1 array)\nisOnDualGrid marks variable as living on the dual/staggered grid (or having staggered harmonics if it's a distribution)\nisStationary marks variable as having d/dt=0\npriority is an integer governing operations such as variable derivation","tags":"","url":"interface/addvar.html"},{"title":"logLee – ReMKiT1D","text":"interface public pure module function logLee(Te, ne) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Te Electron temperature in eV real(kind=rk), intent(in) :: ne Electron density in m&#94;{-3} Return Value real(kind=rk) Description Calculate Coulomb logarithm for electron-electron collisions (NRL Formulary 2013 page 34 equation a)","tags":"","url":"interface/loglee.html"},{"title":"logLei – ReMKiT1D","text":"interface public pure module function logLei(Te, ne, Z, removeDisc) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Te Electron temperature in eV real(kind=rk), intent(in) :: ne Electron density in m&#94;{-3} real(kind=rk), intent(in) :: Z Ion charge logical, intent(in), optional :: removeDisc Remove the discontinuity at 10eV by moving the branch switch to Te = Z 2 * e 2 eV. Defaults to .false. Return Value real(kind=rk) Description Calculate Coulomb logarithm for electron-ion collisions (NRL Formulary 2013 page 34 equation b). Assumes  Te > Ti Z me/mi","tags":"","url":"interface/loglei.html"},{"title":"logLii – ReMKiT1D","text":"interface public pure module function logLii(Z1, Z2, mRatio, n1, n2, T1, T2) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Z1 Ion charge for first species real(kind=rk), intent(in) :: Z2 Ion charge for second species real(kind=rk), intent(in) :: mRatio Mass ratio m2/m1 real(kind=rk), intent(in) :: n1 First ion species density in m&#94;{-3} real(kind=rk), intent(in) :: n2 Second ion species density in m&#94;{-3} real(kind=rk), intent(in) :: T1 First ion temperature in eV real(kind=rk), intent(in) :: T2 Second ion temperature in eV Return Value real(kind=rk) Description Calculate Coulomb logarithm for ion-ion collisions (NRL Formulary 2013 page 34 equation c).","tags":"","url":"interface/loglii.html"},{"title":"shPotDrop – ReMKiT1D","text":"interface public pure module function shPotDrop(massRatio, tempRatio) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: massRatio Mass ratio me/mi real(kind=rk), intent(in) :: tempRatio Ion to electron temperature ratio Return Value real(kind=rk) Description Calculate sheath potential drop for 2 component plasma in units of kTe/e","tags":"","url":"interface/shpotdrop.html"},{"title":"collTimeei – ReMKiT1D","text":"interface public pure module function collTimeei(Te, ne, Z, logL) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Te Electron temperature in eV real(kind=rk), intent(in) :: ne Electron density in m&#94;{-3} real(kind=rk), intent(in) :: Z Ion charge real(kind=rk), intent(in) :: logL Coulomb logarithm to be used Return Value real(kind=rk) Description Calculate electron-ion collision time in seconds. This is not the Braginskii time, which can be calculated as this value \nmultiplied by  4/(3*sqrt(pi)) .","tags":"","url":"interface/colltimeei.html"},{"title":"elPlasmaOscFreq – ReMKiT1D","text":"interface public pure module function elPlasmaOscFreq(ne) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: ne Electron density in m&#94;{-3} Return Value real(kind=rk) Description Calculate cold electron plasma oscillation frequency in s&#94;{-1}","tags":"","url":"interface/elplasmaoscfreq.html"},{"title":"elVthermal – ReMKiT1D","text":"interface public pure module function elVthermal(Te) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Te Electron temperature in eV Return Value real(kind=rk) Description Mean thermal electron speed","tags":"","url":"interface/elvthermal.html"},{"title":"vSonic – ReMKiT1D","text":"interface public pure module function vSonic(Te, Ti, mi, ePolytropic, iPolytropic) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: Te Electron temperature in eV real(kind=rk), intent(in) :: Ti Ion temperature in eV real(kind=rk), intent(in) :: mi Ion mass real(kind=rk), intent(in) :: ePolytropic Electron polytropic coefficient real(kind=rk), intent(in) :: iPolytropic Ion polytropic coefficient Return Value real(kind=rk) Description Sonic speed caclulated as sqrt((ePoly Te + iPoly Ti)/mi)","tags":"","url":"interface/vsonic.html"},{"title":"normMaxwellian – ReMKiT1D","text":"interface public pure module function normMaxwellian(n, T, vPoints) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: n Density in arbitrary units real(kind=rk), intent(in) :: T Temperature in units compatible with velocity grid real(kind=rk), intent(in), dimension(:) :: vPoints Velocity grid Return Value real(kind=rk),allocatable,dimension(:) Description Returns a normalized stationary Maxwellian evaluated at vPoints. Assumes that velocity and temperature are normalized in \nsuch way that m v_0&#94;2/2 = kT_0 , and the returned value is normalized to 1/v_0&#94;(3/2).","tags":"","url":"interface/normmaxwellian.html"},{"title":"simpleMoment – ReMKiT1D","text":"interface public pure module function simpleMoment(m, f, vPoints, vWidths, g) result(res) Implementation → Arguments Type Intent Optional Attributes Name integer(kind=ik), intent(in) :: m Moment degree real(kind=rk), intent(in), dimension(:) :: f Distribution function to take the moment of real(kind=rk), intent(in), dimension(:) :: vPoints Coordinates of cell centres in velocity space real(kind=rk), intent(in), dimension(:) :: vWidths Widths of velocity space cells real(kind=rk), intent(in), optional, dimension(:) :: g Optional velocity space array to include in moment integral Return Value real(kind=rk) Description Returns the m-th moment of passed distribution function harmonic -  4 pi int(v&#94;(2+m) f dv). Optionally takes moment of f*g\nwhere g conforms to f. The integration is a simple Riemann sum.","tags":"","url":"interface/simplemoment.html"},{"title":"calculateCoulombLog – ReMKiT1D","text":"interface private module function calculateCoulombLog(this, inputArray, indices) result(output) Implementation → Arguments Type Intent Optional Attributes Name class( CoulombLogDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk),allocatable,dimension(:)","tags":"","url":"interface/calculatecoulomblog.html"},{"title":"initCoulombLogDeriv – ReMKiT1D","text":"interface private module subroutine initCoulombLogDeriv(this, ionZ, locNumX, densNorm, tempNorm, electronLog, ionLog, ionZ2, ionMassRatio, removeLogLeiDiscontinuity) Implementation → Arguments Type Intent Optional Attributes Name class( CoulombLogDerivation ), intent(inout) :: this real(kind=rk), intent(in) :: ionZ integer(kind=ik), intent(in) :: locNumX real(kind=rk), intent(in) :: densNorm real(kind=rk), intent(in) :: tempNorm logical, intent(in), optional :: electronLog logical, intent(in), optional :: ionLog real(kind=rk), intent(in), optional :: ionZ2 real(kind=rk), intent(in), optional :: ionMassRatio logical, intent(in), optional :: removeLogLeiDiscontinuity Description Initialize Coulomb Log derivation object","tags":"","url":"interface/initcoulomblogderiv.html"},{"title":"initDiffusionStencilGen – ReMKiT1D","text":"interface private module subroutine initDiffusionStencilGen(this, partitionObj, procRank, innerJ, outerJ, linInterp, xPeriodic, diffCoeffDerivRule, xHaloWidth, doNotInterpolateD) Implementation → Arguments Type Intent Optional Attributes Name class( DiffusionStencilValGenerator ), intent(inout) :: this type( Partition ), intent(in) :: partitionObj Partition object used to determine local number of rows integer(kind=ik), intent(in) :: procRank Current processor rank real(kind=rk), intent(in), dimension(:) :: innerJ Inner/column jacobian/hodge star (should conform to x-grid) real(kind=rk), intent(in), dimension(:) :: outerJ Outer/row inverse jacobian/hodge star (should conform to x-grid) real(kind=rk), intent(in), dimension(:) :: linInterp Linear interpolation coefficients to right cell faces (should be size(xGrid)+1) logical, intent(in), optional :: xPeriodic Used to determine if outer processors should have their stencils trimmed. Defaults to .false. type( CalculationRule ), intent(in), optional :: diffCoeffDerivRule Rule for deriving the optional diffusion coefficient integer(kind=ik), intent(in), optional :: xHaloWidth Halo width in the x direction. Defaults to 1 and must always be >0 logical, intent(in), optional :: doNotInterpolateD Assume the diffusion coefficient is already calcuated at cell boundaries. Defaults to False. Description Diffusion stencil value generator initialization routine","tags":"","url":"interface/initdiffusionstencilgen.html"},{"title":"calcDiffusionStencilGen – ReMKiT1D","text":"interface private module subroutine calcDiffusionStencilGen(this, varCont, res, mbData, hostModel) Implementation → Arguments Type Intent Optional Attributes Name class( DiffusionStencilValGenerator ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont type( RealArray ), intent(inout), allocatable, dimension(:) :: res class( ModelboundData ), intent(in), optional :: mbData class( ModelSurrogate ), intent(in), optional :: hostModel Description Calculate diffusion stencil values in place","tags":"","url":"interface/calcdiffusionstencilgen.html"},{"title":"addJanevRadRecombTransition – ReMKiT1D","text":"interface public module subroutine addJanevRadRecombTransition(crmData, locNumX, endState, temperatureVarIndex, eVTempNorm, densNorm, timeNorm) Implementation → Arguments Type Intent Optional Attributes Name type( ModelboundCRMData ), intent(inout) :: crmData integer(kind=ik), intent(in) :: locNumX integer(kind=ik), intent(in) :: endState integer(kind=ik), intent(in) :: temperatureVarIndex real(kind=rk), intent(in) :: eVTempNorm real(kind=rk), intent(in) :: densNorm real(kind=rk), intent(in) :: timeNorm Description Adds Janev radiative recombination transition to endState of hydrogen. Normalizes the rate to densNorm/timeNorm for \neasier use.","tags":"","url":"interface/addjanevradrecombtransition.html"},{"title":"addJanevCollExIonTransition – ReMKiT1D","text":"interface public module subroutine addJanevCollExIonTransition(crmData, locNumX, startState, endState, distVarIndex, eVTempNorm, csNorm, refVSpace, fixedWIndex) Implementation → Arguments Type Intent Optional Attributes Name type( ModelboundCRMData ), intent(inout) :: crmData integer(kind=ik), intent(in) :: locNumX integer(kind=ik), intent(in) :: startState integer(kind=ik), intent(in) :: endState integer(kind=ik), intent(in) :: distVarIndex real(kind=rk), intent(in) :: eVTempNorm real(kind=rk), intent(in) :: csNorm type( VSpace ), intent(inout), target :: refVSpace Target for the transition reference pointer integer(kind=ik), intent(in) :: fixedWIndex Index of the inelastic weight array corresponding to this transition Description Adds Janev collisional excitation/ionization transition from startState to endState of hydrogen.\nNormalizes the cross-section for easier later use. Cross-section only isotropic.","tags":"","url":"interface/addjanevcollexiontransition.html"},{"title":"addJanevCollDeexRecombTransition – ReMKiT1D","text":"interface public module subroutine addJanevCollDeexRecombTransition(crmData, locNumX, startState, endState, distVarIndex, tempVarIndex, eVTempNorm, densNorm, refVSpace, directFixedWIndex, fixedWIndex, directTransitionIndex, csUpdatePriority) Implementation → Arguments Type Intent Optional Attributes Name type( ModelboundCRMData ), intent(inout) :: crmData integer(kind=ik), intent(in) :: locNumX integer(kind=ik), intent(in) :: startState integer(kind=ik), intent(in) :: endState integer(kind=ik), intent(in) :: distVarIndex integer(kind=ik), intent(in) :: tempVarIndex real(kind=rk), intent(in) :: eVTempNorm real(kind=rk), intent(in) :: densNorm type( VSpace ), intent(inout), target :: refVSpace Target for the transition reference pointer integer(kind=ik), intent(in) :: directFixedWIndex Index of the inelastic weight array corresponding to \nthe direct counterpart of this transition integer(kind=ik), intent(in) :: fixedWIndex Index of the inelastic weight array corresponding to this transition integer(kind=ik), intent(in) :: directTransitionIndex Index of the direct transition in crmData integer(kind=ik), intent(in) :: csUpdatePriority Update priority for detailed balance cross-section Description Adds Janev collisional deexcitation/recombination transition from startState to endState of hydrogen.\nNormalizes the cross-section for easier later use. Cross-section only isotropic.","tags":"","url":"interface/addjanevcolldeexrecombtransition.html"},{"title":"calculateInterp – ReMKiT1D","text":"interface private module function calculateInterp(this, inputArray, indices) result(output) Implementation → Arguments Type Intent Optional Attributes Name class( NDInterpolationDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk),allocatable,dimension(:)","tags":"","url":"interface/calculateinterp~2.html"},{"title":"initInterpDeriv – ReMKiT1D","text":"interface private module subroutine initInterpDeriv(this, interpObj, data) Implementation → Arguments Type Intent Optional Attributes Name class( NDInterpolationDerivation ), intent(inout) :: this type( InterpolationND ), intent(in) :: interpObj type( FlatNDData ), intent(in) :: data Description Initialize n-linear interpolation derivation object","tags":"","url":"interface/initinterpderiv~2.html"},{"title":"getCurrentTime – ReMKiT1D","text":"interface private pure module function getCurrentTime(this) result(time) Implementation → Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(in) :: this Return Value real(kind=rk) Description Getter for currentTime","tags":"","url":"interface/getcurrenttime~2.html"},{"title":"initCompositeIntegrator – ReMKiT1D","text":"interface private pure module subroutine initCompositeIntegrator(this, initialTime, initialTimestep, numIntegrators, dtController) Implementation → Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(inout) :: this real(kind=rk), intent(in) :: initialTime Time value before first step real(kind=rk), intent(in) :: initialTimestep Default timestep integer(kind=ik), intent(in) :: numIntegrators Number of integrators expected class( TimestepController ), intent(in), optional :: dtController Optional timestep controller Description Composite integraotr initialization routine","tags":"","url":"interface/initcompositeintegrator.html"},{"title":"addIntegrator – ReMKiT1D","text":"interface private pure module subroutine addIntegrator(this, integ) Implementation → Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(inout) :: this class( Integrator ), intent(in) :: integ Description Add Integrator object to composite integrator","tags":"","url":"interface/addintegrator.html"},{"title":"addIntegrationStage – ReMKiT1D","text":"interface private pure module subroutine addIntegrationStage(this, integStage) Implementation → Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(inout) :: this type( IntegratorCallStep ), intent(in) :: integStage Description Add integration stage to composite integrator","tags":"","url":"interface/addintegrationstage.html"},{"title":"setTimestepController – ReMKiT1D","text":"interface private pure module subroutine setTimestepController(this, controller) Implementation → Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(inout) :: this class( TimestepController ), intent(in) :: controller Description Setter for dtController","tags":"","url":"interface/settimestepcontroller~2.html"},{"title":"setRequestedTimestep – ReMKiT1D","text":"interface private pure module subroutine setRequestedTimestep(this, timestep) Implementation → Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(inout) :: this real(kind=rk), intent(in) :: timestep Description Setter for requestedTimestep","tags":"","url":"interface/setrequestedtimestep.html"},{"title":"resetRequestedTimestep – ReMKiT1D","text":"interface private pure module subroutine resetRequestedTimestep(this) Implementation → Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(inout) :: this Description Resets the requested timestep to the initial timestep","tags":"","url":"interface/resetrequestedtimestep.html"},{"title":"integrateAll – ReMKiT1D","text":"interface private module subroutine integrateAll(this, manipulatedModeller, outputVars, inputVars) Implementation → Arguments Type Intent Optional Attributes Name class( CompositeIntegrator ), intent(inout) :: this class( ModellerSurrogate ), intent(inout) :: manipulatedModeller Modeller object used in callback class( VariableContainer ), intent(inout) :: outputVars Container for integration output class( VariableContainer ), intent(in) :: inputVars Integration input variables Description Call all integrators based on the integration stages and global timestep. The global timestep is updated at the start if there is\nan allocated timestep controller.","tags":"","url":"interface/integrateall.html"},{"title":"calculateHE – ReMKiT1D","text":"interface private module function calculateHE(this, inputArray, indices) result(output) Implementation → Arguments Type Intent Optional Attributes Name class( HExtractorDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk),allocatable,dimension(:)","tags":"","url":"interface/calculatehe.html"},{"title":"initHEDerivation – ReMKiT1D","text":"interface private module subroutine initHEDerivation(this, vSpaceObj, targetH) Implementation → Arguments Type Intent Optional Attributes Name class( HExtractorDerivation ), intent(inout) :: this type( VSpace ), intent(in) :: vSpaceObj integer(kind=ik), intent(in) :: targetH Harmonic to extract Description Initialize harmonic extractor derivation","tags":"","url":"interface/inithederivation.html"},{"title":"calculateCCLDiff – ReMKiT1D","text":"interface private module function calculateCCLDiff(this, inputArray, indices) result(output) Implementation → Arguments Type Intent Optional Attributes Name class( CCLDiffDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk),allocatable,dimension(:)","tags":"","url":"interface/calculateccldiff.html"},{"title":"initCCLDiff – ReMKiT1D","text":"interface private module subroutine initCCLDiff(this, vSpaceObj) Implementation → Arguments Type Intent Optional Attributes Name class( CCLDiffDerivation ), intent(inout) :: this type( VSpace ), intent(in) :: vSpaceObj Description Initialize Chang-Cooper-Langdon diffusion coefficient derivation","tags":"","url":"interface/initccldiff.html"},{"title":"initUWCBCStencil – ReMKiT1D","text":"interface private module subroutine initUWCBCStencil(this, partitionObj, procRank, innerJ, outerJ, linInterp, extrapolate, interpVarIndex, leftBoundary, lowerBoundVarIndex, fixedLowerBound, linExterp) Implementation → Arguments Type Intent Optional Attributes Name class( UWCBCStencilValGenerator ), intent(inout) :: this type( Partition ), intent(in) :: partitionObj Partition object used to determine local number of rows integer(kind=ik), intent(in) :: procRank Current processor rank real(kind=rk), intent(in) :: innerJ Inner/column jacobian/hodge star at boundary face real(kind=rk), intent(in) :: outerJ Outer/row inverse jacobian/hodge star at boundary cell real(kind=rk), intent(in) :: linInterp Linear interpolation coefficient at face before boundary logical, intent(in), optional :: extrapolate Extrapolate implicit/column variables. Defaults to .false. integer(kind=ik), intent(in), optional :: interpVarIndex Variable to optionally interpolate as part of stencil (flux jacobian) logical, intent(in), optional :: leftBoundary True if the stencil values are for the left boundary condition integer(kind=ik), intent(in), optional :: lowerBoundVarIndex Variable index of lower jacobian bound variable real(kind=rk), intent(in), optional :: fixedLowerBound A constant lower bound value (ignored if lowerBoundVarIndex is allocated) real(kind=rk), intent(in), optional :: linExterp Linear extrapolation coefficient for column variables. Computed from linInterp by default Description Flux-like boundary condition stencil value generator initialization routine","tags":"","url":"interface/inituwcbcstencil.html"},{"title":"calcUWCBCVals – ReMKiT1D","text":"interface private module subroutine calcUWCBCVals(this, varCont, res, mbData, hostModel) Implementation → Arguments Type Intent Optional Attributes Name class( UWCBCStencilValGenerator ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont type( RealArray ), intent(inout), allocatable, dimension(:) :: res class( ModelboundData ), intent(in), optional :: mbData class( ModelSurrogate ), intent(in), optional :: hostModel Description Calculate flux-like boundary stencil values in place","tags":"","url":"interface/calcuwcbcvals.html"},{"title":"getFixedW – ReMKiT1D","text":"interface private pure module function getFixedW(this, ind) result(wMat) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value type( SparseRowData ) Description Return fixed mapping matrix with given index if inelastic data component is allocated","tags":"","url":"interface/getfixedw~2.html"},{"title":"getFixedEmissionVector – ReMKiT1D","text":"interface private pure module function getFixedEmissionVector(this, ind) result(emit) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value real(kind=rk),allocatable,dimension(:) Description Return fixed emission vector for mapping matrix with given index if inelastic data component is allocated","tags":"","url":"interface/getfixedemissionvector~2.html"},{"title":"getInterpolatedEmissionVector – ReMKiT1D","text":"interface private pure module function getInterpolatedEmissionVector(this, E) result(emit) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this real(kind=rk), intent(in) :: E Return Value real(kind=rk),allocatable,dimension(:) Description Return interpolated emission vector for given input energy E if inelastic data component is allocated","tags":"","url":"interface/getinterpolatedemissionvector~2.html"},{"title":"getTransitionIngoingStates – ReMKiT1D","text":"interface private pure module function getTransitionIngoingStates(this, ind) result(inStates) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value integer(kind=ik),allocatable,dimension(:) Description Get ingoing states of transition with given index","tags":"","url":"interface/gettransitioningoingstates.html"},{"title":"getTransitionOutgoingStates – ReMKiT1D","text":"interface private pure module function getTransitionOutgoingStates(this, ind) result(outStates) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value integer(kind=ik),allocatable,dimension(:) Description Get outgoing states of transition with given index","tags":"","url":"interface/gettransitionoutgoingstates.html"},{"title":"getTransitionRate – ReMKiT1D","text":"interface private pure module function getTransitionRate(this, ind) result(rate) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value real(kind=rk),allocatable,dimension(:) Description Get transition rate from transition with given index","tags":"","url":"interface/gettransitionrate.html"},{"title":"getTransitionRateMomentum – ReMKiT1D","text":"interface private pure module function getTransitionRateMomentum(this, ind) result(rate) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value real(kind=rk),allocatable,dimension(:) Description Get momentum transfer rate from transition with given index","tags":"","url":"interface/gettransitionratemomentum.html"},{"title":"getTransitionRateEnergy – ReMKiT1D","text":"interface private pure module function getTransitionRateEnergy(this, ind) result(rate) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value real(kind=rk),allocatable,dimension(:) Description Get energy transfer rate from transition with given index","tags":"","url":"interface/gettransitionrateenergy.html"},{"title":"getTransitionCrossSection – ReMKiT1D","text":"interface private pure module function getTransitionCrossSection(this, col, ind) result(crossSection) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in) :: col integer(kind=ik), intent(in) :: ind Return Value real(kind=rk),allocatable,dimension(:) Description Get cross-section values from column col of the cross-section data of transition with given index","tags":"","url":"interface/gettransitioncrosssection.html"},{"title":"getTransitionEnergy – ReMKiT1D","text":"interface private pure module function getTransitionEnergy(this, ind) result(energy) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value real(kind=rk),allocatable,dimension(:) Description Get transition energy of transition with given index","tags":"","url":"interface/gettransitionenergy.html"},{"title":"getNumTransitions – ReMKiT1D","text":"interface private pure module function getNumTransitions(this) result(numTrans) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this Return Value integer(kind=ik) Description Get number of transitions registered in this object","tags":"","url":"interface/getnumtransitions.html"},{"title":"ratesIncludeElDensity – ReMKiT1D","text":"interface private pure module function ratesIncludeElDensity(this, ind) result(includesElDens) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in) :: ind Return Value logical Description Check whether given transition includes electron density in the rate by default","tags":"","url":"interface/ratesincludeeldensity.html"},{"title":"getPopulationChangeMatrix – ReMKiT1D","text":"interface private pure module function getPopulationChangeMatrix(this, ids, transitionIndices) result(popChangeMat) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in), dimension(:) :: ids integer(kind=ik), intent(in), dimension(:) :: transitionIndices Return Value integer(kind=ik),dimension(:,:),allocatable Description For a given set of species indices and transition indices returns a matrix whose entries are the change in particle number\nof a given species (by index) in transition processes determined by passed indices. Will not provide warnings if any\nparticular ID is not found in any transition.","tags":"","url":"interface/getpopulationchangematrix.html"},{"title":"getRequiredDensityData – ReMKiT1D","text":"interface private pure module function getRequiredDensityData(this, transitionIndex, removeLastState) result(densDataMat) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this integer(kind=ik), intent(in) :: transitionIndex logical(kind=ik), intent(in), optional :: removeLastState Return Value integer(kind=ik),dimension(:,:),allocatable Description For a given transition index returns ingoingState data as a (:,2) matrix, where the first column is the list of participating\nstates and the second column the number of times that state appears. If an ID is zero (electrons) and the transition\nincludes electron density in the rate, the second column value is reduced by one. If removeLastState is true, the corresponding\nnumber in the second column of the result is reduced by one (useful in implicit terms). \nIf any value in the second column drops to 0, the corresponding row will be removed. \nThe result can then be used to determine density variables and their powers required to convert the transitions rate values into a source.","tags":"","url":"interface/getrequireddensitydata.html"},{"title":"getDataDimCRM – ReMKiT1D","text":"interface private module function getDataDimCRM(this, name) result(dim) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this character(len=*), intent(in) :: name Name of data Return Value integer(kind=ik) Description Get data dimensionality - currently always returns 1, assuming that the name is associated with a rate","tags":"","url":"interface/getdatadimcrm.html"},{"title":"getElState – ReMKiT1D","text":"interface private pure module function getElState(this) result(ID) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this Return Value integer(kind=ik) Description Getter for electronStateID","tags":"","url":"interface/getelstate.html"},{"title":"initCRMData – ReMKiT1D","text":"interface private pure module subroutine initCRMData(this, numTransitions) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(inout) :: this integer(kind=ik), intent(in) :: numTransitions Expected number of transitions Description Collisional-radiative modelbound data initialization","tags":"","url":"interface/initcrmdata.html"},{"title":"addTransition – ReMKiT1D","text":"interface private pure module subroutine addTransition(this, tr) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(inout) :: this class( Transition ), intent(in) :: tr Description Add transition to CRM modelbound data","tags":"","url":"interface/addtransition.html"},{"title":"setInelData – ReMKiT1D","text":"interface private pure module subroutine setInelData(this, inelData) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(inout) :: this type( InelasticGridData ), intent(in) :: inelData Description Setter for inelData","tags":"","url":"interface/setineldata.html"},{"title":"interpolateW – ReMKiT1D","text":"interface private pure module subroutine interpolateW(this, E, wRes) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this real(kind=rk), intent(in) :: E Transition energy to interpolate for type( SparseRowData ), intent(inout) :: wRes Lower/upper triangular matrix to store the interpolated weights Description Interpolate mapping matrices for given energy and store in passed triangular matrix if inelastic data component is allocated. \nAssumes upper triangular structure for wRes if E is positive and lower if it's negative.","tags":"","url":"interface/interpolatew~2.html"},{"title":"updateCRMData – ReMKiT1D","text":"interface private module subroutine updateCRMData(this, hostModel, inputVars, updatePriority) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(inout) :: this class( ModelSurrogate ), intent(in) :: hostModel Host model passed to transitions class( VariableContainer ), intent(in) :: inputVars Variable container used to calculate modelbound data integer(kind=ik), intent(in), optional :: updatePriority Priority for this update call Description Update modelbound data based on input variable container","tags":"","url":"interface/updatecrmdata.html"},{"title":"crmCopy – ReMKiT1D","text":"interface private module subroutine crmCopy(this, name, container) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(in) :: this character(len=*), intent(in) :: name real(kind=rk), intent(inout), allocatable, dimension(..) :: container Description Retrieves data based on name format - assumes name of format \"rate\"//dataSpec//\"index\"//transIndex, where dataSpec is 0,1,2\nand corresponds to rate type (0-particles,1-momentum,2-energy), and transIndex is the transition index in the data","tags":"","url":"interface/crmcopy.html"},{"title":"setElState – ReMKiT1D","text":"interface private module subroutine setElState(this, ID) Implementation → Arguments Type Intent Optional Attributes Name class( ModelboundCRMData ), intent(inout) :: this integer(kind=ik), intent(in) :: ID Description Setter for electronStateID","tags":"","url":"interface/setelstate.html"},{"title":"initVarListFromJSON – ReMKiT1D","text":"interface public module subroutine initVarListFromJSON(varList, jsonCont, mpiCont, isDerivedList) Implementation → Arguments Type Intent Optional Attributes Name type( VariableList ), intent(inout) :: varList type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController logical, intent(in), optional :: isDerivedList Description Initialize variable list based on variable data from a JSON file. If isDerivedList = .true. the list is initialized\nbased on derived list data, otherwise it uses the implicit list.","tags":"","url":"interface/initvarlistfromjson.html"},{"title":"initGridFromJSON – ReMKiT1D","text":"interface public module subroutine initGridFromJSON(gridObj, jsonCont, mpiCont, lengthNorm) Implementation → Arguments Type Intent Optional Attributes Name type( Grid ), intent(inout) :: gridObj type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController real(kind=rk), intent(in), optional :: lengthNorm Length normalization if the supplied grid is in meters, defaults to 1 Description Initialize grid object based on data from a JSON file.","tags":"","url":"interface/initgridfromjson.html"},{"title":"initPartFromJSON – ReMKiT1D","text":"interface public module subroutine initPartFromJSON(partObj, gridObj, jsonCont, mpiCont) Implementation → Arguments Type Intent Optional Attributes Name type( Partition ), intent(inout) :: partObj type( Grid ), intent(in) :: gridObj Grid object used to get numX and numH type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController Description Initialize simple partition object based on data from a JSON file and grid object","tags":"","url":"interface/initpartfromjson.html"},{"title":"initGeometryFromJSON – ReMKiT1D","text":"interface public module subroutine initGeometryFromJSON(geometryObj, gridObj, jsonCont, mpiCont) Implementation → Arguments Type Intent Optional Attributes Name type( Geometry ), intent(inout) :: geometryObj type( Grid ), intent(in) :: gridObj Grid object used to infer cell widths for consistency type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController Description Initialize geometry object based on data from a JSON file and grid object","tags":"","url":"interface/initgeometryfromjson.html"},{"title":"initPETScContFromJSON – ReMKiT1D","text":"interface public module subroutine initPETScContFromJSON(petscCont, indexingObj, jsonCont, mpiCont) Implementation → Arguments Type Intent Optional Attributes Name type( PETScController ), intent(inout) :: petscCont type( Indexing ), intent(in) :: indexingObj type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController and to initialize PETSc Description Initialize PETSc controller object based on data from a JSON file and indexing object","tags":"","url":"interface/initpetsccontfromjson.html"},{"title":"initHDF5ContFromJSON – ReMKiT1D","text":"interface public module subroutine initHDF5ContFromJSON(hdf5Cont, varCont, jsonCont, mpiCont) Implementation → Arguments Type Intent Optional Attributes Name type( HDF5Controller ), intent(inout) :: hdf5Cont type( VariableContainer ), intent(in) :: varCont type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController and to initialize HDF5 Description Initialize HDF5 controller object based on data from a JSON file and variable container object","tags":"","url":"interface/inithdf5contfromjson.html"},{"title":"initVarContFromJSON – ReMKiT1D","text":"interface public module subroutine initVarContFromJSON(varCont, indexingObj, partObj, textbookObj, jsonCont, mpiCont) Implementation → Arguments Type Intent Optional Attributes Name type( VariableContainer ), intent(inout) :: varCont type( Indexing ), intent(in) :: indexingObj Indexing object used in variable container initialization type( Partition ), intent(in) :: partObj Partition object used in variable container initialization type( Textbook ), intent(in) :: textbookObj Textbook object used to retrieve derivation rules for variable container type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController Description Initialize variable container based on variable data from a JSON file.","tags":"","url":"interface/initvarcontfromjson.html"},{"title":"initStandardIntegrator – ReMKiT1D","text":"interface public module subroutine initStandardIntegrator(integratorObj, varCont, indexingObj, jsonCont, mpiCont) Implementation → Arguments Type Intent Optional Attributes Name type( CompositeIntegrator ), intent(inout) :: integratorObj type( VariableContainer ), intent(in) :: varCont type( Indexing ), intent(in) :: indexingObj Indexing object used in BDE integrator initialization type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController Description Initialize standard integrator based on data from a JSON file. The standard integrator is a composit integrator containing\neither RK or BDE integrators.","tags":"","url":"interface/initstandardintegrator.html"},{"title":"initStandardTextbook – ReMKiT1D","text":"interface public module subroutine initStandardTextbook(textbookObj, gridObj, geometryObj, partObj, vSpaceObj, normObj, speciesListObj, varList, jsonCont, mpiCont) Implementation → Arguments Type Intent Optional Attributes Name type( Textbook ), intent(inout) :: textbookObj type( Grid ), intent(in) :: gridObj type( Geometry ), intent(in) :: geometryObj type( Partition ), intent(in) :: partObj type( VSpace ), intent(in) :: vSpaceObj class( Normalization ), intent(in) :: normObj type( SpeciesList ), intent(in) :: speciesListObj type( VariableList ), intent(in) :: varList type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController Description Assumes that the velocity grid is normalized to electron thermal speed.\nThe textbook includes (passed variables are in appearance order unless otherwise specified): \"flowSpeedFromFlux\" = flux/density (normalized to n_0 * u_0)\n\"sonicSpeed\" for each ion species  (negative IDs) = sqrt((poly_e * T_e + poly_i * T_i)/m_i) where i is the index of the ion species (normalized to u_0)\n\"tempFromEnergy\" for each species specified in config file as requiring temperature derivation = 2/3 * energy/density - mass * flux 2/(3*density 2)\n\"leftElectronGamma\" = sheath heat transmission coeffiecient for electrons at the left boundary using T_e and T_i\n\"rightElectronGamma\" = sheath heat transmission coefficient for electrons at the right boundary using T_e and T_i\n\"densityMoment\" = zeroth moment of f_0\n\"energyMoment\" = second order of f_0\n\"cclDragCoeff\" = Chang-Cooper-Langdon drag coefficient - assumes passed variable is the single harmonic f_0\n\"cclDiffusionCoeff\" = Chang-Cooper-Langdon diffusion coefficient - assumes passed variables are the single harmonic f_0 and cclWeight\n\"cclWeight\" = Chang-Cooper-Langdon interpolation weight - assumes passed variables are the single harmonic cclDragCoeff and cclDiffusionCoeff\nif l=1 is resolved:\n\"fluxMoment\" = first moment of f_1/3 (normalized to n_0 u_0)\n\"heatFluxMoment\" = third moment of f_1/3 (normalized to m_e * n_0 * v_th 3 / 2)\nif l=2 is resolved:\n\"viscosityTensorxxMoment\" = second moment of 2 f_2/15 (normalized to n_0 * e * T_0)\nInterpolation for staggered grids: \"gridToDual\" = interpolates one variable from regular to staggered(dual) grid\n\"dualToGrid\" = interpolates one variable from staggered(dual) to regular grid\n\"distributionInterp\" = interpolates one distribution function (even harmonics to dual, odd to regular grid)\nOther useful derivations:\n\"gradDeriv\" = calculates gradient of variable on regular grid, interpolating on cell faces and extrapolating at boundaries\n\"logLei\" = calculates electron-ion Coulomb log taking in electron temperature and density (derivations added for each ion species)\n\"logLee\" = calculates electron self collision Coulomb log taking in electron temperature and density \n\"logLii\" = calculates ion-ion collision frequency for each ion collision combination taking in the two species temperatures and \n           densities (used as\"logLiis_S\" where s and S are the first and second ion species name) \n\"maxwellianDistribution\" = calculates distribution function with Maxwellian l=0 harmonic and all other harmonics 0. Takes in temperature and density\nAlso automatically includes all defined custom derivations","tags":"","url":"interface/initstandardtextbook.html"},{"title":"initStandardSignals – ReMKiT1D","text":"interface public module subroutine initStandardSignals(signalCollectionObj) Implementation → Arguments Type Intent Optional Attributes Name type( SignalCollection ), intent(inout) :: signalCollectionObj Description Initialize signal collection with commonly used signals and their names. The signals are:\n1. constant signal\n2. hat signal\n3. cut sine signal","tags":"","url":"interface/initstandardsignals.html"},{"title":"setDistHarmonic – ReMKiT1D","text":"interface public module subroutine setDistHarmonic(dist, h, xArr, vArr) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(inout), dimension(:) :: dist integer(kind=ik), intent(in) :: h real(kind=rk), intent(in), dimension(:) :: xArr real(kind=rk), intent(in), dimension(..) :: vArr Description Set the h-th harmonic of distribution function variable dist to xArr*vArr at corresponding x, and v coordinates. \nvArr should be either rank 1 or 2, and if it is rank 2 it should be size(numV,size(xArr))","tags":"","url":"interface/setdistharmonic.html"},{"title":"initEnvironmentFromJSON – ReMKiT1D","text":"interface private module subroutine initEnvironmentFromJSON(this, textbookObj, normObj) Implementation → Arguments Type Intent Optional Attributes Name class( EnvironmentWrapper ), intent(inout) :: this type( Textbook ), intent(in), optional :: textbookObj Textbook object used to retrieve derivation rules for variable container class( Normalization ), intent(in), optional :: normObj Normalization object used to retrieve grid normalization. If not present grid is assumed normalized Description Initialize environment using data from config.json and textbook object for initializing external variables. Also initializes\nthe status_printing module. If the textbook is not supplied the envirnment is not considered defined and finishInit must be \ncalled before the environment is passed around.","tags":"","url":"interface/initenvironmentfromjson.html"},{"title":"finishInit – ReMKiT1D","text":"interface private module subroutine finishInit(this, textbookObj) Implementation → Arguments Type Intent Optional Attributes Name class( EnvironmentWrapper ), intent(inout) :: this type( Textbook ), intent(in) :: textbookObj Textbook object used to retrieve derivation rules for variable container Description Finalize the initialization of the environment by setting the textbook object and performing initializations that require it","tags":"","url":"interface/finishinit.html"},{"title":"finalizeEnv – ReMKiT1D","text":"interface private elemental module subroutine finalizeEnv(this) Implementation → Arguments Type Intent Optional Attributes Name type( EnvironmentWrapper ), intent(inout) :: this","tags":"","url":"interface/finalizeenv.html"},{"title":"assertSingle – ReMKiT1D","text":"public module subroutine assertSingle(assertion, error) Checks whether assertion is .false. and stops the program excecution with error text Arguments Type Intent Optional Attributes Name logical, intent(in) :: assertion character(len=*), intent(in), optional :: error","tags":"","url":"proc/assertsingle.html"},{"title":"assertVector – ReMKiT1D","text":"public module subroutine assertVector(assertion, error) Checks whether any assertion is .false. and stops the program excecution with error text Arguments Type Intent Optional Attributes Name logical, intent(in), dimension(:) :: assertion character(len=*), intent(in), optional :: error","tags":"","url":"proc/assertvector.html"},{"title":"assertIdentical – ReMKiT1D","text":"public module subroutine assertIdentical(integers, error) Checks all integers are identical and if not stops the program excecution with error text Arguments Type Intent Optional Attributes Name integer, intent(in), dimension(:) :: integers character(len=*), intent(in), optional :: error","tags":"","url":"proc/assertidentical.html"},{"title":"assertPureVector – ReMKiT1D","text":"public pure module subroutine assertPureVector(assertion, error) Pure version of assertVector routine, does not write separately to std out Arguments Type Intent Optional Attributes Name logical, intent(in), dimension(:) :: assertion character(len=*), intent(in), optional :: error","tags":"","url":"proc/assertpurevector.html"},{"title":"assertPureSingle – ReMKiT1D","text":"public pure module subroutine assertPureSingle(assertion, error) Pure version of assertSingle routine, does not write separately to std out Arguments Type Intent Optional Attributes Name logical, intent(in) :: assertion character(len=*), intent(in), optional :: error","tags":"","url":"proc/assertpuresingle.html"},{"title":"assert – ReMKiT1D","text":"public interface assert Subroutines public module subroutine assertSingle(assertion, error) Implementation → Arguments Type Intent Optional Attributes Name logical, intent(in) :: assertion character(len=*), intent(in), optional :: error public module subroutine assertVector(assertion, error) Implementation → Arguments Type Intent Optional Attributes Name logical, intent(in), dimension(:) :: assertion character(len=*), intent(in), optional :: error","tags":"","url":"interface/assert.html"},{"title":"assertPure – ReMKiT1D","text":"public interface assertPure Subroutines public pure module subroutine assertPureSingle(assertion, error) Implementation → Arguments Type Intent Optional Attributes Name logical, intent(in) :: assertion character(len=*), intent(in), optional :: error public pure module subroutine assertPureVector(assertion, error) Implementation → Arguments Type Intent Optional Attributes Name logical, intent(in), dimension(:) :: assertion character(len=*), intent(in), optional :: error","tags":"","url":"interface/assertpure.html"},{"title":"findIndices – ReMKiT1D","text":"public interface findIndices Functions public pure module function findIndicesMatrix(mask) result(indices) Implementation → Find locations of .true. values in logical mask of rank 2 Arguments Type Intent Optional Attributes Name logical, intent(in), dimension(:,:) :: mask Return Value integer(kind=ik), dimension(:,:), allocatable public pure module function findIndicesVector(mask) result(indices) Implementation → Find locations of .true. values in logical mask of rank 1 Arguments Type Intent Optional Attributes Name logical, intent(in), dimension(:) :: mask Return Value integer(kind=ik), dimension(:), allocatable","tags":"","url":"interface/findindices.html"},{"title":"removeName – ReMKiT1D","text":"public interface removeName Functions public pure elemental module function removeNameIntArray(input) result(output) Implementation → Remove name from named integer array and return IntArray Arguments Type Intent Optional Attributes Name type( NamedIntegerArray ), intent(in) :: input Return Value type( IntArray ) public pure elemental module function removeNameRealArray(input) result(output) Implementation → Remove name from named real array and return RealArray Arguments Type Intent Optional Attributes Name type( NamedRealArray ), intent(in) :: input Return Value type( RealArray ) public pure elemental module function removeNameLogicalArray(input) result(output) Implementation → Remove name from named logical array and return LogicalArray Arguments Type Intent Optional Attributes Name type( NamedLogicalArray ), intent(in) :: input Return Value type( LogicalArray )","tags":"","url":"interface/removename.html"},{"title":"allCombinations – ReMKiT1D","text":"interface public pure module function allCombinations(array) result(res) Implementation → Arguments Type Intent Optional Attributes Name type( IntArray ), intent(in), dimension(:) :: array Return Value integer(kind=ik),dimension(:,:),allocatable Description Convert IntArray(:) vector into a 2D array of shape (size(IntArray),:) containing all possible combination of IntArray(:)%entries.\nWorks only for sizes 1 and 3","tags":"","url":"interface/allcombinations.html"},{"title":"findNearestPointsInArray – ReMKiT1D","text":"interface public pure module function findNearestPointsInArray(array, point) result(pair) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: array real(kind=rk), intent(in) :: point Return Value integer(kind=ik),dimension(2) Description Finds indices of two of the values nearest to a point in a monotonic array","tags":"","url":"interface/findnearestpointsinarray.html"},{"title":"expInt1 – ReMKiT1D","text":"interface public elemental module function expInt1(val) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in) :: val Return Value real(kind=rk) Description Allan and Hastings approximation of E1 exponential integral, with coefficients from routine in:\nShanjie Zhang, Jianming Jin,\nComputation of Special Functions,\nWiley, 1996,\nISBN: 0-471-11963-6,\nLC: QA351.C45.","tags":"","url":"interface/expint1.html"},{"title":"removeDupeInts – ReMKiT1D","text":"interface public pure module function removeDupeInts(array) result(uniques) Implementation → Arguments Type Intent Optional Attributes Name integer(kind=ik), intent(in), dimension(:) :: array Return Value integer(kind=ik),allocatable,dimension(:) Description Removes duplicates from integer array - unoptimized","tags":"","url":"interface/removedupeints.html"},{"title":"withinBounds – ReMKiT1D","text":"interface public pure module function withinBounds(array, lowerBound, upperBound) result(res) Implementation → Arguments Type Intent Optional Attributes Name integer(kind=ik), intent(in), dimension(:) :: array integer(kind=ik), intent(in) :: lowerBound integer(kind=ik), intent(in) :: upperBound Return Value logical,allocatable,dimension(:) Description Returns map array >= lowerBound .and. array <= upperBound","tags":"","url":"interface/withinbounds.html"},{"title":"flatTensorProduct – ReMKiT1D","text":"interface public pure module function flatTensorProduct(array1, array2, array3) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: array1 real(kind=rk), intent(in), dimension(:) :: array2 real(kind=rk), intent(in), dimension(:) :: array3 Return Value real(kind=rk),dimension(:),allocatable Description Takes a 3-fold tensor product of rank-1 real arrays and flattens it","tags":"","url":"interface/flattensorproduct.html"},{"title":"jaggedArray – ReMKiT1D","text":"interface public pure module function jaggedArray(array, mask) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:,:) :: array logical, intent(in), optional, dimension(:,:) :: mask Return Value type( RealArray ),dimension(:),allocatable Description Takes rank-2 array and optional mask and produces rank-1 array of realArrays - a jagged array - by masking the first dimension","tags":"","url":"interface/jaggedarray.html"},{"title":"allPl – ReMKiT1D","text":"interface public pure module function allPl(points, maxL) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: points integer(kind=ik), intent(in) :: maxL Return Value real(kind=rk),allocatable,dimension(:,:) Description Return rank-2 array of Legendre polynomials evaluated at given points. Result shape is (size(points),0:maxL). Uses recursion\nformula.","tags":"","url":"interface/allpl.html"},{"title":"shiftedFlatTensorProduct – ReMKiT1D","text":"interface public pure module function shiftedFlatTensorProduct(array1, array2, shiftArray, power) result(res) Implementation → Arguments Type Intent Optional Attributes Name real(kind=rk), intent(in), dimension(:) :: array1 real(kind=rk), intent(in), dimension(:) :: array2 real(kind=rk), intent(in), optional, dimension(:) :: shiftArray real(kind=rk), intent(in), optional :: power Return Value real(kind=rk),dimension(:),allocatable Description Takes 2 arrays and produces a flattened tensor product, such that array1's dimension is the inner dimension. If present,\nshift array should conform to array2 and will be added to array1 as the product is taken\nThe shifted array1 is then optionally raised to a power.","tags":"","url":"interface/shiftedflattensorproduct.html"},{"title":"triangularIntArray – ReMKiT1D","text":"interface public pure module function triangularIntArray(dim, lower) result(res) Implementation → Arguments Type Intent Optional Attributes Name integer(kind=ik), intent(in) :: dim logical, intent(in), optional :: lower Return Value type( IntArray ),dimension(:),allocatable Description Returns upper or lower triangular pattern as IntArrays with dimension dim","tags":"","url":"interface/triangularintarray.html"},{"title":"calculateWrapper1I1 – ReMKiT1D","text":"interface private module function calculateWrapper1I1(this, inputArray, indices) result(output) Implementation → Arguments Type Intent Optional Attributes Name class( FunWrapperDerivation1I1 ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk),allocatable,dimension(:)","tags":"","url":"interface/calculatewrapper1i1.html"},{"title":"initWrapper1I1 – ReMKiT1D","text":"interface private module subroutine initWrapper1I1(this, fun, param, multConst, multConstInner) Implementation → Arguments Type Intent Optional Attributes Name class( FunWrapperDerivation1I1 ), intent(inout) :: this procedure( realArrayFunctionIntParam ) :: fun integer(kind=ik), intent(in) :: param real(kind=rk), intent(in), optional :: multConst real(kind=rk), intent(in), optional :: multConstInner Description Initialize 1I1 function wrapper derivation","tags":"","url":"interface/initwrapper1i1.html"},{"title":"finalizeWrapper1I1 – ReMKiT1D","text":"interface private elemental module subroutine finalizeWrapper1I1(this) Implementation → Arguments Type Intent Optional Attributes Name type( FunWrapperDerivation1I1 ), intent(inout) :: this Description Deallocate pointer component","tags":"","url":"interface/finalizewrapper1i1.html"},{"title":"calculateContracDeriv – ReMKiT1D","text":"interface private module function calculateContracDeriv(this, inputArray, indices) result(output) Implementation → Arguments Type Intent Optional Attributes Name class( VelContracDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk),allocatable,dimension(:)","tags":"","url":"interface/calculatecontracderiv.html"},{"title":"initContracDeriv – ReMKiT1D","text":"interface private module subroutine initContracDeriv(this, h, g, refVSpace, expH) Implementation → Arguments Type Intent Optional Attributes Name class( VelContracDerivation ), intent(inout) :: this integer(kind=ik), intent(in) :: h Harmonic to contract with real(kind=rk), intent(in), dimension(:) :: g Velocity space vector type( VSpace ), intent(in) :: refVSpace Reference velocity space integer(kind=ik), intent(in), optional :: expH Expected number of harmonics (defaults to total number of harmonics) Description Initialize velocity contraction derivation object","tags":"","url":"interface/initcontracderiv.html"},{"title":"noUpdate – ReMKiT1D","text":"interface private module subroutine noUpdate(this, varCont) Implementation → Arguments Type Intent Optional Attributes Name class( Operator ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont Description Default operator update function - does nothing","tags":"","url":"interface/noupdate~3.html"},{"title":"initScalingLBCGen – ReMKiT1D","text":"interface private module subroutine initScalingLBCGen(this, vspaceObj, isActive, fDeriv, fDerivReqIndices, colL, dx, includedDecompHarmonics) Implementation → Arguments Type Intent Optional Attributes Name class( ScalingLBCStencilGen ), intent(inout) :: this type( VSpace ), intent(in) :: vspaceObj VSpace object used to get grid data logical, intent(in) :: isActive Set to true if the process containing this has a boundary where this is to be applied type( FScalingDerivation ), intent(in) :: fDeriv Derivation used to get scaling factors integer(kind=ik), intent(in), dimension(:) :: fDerivReqIndices Indices required for scaling extrapolation derivation integer(kind=ik), intent(in) :: colL Column l harmonic real(kind=rk), intent(in) :: dx Boundary cell width integer(kind=ik), intent(in), optional, dimension(:) :: includedDecompHarmonics Harmonics to be included in the decomposition for this generator (useful for right boundary on staggered grid). Defaults to all harmonics. Description Scaling logical boundary condition value generator initialization routine","tags":"","url":"interface/initscalinglbcgen.html"},{"title":"calcScalingLBCVals – ReMKiT1D","text":"interface private module subroutine calcScalingLBCVals(this, varCont, res, mbData, hostModel) Implementation → Arguments Type Intent Optional Attributes Name class( ScalingLBCStencilGen ), intent(inout) :: this type( VariableContainer ), intent(in) :: varCont type( RealArray ), intent(inout), allocatable, dimension(:) :: res class( ModelboundData ), intent(in), optional :: mbData class( ModelSurrogate ), intent(in), optional :: hostModel Description Calculate scaling logical boundary condition values in place","tags":"","url":"interface/calcscalinglbcvals.html"},{"title":"getSpeciesFromID – ReMKiT1D","text":"interface private pure module function getSpeciesFromID(this, id) result(spec) Implementation → Arguments Type Intent Optional Attributes Name class( SpeciesList ), intent(in) :: this integer(kind=ik), intent(in) :: id Return Value type( Species ),allocatable Description Getter for species based on id","tags":"","url":"interface/getspeciesfromid.html"},{"title":"getSpeciesIDs – ReMKiT1D","text":"interface private pure module function getSpeciesIDs(this) result(ids) Implementation → Arguments Type Intent Optional Attributes Name class( SpeciesList ), intent(in) :: this Return Value integer(kind=ik),allocatable,dimension(:) Description Getter for speciesIDs","tags":"","url":"interface/getspeciesids.html"},{"title":"getSpeciesFromName – ReMKiT1D","text":"interface private pure module function getSpeciesFromName(this, name) result(spec) Implementation → Arguments Type Intent Optional Attributes Name class( SpeciesList ), intent(in) :: this character(len=*), intent(in) :: name Return Value type( Species ),allocatable Description Getter for species based on name","tags":"","url":"interface/getspeciesfromname.html"},{"title":"getSpeciesVarFromName – ReMKiT1D","text":"interface private pure module function getSpeciesVarFromName(this, name, ind) result(var) Implementation → Arguments Type Intent Optional Attributes Name class( SpeciesList ), intent(in) :: this character(len=*), intent(in) :: name integer(kind=ik), intent(in) :: ind Return Value character(len=:),allocatable Description Return associated var with index ind of species with given name","tags":"","url":"interface/getspeciesvarfromname.html"},{"title":"getSpeciesVarFromID – ReMKiT1D","text":"interface private pure module function getSpeciesVarFromID(this, id, ind) result(var) Implementation → Arguments Type Intent Optional Attributes Name class( SpeciesList ), intent(in) :: this integer(kind=ik), intent(in) :: id integer(kind=ik), intent(in) :: ind Return Value character(len=:),allocatable Description Return associated var with index ind of species with given id","tags":"","url":"interface/getspeciesvarfromid.html"},{"title":"initSpeciesList – ReMKiT1D","text":"interface private module subroutine initSpeciesList(this, jsonCont, mpiCont) Implementation → Arguments Type Intent Optional Attributes Name class( SpeciesList ), intent(inout) :: this type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController Description SpeciesList initialization from config.json.","tags":"","url":"interface/initspecieslist.html"},{"title":"initEvaluator – ReMKiT1D","text":"interface private pure module subroutine initEvaluator(this, resultVarIndex, modelIndex, termGroup) Implementation → Arguments Type Intent Optional Attributes Name class( GroupEvaluator ), intent(inout) :: this integer(kind=ik), intent(in) :: resultVarIndex Index of variable to write the result in integer(kind=ik), intent(in) :: modelIndex Index of model whose term group should be evaluated integer(kind=ik), intent(in) :: termGroup Term group to evaluate in model Description GroupEvaluator initialization routine","tags":"","url":"interface/initevaluator~2.html"},{"title":"evaluate – ReMKiT1D","text":"interface private module subroutine evaluate(this, manipulatedModeller, outputVars, inputVars) Implementation → Arguments Type Intent Optional Attributes Name class( GroupEvaluator ), intent(inout) :: this class( ModellerSurrogate ), intent(inout) :: manipulatedModeller Modeller to be used in callbacks during manipulation class( VariableContainer ), intent(inout) :: outputVars VariableContainer object to store the manipulation output class( VariableContainer ), intent(in) :: inputVars VariableContainer object housing input data for the manipulation routine Description Implementation of abstract manipulate routine for the evaluator","tags":"","url":"interface/evaluate~2.html"},{"title":"calculateMaxwellian – ReMKiT1D","text":"interface private module function calculateMaxwellian(this, inputArray, indices) result(output) Implementation → Arguments Type Intent Optional Attributes Name class( MaxwellianDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk),allocatable,dimension(:)","tags":"","url":"interface/calculatemaxwellian.html"},{"title":"initMaxwellianDeriv – ReMKiT1D","text":"interface private module subroutine initMaxwellianDeriv(this, vSpaceObj) Implementation → Arguments Type Intent Optional Attributes Name class( MaxwellianDerivation ), intent(inout) :: this type( VSpace ), intent(in) :: vSpaceObj Description Initialize Maxwellian derivation","tags":"","url":"interface/initmaxwellianderiv.html"},{"title":"calculateCutSine – ReMKiT1D","text":"interface private module function calculateCutSine(this, time, period, params) result(res) Implementation → Arguments Type Intent Optional Attributes Name class( CutSineSignal ), intent(inout) :: this real(kind=rk), intent(in) :: time real(kind=rk), intent(in) :: period real(kind=rk), intent(in), optional, dimension(:) :: params Return Value real(kind=rk)","tags":"","url":"interface/calculatecutsine.html"},{"title":"evaluateTimestepSimple – ReMKiT1D","text":"interface private module function evaluateTimestepSimple(this, inputVars, currentTimestep) result(timestep) Implementation → Arguments Type Intent Optional Attributes Name class( SimpleTimestepController ), intent(inout) :: this class( VariableContainer ), intent(in) :: inputVars Variable container used to calculate timestep real(kind=rk), intent(in) :: currentTimestep Current timestep to be used if the controller rescales timesteps Return Value real(kind=rk) Description Calculate timestep as min(max) of variable product","tags":"","url":"interface/evaluatetimestepsimple.html"},{"title":"initSimpleTimestepController – ReMKiT1D","text":"interface private module subroutine initSimpleTimestepController(this, mpiCont, varCont, reqVars, reqVarPowers, multConst, useMaxVal, rescaleTimestep) Implementation → Arguments Type Intent Optional Attributes Name class( SimpleTimestepController ), intent(inout) :: this type( MPIController ), intent(in) :: mpiCont Reference MPI controller type( VariableContainer ), intent(in) :: varCont Reference variable container type( StringArray ), intent(in), dimension(:) :: reqVars Required variable list real(kind=rk), intent(in), dimension(:) :: reqVarPowers Powers corresponding to required variables real(kind=rk), intent(in), optional :: multConst Normalization constant logical, intent(in), optional :: useMaxVal True if max value of product is used instead of min logical, intent(in), optional :: rescaleTimestep True if currentTimestep is rescaled using the calculated timestep value Description Simple timestep controller initialization routine","tags":"","url":"interface/initsimpletimestepcontroller.html"},{"title":"isDefinedObject – ReMKiT1D","te