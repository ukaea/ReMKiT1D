ved harmonic on grid","tags":"","url":"interface/getnumh~2.html"},{"title":"getNumX – ReMKiT1D","text":"interface private pure module function getNumX(this) result(numX) Implementation → Arguments Type Intent Optional Attributes Name class( Grid ), intent(in) :: this Return Value integer(kind=ik) Description Return number of x points on grid","tags":"","url":"interface/getnumx~2.html"},{"title":"getNumV – ReMKiT1D","text":"interface private pure module function getNumV(this) result(numV) Implementation → Arguments Type Intent Optional Attributes Name class( Grid ), intent(in) :: this Return Value integer(kind=ik) Description Return number of v points on grid","tags":"","url":"interface/getnumv~2.html"},{"title":"getLGrid – ReMKiT1D","text":"interface private pure module function getLGrid(this) result(l) Implementation → Arguments Type Intent Optional Attributes Name class( Grid ), intent(in) :: this Return Value integer(kind=ik),allocatable,dimension(:) Description Getter for lGrid","tags":"","url":"interface/getlgrid.html"},{"title":"getMGrid – ReMKiT1D","text":"interface private pure module function getMGrid(this) result(m) Implementation → Arguments Type Intent Optional Attributes Name class( Grid ), intent(in) :: this Return Value integer(kind=ik),allocatable,dimension(:) Description Getter for mGrid","tags":"","url":"interface/getmgrid.html"},{"title":"getHarmonicIm – ReMKiT1D","text":"interface private pure module function getHarmonicIm(this) result(im) Implementation → Arguments Type Intent Optional Attributes Name class( Grid ), intent(in) :: this Return Value logical,allocatable,dimension(:) Description Getter for imaginaryHarmonic","tags":"","url":"interface/getharmonicim.html"},{"title":"getH – ReMKiT1D","text":"interface private pure module function getH(this, l, m, im) result(h) Implementation → Arguments Type Intent Optional Attributes Name class( Grid ), intent(in) :: this integer(kind=ik), intent(in) :: l integer(kind=ik), intent(in) :: m logical, in