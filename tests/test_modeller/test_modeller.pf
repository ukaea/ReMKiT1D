module test_modeller

    use pfunit
    use god_objects       ,only: object
    use data_kinds        ,only: ik, rk
    use partition_class
    use grid_class
    use variable_list_class
    use indexing_class
    use support_types 
    use variable_container_class 
    use derivation_abstract_class
    use term_abstract_class
    use test_matrix_term_class
    use matrix_term_abstract_class
    use support_functions
    use test_explicit_term_class
    use test_operator_class
    use model_class
    use mpi_controller_class
    use petsc_controller_class
    use modeller_class
    use explicit_rk_integrator_class
    use implicit_PicardBDE_integrator_class
    use composite_integrator_class
    use status_printing
    use composite_manipulator_class
    use group_evaluator_class
    use term_evaluator_class
    use cvode_integrator_class 
    use modelbound_data_abstract_class ,only: ModelboundData
    use model_surrogate_class          ,only: ModelSurrogate

    implicit none

    type ,extends(ModelboundData) ,public :: testCountingMBData
        integer(ik) :: updateCount = 0
    contains
        procedure ,public :: update => testCountingUpdate
        procedure ,public :: copyData => testCountingCopyData
        procedure ,public :: getDataDim => testCountingGetDataDim
    end type testCountingMBData

    type ,extends(MatrixTerm) ,public :: testAffineMapTerm
        real(rk) :: a1 = 0.0d0
        real(rk) :: a2 = 0.0d0
        real(rk) :: c0 = 0.0d0
        real(rk) :: xInit = 1.0d0
    contains
        procedure ,private :: calculateRows => testAffineMapRow
    end type testAffineMapTerm

contains

    @test( npes=[8])
    subroutine test_modeller_RK_int(this)

        class (MpiTestMethod), intent(inout) :: this
        type(MPIController) :: testMPIController 
        type(partition) :: testPart
        type(grid) :: testGrid
        type(variableList) :: testList ,testListDerived
        type(indexing) :: testIndexing
        type(variableContainer) :: testVarCont
        type(calculationRule) ,dimension(1) :: cRules
        class(term) ,allocatable :: genTerm
        type(testExplicitTerm) :: testTerm
        class(model) ,allocatable :: testModel
        type(testOperator) :: testOp
        type(modeller) :: testModeller
        type(explicitRKIntegrator) :: testIntegrator

        integer(ik) :: i

        call testMPIController%init(8,1)

        call testPart%initSimplePartition(8,1,24,1)
        call testGrid%init(real([(i,i=1,24)],kind=rk),real([(i,i=1,5)],kind=rk),0,0)

        call testList%init()
        call testList%addVar("n")
        call testList%addVar("u")

        call preparePrinter(testMPIController%getWorldRank())

        call testListDerived%init()
        call testListDerived%addVar("time")

        call cRules(1)%init()

        call testIndexing%init(testPart,testGrid,testList)

        call testVarCont%init(testList,testListDerived,cRules,testIndexing,testPart,1,testMPIController%getWorldRank())
        allocate(testModel)
        call testModel%init(0,1,0,1)

        testVarCont%variables(1)%entry = 1.0d0
        testVarCont%variables(2)%entry = 2.0d0
        testVarCont%variables(3)%entry = 0.0d0


        call testTerm%init("n",testVarCont)

        call testTerm%setEvolvedVar("n")
        call testOP%makeDefined()
        call testTerm%setOperator(testOp)

        allocate(genTerm,source=testTerm)

        call testModel%addGeneralTerm(genTerm,[1],"1")

        call testModeller%init(1,testVarCont,testMPIController)
        
        call testModeller%addModel(testModel)

        call testModeller%assemble()

        @assertTrue(testModeller%isAssembled())

        call testIntegrator%init(modelList=[1],termGroups=[intArray([1])],order=4,evolvesTimeVar=.true.,initialTimestep=0.1d0)
        call testIntegrator%setCommunicationNeeded(.false.)
        call testIntegrator%setUpdateRules([logicalArray([.false.])])

        @assertEqual(testModeller%getCurrentTime(),0.d0)
        call testModeller%setIntegrator(testIntegrator)
        call testModeller%integrate()

        call testModeller%copyVarValuesTo(testVarCont)

        call assertEqual(testVarCont%variables(3)%entry(1),0.1d0)
        call assertEqual(testVarCont%variables(1)%entry(1),1.2214d0)
        call assertEqual(testVarCont%variables(2)%entry(1),2.0d0)



    end subroutine test_modeller_RK_int

    @test( npes=[8])
    subroutine test_modeller_BDE_int(this)
        class (MpiTestMethod), intent(inout) :: this
        call check_modeller_BDE_int(this)
    end subroutine test_modeller_BDE_int

    @test( npes=[8])
    subroutine test_modeller_BDE_reuse(this)
        class (MpiTestMethod), intent(inout) :: this
        call check_modeller_BDE_int(this,reusePC=.true.)
    end subroutine test_modeller_BDE_reuse

    subroutine check_modeller_BDE_int(this,reusePC)
        class (MpiTestMethod), intent(inout) :: this
        logical ,optional ,intent(in) :: reusePC
        type(MPIController) :: testMPIController 
        type(partition) :: testPart
        type(grid) :: testGrid
        type(variableList) :: testList ,testListDerived
        type(indexing) :: testIndexing
        type(variableContainer) :: testVarCont
        type(calculationRule) ,dimension(3) :: cRules
        class(matrixTerm) ,allocatable :: matTerm
        type(testMatrixTerm) :: testTerm ,testTerm2 ,testTerm3
        class(model) ,allocatable :: testModel
        type(modeller) :: testModeller
        type(picardBDEIntegrator) :: testIntegrator
        type(petscController) :: testPETScController 
        type(solverOptions) :: solOptions 
        type(CompositeManipulator) :: testManipulator
        type(GroupEvaluator) :: testEvaluator
        type(TermEvaluator) :: testEvaluator2, testEvaluatorAccumulate

        integer(ik) :: i ,xOffset

        call testMPIController%init(8,1)
        call preparePrinter(testMPIController%getWorldRank())

        call testPart%initSimplePartition(8,1,24,1)
        call testGrid%init(real([(i,i=1,24)],kind=rk),real([(i,i=1,5)],kind=rk),0,0)

        call testList%init()
        call testList%addVar("n")
        call testList%addVar("u")
        call testList%addVar("n2",isStationary=.true.)

        call testListDerived%init()
        call testListDerived%addVar("time")
        call testListDerived%addVar("eval")
        call testListDerived%addVar("eval2")

        call cRules(1)%init()
        call cRules(2)%init()
        call cRules(3)%init()

        call testIndexing%init(testPart,testGrid,testList)
        solOptions%kspSolverType = "bcgs"
        solOptions%hyprePC = ""
        solOptions%petscOptions = ""
        call testPETScController%init(testIndexing,testMPIController,solOptions) 


        call testVarCont%init(testList,testListDerived,cRules,testIndexing,testPart,1,testMPIController%getWorldRank())
        allocate(testModel)
        call testModel%init(3,0,2,1)

        testVarCont%variables(1)%entry = 1.0d0
        testVarCont%variables(2)%entry = 1.0d0
        testVarCont%variables(3)%entry = 1.0d0
        testVarCont%variables(4)%entry = 0.0d0


        call testTerm%makeDefined()
        xOffset = testMPIController%getWorldRank()*3
        call testTerm%setEvolvedAndImplicitVar("n","u",testVarCont)
        call testTerm%setReqVars([stringArray("n"),stringArray("u")],[stringArray("u")],testVarCont)
        call testTerm%initRowData(reshape([(xOffset+i,i=1,3)],[1,3]),testMapping,testIndexing)

        allocate(matTerm,source=testTerm)
        call testModel%addImplicitTerm(matTerm,[2],[1],"1")

        call testTerm2%makeDefined()
        xOffset = testMPIController%getWorldRank()*3
        call testTerm2%setEvolvedAndImplicitVar("n2","u",testVarCont)
        call testTerm2%setReqVars([stringArray("n"),stringArray("u")],[stringArray("u")],testVarCont)
        call testTerm2%initRowData(reshape([(xOffset+i,i=1,3)],[1,3]),testMapping,testIndexing)

        allocate(matTerm,source=testTerm2)
        call testModel%addImplicitTerm(matTerm,[1],[1],"2")

        call testTerm3%makeDefined()
        xOffset = testMPIController%getWorldRank()*3
        call testTerm3%setEvolvedAndImplicitVar("n2","n2",testVarCont)
        call testTerm3%setReqVars([stringArray("u"),stringArray("u")],[stringArray("u")],testVarCont)
        call testTerm3%initRowData(reshape([(xOffset+i,i=1,3)],[1,3]),testMapping,testIndexing)

        allocate(matTerm,source=testTerm3)
        call testModel%addImplicitTerm(matTerm,[1],[1],"3")

        call testModeller%init(1,testVarCont,testMPIController,testPETScController)

        call testManipulator%init(3)

        call testEvaluator%init(5,1,2)
        call testEvaluator2%init(6,[1],[StringArray("1")],update=.true.)
        call testEvaluatorAccumulate%init(6,[1],[StringArray("1")],.true.)

        call testManipulator%addManipulator(testEvaluator,0)
        call testManipulator%addManipulator(testEvaluator2,0)
        call testManipulator%addManipulator(testEvaluatorAccumulate,4)

        call testModeller%setManipulator(testManipulator)
        
        call testModeller%addModel(testModel)

        call testModeller%calculateIdentityMat(testIndexing)

        call testModeller%assemble(withIdentityMat=.true.)

        @assertTrue(testModeller%isAssembled())
        
        call testModeller%callManipulator(0) 

        call testModeller%copyVarValuesTo(testVarCont)
        call assertEqual(testVarCont%variables(6)%entry(1:3),real([1,1,1],kind=rk),tolerance=1d-12)

        call testIntegrator%init(testIndexing,testMPIController%getWorldRank(),convergenceIndices=[1,3],&
        modelList=[1],termGroups=[intArray([1,2])],evolvesTimeVar=.true.,initialTimestep=0.1d0,&
        reusePreconditioner=reusePC)
        call testIntegrator%setCommunicationNeeded(.false.)
        call testIntegrator%setUpdateRules([logicalArray([.false.])])
        call testModeller%setIntegrator(testIntegrator)
        call testModeller%integrate()

        call testModeller%copyVarValuesTo(testVarCont)

        call assertEqual(testVarCont%variables(4)%entry(1),0.1d0)
        call assertEqual(testVarCont%variables(1)%entry(1),1d0/0.9d0,tolerance=1d-12)
        call assertEqual(testVarCont%variables(2)%entry(1),1.0d0)
        call assertEqual(testVarCont%variables(3)%entry(1),-1d0/0.9d0,tolerance=1d-12)
        call assertEqual(testVarCont%variables(5)%entry,testModeller%evaluateModelTermGroup(1,2,testVarCont),tolerance=1d-12)
        call assertEqual(testVarCont%variables(6)%entry,testModeller%evaluateModelTermGroup(1,2,testVarCont),tolerance=1d-12)

        call testModeller%callManipulator(4)

        call testModeller%copyVarValuesTo(testVarCont)
        call assertEqual(testVarCont%variables(6)%entry,2*testModeller%evaluateModelTermGroup(1,2,testVarCont),tolerance=1d-12)

        ! Solution-parity check across a second outer step.
        call testModeller%integrate()
        call testModeller%copyVarValuesTo(testVarCont)
        call assertEqual(testVarCont%variables(4)%entry(1),0.2d0,tolerance=1d-12)
        call assertEqual(testVarCont%variables(1)%entry(1),1d0/0.9d0**2,tolerance=1d-12)
        ! PetscFinalize is called once at the end of the final PETSc test in this binary.
    end subroutine check_modeller_BDE_int

    @test( npes=[8])
    subroutine test_modeller_BDE_anderson(this)
        class (MpiTestMethod), intent(inout) :: this
        type(MPIController) :: testMPIController
        type(partition) :: testPart
        type(grid) :: testGrid
        type(variableList) :: testList ,testListDerived
        type(indexing) :: testIndexing
        type(calculationRule) ,dimension(1) :: cRules
        type(solverOptions) :: solOptions

        integer(ik) :: i ,xOffset ,itersNoAA ,itersAA ,itersDamped
        real(rk) ,parameter :: dt = 0.05d0
        real(rk) ,dimension(3) :: nInit ,uInit ,nRef ,uRef ,nAA ,uAA ,nDamped ,uDamped

        call testMPIController%init(8,1)
        call preparePrinter(testMPIController%getWorldRank())

        call testPart%initSimplePartition(8,1,24,1)
        call testGrid%init(real([(i,i=1,24)],kind=rk),real([(i,i=1,5)],kind=rk),0,0)

        call testList%init()
        call testList%addVar("n")
        call testList%addVar("u")

        call testListDerived%init()
        call testListDerived%addVar("time")
        call cRules(1)%init()

        call testIndexing%init(testPart,testGrid,testList)
        solOptions%kspSolverType = "bcgs"
        solOptions%hyprePC = ""
        solOptions%petscOptions = ""

        xOffset = testMPIController%getWorldRank()*3
        do i = 1,3
            nInit(i) = 0.8d0 + 0.025d0*real(xOffset + i,kind=rk)
            uInit(i) = 1.15d0 - 0.015d0*real(xOffset + i,kind=rk)
        end do

        ! Coupled spatially varying nonlinear fixed-point system across 8 ranks:
        !   n - dt * n^3 * u = nInit,   u - dt * u^3 * n = uInit
        ! 1) Reference plain Picard (andersonDepth = 0)
        call runCoupledSolve(0,1.0d0,nRef,uRef,itersNoAA)

        ! 2) Anderson acceleration with small depth = 3 (exercises multi-column CGS2 QR + circular rollover)
        call runCoupledSolve(3,1.0d0,nAA,uAA,itersAA)

        ! 3) Under-relaxed Anderson acceleration (relaxationWeight = 0.7, andersonDepth = 3)
        call runCoupledSolve(3,0.7d0,nDamped,uDamped,itersDamped)

        @assertEqual(nAA,nRef,tolerance=1.0d-11)
        @assertEqual(uAA,uRef,tolerance=1.0d-11)
        @assertEqual(nDamped,nRef,tolerance=1.0d-11)
        @assertEqual(uDamped,uRef,tolerance=1.0d-11)

        ! Verify discrete BDE fixed-point residual directly
        @assertEqual(nAA - dt*(nAA**3)*uAA,nInit,tolerance=1.0d-10)
        @assertEqual(uAA - dt*(uAA**3)*nAA,uInit,tolerance=1.0d-10)

        ! Confirm AA accelerates convergence while filling and rolling over the depth-3 history
        @assertTrue(itersAA < itersNoAA)
        @assertTrue(itersAA > 4)
        @assertTrue(itersDamped < itersNoAA)

    contains

        subroutine runCoupledSolve(aaDepth,relaxW,nOut,uOut,itersOut)
            integer(ik)            ,intent(in)  :: aaDepth
            real(rk)               ,intent(in)  :: relaxW
            real(rk) ,dimension(3) ,intent(out) :: nOut ,uOut
            integer(ik)            ,intent(out) :: itersOut

            type(variableContainer) :: locVarCont
            class(matrixTerm) ,allocatable :: matTerm
            type(testMatrixTerm) :: termN ,termU
            type(testCountingMBData) :: mbData
            class(model) ,allocatable :: locModel
            type(modeller) :: locModeller
            type(picardBDEIntegrator) :: locInteg
            type(petscController) :: locPETSc
            real(rk) ,allocatable ,dimension(:) :: countBuf
            integer(ik) :: k

            call locPETSc%init(testIndexing,testMPIController,solOptions)
            call locVarCont%init(testList,testListDerived,cRules,testIndexing,testPart,1,testMPIController%getWorldRank())
            locVarCont%variables(1)%entry = 1.0d0
            locVarCont%variables(2)%entry = 1.0d0
            locVarCont%variables(1)%entry(1:3) = nInit
            locVarCont%variables(2)%entry(1:3) = uInit
            locVarCont%variables(3)%entry = 0.0d0

            allocate(locModel)
            call locModel%init(2,0,1,1)
            call mbData%makeDefined()
            call locModel%setModelData(mbData)

            call termN%makeDefined()
            call termN%setEvolvedAndImplicitVar("n","n",locVarCont)
            call termN%setReqVars([stringArray("n"),stringArray("n")],[stringArray("u")],locVarCont)
            call termN%initRowData(reshape([(xOffset+k,k=1,3)],[1,3]),testMapping,testIndexing)
            allocate(matTerm,source=termN)
            call locModel%addImplicitTerm(matTerm,[1],[1],"n_cub_u")

            call termU%makeDefined()
            call termU%setEvolvedAndImplicitVar("u","u",locVarCont)
            call termU%setReqVars([stringArray("u"),stringArray("u")],[stringArray("n")],locVarCont)
            call termU%initRowData(reshape([(xOffset+k,k=1,3)],[1,3]),testMapping,testIndexing)
            allocate(matTerm,source=termU)
            call locModel%addImplicitTerm(matTerm,[1],[1],"u_cub_n")

            call locModeller%init(1,locVarCont,testMPIController,locPETSc)
            call locModeller%addModel(locModel)
            call locModeller%calculateIdentityMat(testIndexing)
            call locModeller%assemble(withIdentityMat=.true.)

            call locInteg%init(testIndexing,testMPIController%getWorldRank(),nonlinTol=1.0d-12,maxIters=100,&
                               convergenceIndices=[1,2],modelList=[1],termGroups=[intArray([1])],&
                               evolvesTimeVar=.false.,initialTimestep=dt,relaxationWeight=relaxW,andersonDepth=aaDepth)
            call locInteg%setCommunicationNeeded(.false.)
            call locInteg%setNonTrivialModelDataUpdate(.true.)
            call locInteg%setModelDataUpdateRules([.true.])
            call locModeller%setIntegrator(locInteg)
            call locModeller%integrate()

            call locModeller%copyDataFromModel(1,"count",countBuf)
            itersOut = nint(countBuf(1))
            call locModeller%copyVarValuesTo(locVarCont)
            nOut = locVarCont%variables(1)%entry(1:3)
            uOut = locVarCont%variables(2)%entry(1:3)
        end subroutine runCoupledSolve

    end subroutine test_modeller_BDE_anderson

    @test( npes=[8])
    subroutine test_modeller_BDE_anderson_safeguards(this)
        class (MpiTestMethod), intent(inout) :: this
        type(MPIController) :: testMPIController
        type(partition) :: testPart
        type(grid) :: testGrid
        type(variableList) :: testList ,testListDerived
        type(indexing) :: testIndexing
        type(variableContainer) :: testVarCont
        type(calculationRule) ,dimension(1) :: cRules
        class(matrixTerm) ,allocatable :: matTerm
        type(testAffineMapTerm) :: mapN ,mapU
        type(testMatrixTerm) :: termCollinear
        type(testCountingMBData) :: mbData
        class(model) ,allocatable :: testModel
        type(modeller) :: testModeller1 ,testModeller2
        type(picardBDEIntegrator) :: testIntegrator1 ,testIntegrator2
        type(petscController) :: testPETSc1 ,testPETSc2
        type(solverOptions) :: solOptions

        integer(ik) :: i ,xOffset ,itersGuard
        real(rk) :: nSol
        real(rk) ,allocatable ,dimension(:) :: countBuf

        call testMPIController%init(8,1)
        call preparePrinter(testMPIController%getWorldRank())

        call testPart%initSimplePartition(8,1,24,1)
        call testGrid%init(real([(i,i=1,24)],kind=rk),real([(i,i=1,5)],kind=rk),0,0)

        call testList%init()
        call testList%addVar("n")
        call testList%addVar("u")

        call testListDerived%init()
        call testListDerived%addVar("time")
        call cRules(1)%init()

        call testIndexing%init(testPart,testGrid,testList)
        solOptions%kspSolverType = "bcgs"
        solOptions%hyprePC = ""
        solOptions%petscOptions = ""
        call testPETSc1%init(testIndexing,testMPIController,solOptions)

        call testVarCont%init(testList,testListDerived,cRules,testIndexing,testPart,1,testMPIController%getWorldRank())
        xOffset = testMPIController%getWorldRank()*3

        ! Subcase 1: False AA convergence rejection + under-relaxed recovery.
        ! Affine fixed-point map g(n,u) = (n - 0.4*u + 0.8, 0.4*n + 0.2*u + 0.8) has unique fixed point (2,2).
        ! Starting from (1.0, 1.5) with w = 0.5: f_0 = (0.2, 0.0), x_1 = (1.1, 1.5), f_1 = (0.2, 0.04).
        ! Then DeltaF_1 = (0.0, 0.04) is orthogonal to f_0, giving gamma_1 = 1.0 and x_2^{AA} = x_1 identically.
        ! The false-convergence guard must reject x_2^{AA}, reset AA history, restore damped Picard, and converge to (2,2).
        testVarCont%variables(1)%entry = 1.0d0
        testVarCont%variables(2)%entry = 1.5d0
        testVarCont%variables(3)%entry = 0.0d0

        allocate(testModel)
        call testModel%init(2,0,1,1)
        call mbData%makeDefined()
        call testModel%setModelData(mbData)

        mapN%a1 = 1.0d0
        mapN%a2 = -0.4d0
        mapN%c0 = 0.8d0
        mapN%xInit = 1.0d0
        call mapN%makeDefined()
        call mapN%setEvolvedAndImplicitVar("n","n",testVarCont)
        call mapN%setReqVars([stringArray("n"),stringArray("u")],[stringArray("n")],testVarCont)
        call mapN%initRowData(reshape([(xOffset+i,i=1,3)],[1,3]),testMapping,testIndexing)
        allocate(matTerm,source=mapN)
        call testModel%addImplicitTerm(matTerm,[1],[1],"map_n")

        mapU%a1 = 0.4d0
        mapU%a2 = 0.2d0
        mapU%c0 = 0.8d0
        mapU%xInit = 1.5d0
        call mapU%makeDefined()
        call mapU%setEvolvedAndImplicitVar("u","u",testVarCont)
        call mapU%setReqVars([stringArray("n"),stringArray("u")],[stringArray("u")],testVarCont)
        call mapU%initRowData(reshape([(xOffset+i,i=1,3)],[1,3]),testMapping,testIndexing)
        allocate(matTerm,source=mapU)
        call testModel%addImplicitTerm(matTerm,[1],[1],"map_u")

        call testModeller1%init(1,testVarCont,testMPIController,testPETSc1)
        call testModeller1%addModel(testModel)
        call testModeller1%calculateIdentityMat(testIndexing)
        call testModeller1%assemble(withIdentityMat=.true.)

        call testIntegrator1%init(testIndexing,testMPIController%getWorldRank(),nonlinTol=1.0d-12,maxIters=100,&
                                  convergenceIndices=[1,2],modelList=[1],termGroups=[intArray([1])],&
                                  evolvesTimeVar=.false.,initialTimestep=1.0d0,relaxationWeight=0.5d0,andersonDepth=3)
        call testIntegrator1%setCommunicationNeeded(.false.)
        call testIntegrator1%setNonTrivialModelDataUpdate(.true.)
        call testIntegrator1%setModelDataUpdateRules([.true.])
        call testModeller1%setIntegrator(testIntegrator1)
        call testModeller1%integrate()

        call testModeller1%copyVarValuesTo(testVarCont)
        call testModeller1%copyDataFromModel(1,"count",countBuf)
        itersGuard = nint(countBuf(1))
        @assertTrue(itersGuard > 2)
        @assertEqual(testVarCont%variables(1)%entry(1:3),[2.0d0,2.0d0,2.0d0],tolerance=1.0d-11)
        @assertEqual(testVarCont%variables(2)%entry(1:3),[2.0d0,2.0d0,2.0d0],tolerance=1.0d-11)

        ! Subcase 2: Collinear history rejection in 1D uniform subspace with andersonDepth = 3.
        ! Only n evolves uniformly (u = 1 constant), so all DeltaF columns are collinear (rank 1) and
        ! CGS2 QR must drop dependent columns cleanly without FPEs and converge to n - 0.12*n^3 = 1.
        testVarCont%variables(1)%entry = 1.0d0
        testVarCont%variables(2)%entry = 1.0d0
        testVarCont%variables(3)%entry = 0.0d0

        allocate(testModel)
        call testModel%init(1,0,1,1)
        call termCollinear%makeDefined()
        call termCollinear%setEvolvedAndImplicitVar("n","n",testVarCont)
        call termCollinear%setReqVars([stringArray("n"),stringArray("u")],[stringArray("n")],testVarCont)
        call termCollinear%initRowData(reshape([(xOffset+i,i=1,3)],[1,3]),testMapping,testIndexing)
        allocate(matTerm,source=termCollinear)
        call testModel%addImplicitTerm(matTerm,[1],[1],"collinear_n")

        call testPETSc2%init(testIndexing,testMPIController,solOptions)
        call testModeller2%init(1,testVarCont,testMPIController,testPETSc2)
        call testModeller2%addModel(testModel)
        call testModeller2%calculateIdentityMat(testIndexing)
        call testModeller2%assemble(withIdentityMat=.true.)

        call testIntegrator2%init(testIndexing,testMPIController%getWorldRank(),nonlinTol=1.0d-12,maxIters=100,&
                                  convergenceIndices=[1],modelList=[1],termGroups=[intArray([1])],&
                                  evolvesTimeVar=.false.,initialTimestep=0.12d0,relaxationWeight=0.5d0,andersonDepth=3)
        call testIntegrator2%setCommunicationNeeded(.false.)
        call testModeller2%setIntegrator(testIntegrator2)
        call testModeller2%integrate()

        call testModeller2%copyVarValuesTo(testVarCont)
        nSol = testVarCont%variables(1)%entry(1)
        @assertEqual(testVarCont%variables(1)%entry(1:3),[nSol,nSol,nSol],tolerance=1.0d-12)
        @assertEqual(nSol - 0.12d0*(nSol**3),1.0d0,tolerance=1.0d-11)

    end subroutine test_modeller_BDE_anderson_safeguards

    @test( npes=[8])
    subroutine test_modeller_composite_int(this)

        class (MpiTestMethod), intent(inout) :: this
        type(MPIController) :: testMPIController 
        type(partition) :: testPart
        type(grid) :: testGrid
        type(variableList) :: testList ,testListDerived
        type(indexing) :: testIndexing
        type(variableContainer) :: testVarCont
        type(calculationRule) ,dimension(1) :: cRules
        class(term) ,allocatable :: genTerm
        class(matrixTerm) ,allocatable :: matTerm
        type(testExplicitTerm) :: testTermExp
        type(testMatrixTerm) :: testTermMat
        class(model) ,allocatable :: testModel
        type(testOperator) :: testOp
        type(modeller) :: testModeller
        type(explicitRKIntegrator) :: testIntegratorRK
        type(picardBDEIntegrator) :: testIntegratorBDE
        type(petscController) :: testPETScController 
        type(solverOptions) :: solOptions 
        type(compositeIntegrator) :: testIntegratorComp
        type(integratorCallStep) ,dimension(2) :: testStages



        integer(ik) :: i,xOffset

        call testMPIController%init(8,1)
        call preparePrinter(testMPIController%getWorldRank())

        call testPart%initSimplePartition(8,1,24,1)
        call testGrid%init(real([(i,i=1,24)],kind=rk),real([(i,i=1,5)],kind=rk),0,0)

        call testList%init()
        call testList%addVar("n")
        call testList%addVar("u")

        call testListDerived%init()
        call testListDerived%addVar("time")

        call cRules(1)%init()

        call testIndexing%init(testPart,testGrid,testList)
        solOptions%kspSolverType = "bcgs"
        solOptions%hyprePC = ""
        solOptions%petscOptions = ""
        call testPETScController%init(testIndexing,testMPIController,solOptions) 
        call testVarCont%init(testList,testListDerived,cRules,testIndexing,testPart,1,testMPIController%getWorldRank())
        allocate(testModel)
        call testModel%init(1,1,1,2)

        testVarCont%variables(1)%entry = 1.0d0
        testVarCont%variables(2)%entry = 1.0d0
        testVarCont%variables(3)%entry = 0.0d0


        call testTermExp%init("n",testVarCont)

        call testTermExp%setEvolvedVar("n")
        call testOP%makeDefined()
        call testTermExp%setOperator(testOp)

        allocate(genTerm,source=testTermExp)

        call testModel%addGeneralTerm(genTerm,[1],"3")

        call testTermMat%makeDefined()
        xOffset = testMPIController%getWorldRank()*3
        call testTermMat%setEvolvedAndImplicitVar("n","u",testVarCont)
        call testTermMat%setReqVars([stringArray("n"),stringArray("u")],[stringArray("u")],testVarCont)
        call testTermMAt%initRowData(reshape([(xOffset+i,i=1,3)],[1,3]),testMapping,testIndexing)

        allocate(matTerm,source=testTermMat)
        call testModel%addImplicitTerm(matTerm,[1],[2],"4")

        call testModeller%init(1,testVarCont,testMPIController,testPETScController)
        
        call testModeller%addModel(testModel)

        call testModeller%calculateIdentityMat(testIndexing)

        call testModeller%assemble(withIdentityMat=.true.)

        call testIntegratorBDE%init(testIndexing,testMPIController%getWorldRank())
        call testIntegratorRK%init(order=1)

        call testIntegratorComp%init(0.0d0,0.1d0,2) 
        call testIntegratorComp%addIntegrator(testIntegratorRK)

        call testIntegratorComp%addIntegrator(testIntegratorBDE)

        testStages(1)%integratorIndex = 1
        testStages(1)%modelIndices = [1]
        testStages(1)%groupIndices = [intArray([2])]
        testStages(1)%globalStepFraction = 1.0d0

        testStages(2)%integratorIndex = 2
        testStages(2)%modelIndices = [1]
        testStages(2)%groupIndices = [intArray([1])]
        testStages(2)%globalStepFraction = 1.0d0

        call testIntegratorComp%addIntegrationStage(testStages(1))
        call testIntegratorComp%addIntegrationStage(testStages(2))

        call testModeller%setIntegrator(testIntegratorComp)
        call testModeller%integrate()

        call testModeller%copyVarValuesTo(testVarCont)

        call assertEqual(testVarCont%variables(3)%entry(1),0.1d0)
        call assertEqual(testVarCont%variables(1)%entry(1),1.2d0/0.9d0,tolerance=1d-12)
        call assertEqual(testVarCont%variables(2)%entry(1),1.0d0)

        ! PETSc remains initialized for the remaining tests in this binary.

    end subroutine test_modeller_composite_int

    @test( npes=[8])
    subroutine test_modeller_CVODE_int(this)

        class (MpiTestMethod), intent(inout) :: this
        type(MPIController) :: testMPIController 
        type(partition) :: testPart
        type(grid) :: testGrid
        type(variableList) :: testList ,testListDerived
        type(indexing) :: testIndexing
        type(variableContainer) :: testVarCont
        type(calculationRule) ,dimension(1) :: cRules
        class(term) ,allocatable :: genTerm
        type(testExplicitTerm) :: testTerm
        class(model) ,allocatable :: testModel
        type(testOperator) :: testOp
        type(modeller) :: testModeller
        type(CVODEIntegrator) :: testIntegrator
        type(CVODEOptions) :: testOptions

        integer(ik) :: i

        call testMPIController%init(8,1)

        call testPart%initSimplePartition(8,1,24,1)
        call testGrid%init(real([(i,i=1,24)],kind=rk),real([(i,i=1,5)],kind=rk),0,0)

        call testList%init()
        call testList%addVar("n")
        call testList%addVar("u")

        call preparePrinter(testMPIController%getWorldRank())

        call testListDerived%init()
        call testListDerived%addVar("time")

        call cRules(1)%init()

        call testIndexing%init(testPart,testGrid,testList)

        call testVarCont%init(testList,testListDerived,cRules,testIndexing,testPart,1,testMPIController%getWorldRank())
        allocate(testModel)
        call testModel%init(0,1,0,1)

        testVarCont%variables(1)%entry = 1.0d0
        testVarCont%variables(2)%entry = 2.0d0
        testVarCont%variables(3)%entry = 0.0d0


        call testTerm%init("n",testVarCont)

        call testTerm%setEvolvedVar("n")
        call testOP%makeDefined()
        call testTerm%setOperator(testOp)

        allocate(genTerm,source=testTerm)

        call testModel%addGeneralTerm(genTerm,[1],"1")

        call testModeller%init(1,testVarCont,testMPIController)
        
        call testModeller%addModel(testModel)

        call testModeller%assemble()

        @assertTrue(testModeller%isAssembled())

        testOptions%reltol = 1d-12
        testOptions%abstol = 1d-14 
        testOptions%bbdmukeep = 0
        testOptions%bbdmlkeep = 0
        testOptions%bbdmldq = 0
        testOptions%bbdmudq = 0
        testOptions%maxRestarts = 0
        testOptions%maxOrder = 5

        call testIntegrator%init(testMPIController,testOptions,modelList=[1],termGroups=[intArray([1])],&
                                evolvesTimeVar=.true.,initialTimestep=0.1d0)
        call testIntegrator%setCommunicationNeeded(.false.)
        call testIntegrator%setUpdateRules([logicalArray([.false.])])

        @assertEqual(testModeller%getCurrentTime(),0.d0)
        call testModeller%setIntegrator(testIntegrator)
        call testModeller%integrate()
        call testModeller%integrate()

        call testModeller%copyVarValuesTo(testVarCont)

        call assertEqual(testVarCont%variables(3)%entry(1),0.2d0)
        call assertEqual(testVarCont%variables(1)%entry(1),1.49182469764d0,tolerance=1d-10)
        call assertEqual(testVarCont%variables(2)%entry(1),2.0d0)



    end subroutine test_modeller_CVODE_int

    @test( npes=[8])
    subroutine test_term_evaluator_multimodel(this)

        class (MpiTestMethod), intent(inout) :: this
        type(MPIController) :: testMPIController
        type(partition) :: testPart
        type(grid) :: testGrid
        type(variableList) :: testList ,testListDerived
        type(indexing) :: testIndexing
        type(variableContainer) :: testVarCont
        type(calculationRule) ,dimension(1) :: cRules
        class(model) ,allocatable :: model1 ,model2 ,model3
        type(modeller) :: testModeller
        type(petscController) :: testPETScController
        type(solverOptions) :: solOptions
        type(CompositeManipulator) :: testManipulator
        type(TermEvaluator) :: testMultiEvaluator

        integer(ik) :: i ,xOffset
        real(rk) ,allocatable ,dimension(:) :: countBuf

        call testMPIController%init(8,1)
        call preparePrinter(testMPIController%getWorldRank())

        call testPart%initSimplePartition(8,1,24,1)
        call testGrid%init(real([(i,i=1,24)],kind=rk),real([(i,i=1,5)],kind=rk),0,0)

        call testList%init()
        call testList%addVar("n")
        call testList%addVar("u")

        call testListDerived%init()
        call testListDerived%addVar("eval")
        call cRules(1)%init()

        call testIndexing%init(testPart,testGrid,testList)
        solOptions%kspSolverType = "bcgs"
        solOptions%hyprePC = ""
        solOptions%petscOptions = ""
        call testPETScController%init(testIndexing,testMPIController,solOptions)

        call testVarCont%init(testList,testListDerived,cRules,testIndexing,testPart,1,testMPIController%getWorldRank())
        testVarCont%variables(1)%entry = 1.0d0
        testVarCont%variables(2)%entry = 1.0d0
        testVarCont%variables(3)%entry = 0.0d0

        xOffset = testMPIController%getWorldRank()*3

        ! Three models with counting modelbound data and polynomial matrix terms:
        ! m1_t1 = n^4, m1_t2 = n*u^3, m2_t1 = n^3*u, m3_t1 = u^4
        call initCountingModel(model1,2)
        call addSimpleMatTerm(model1,"m1_t1","n","n","n","n","n")
        call addSimpleMatTerm(model1,"m1_t2","n","u","n","u","u")

        call initCountingModel(model2,1)
        call addSimpleMatTerm(model2,"m2_t1","n","n","n","u","n")

        call initCountingModel(model3,1)
        call addSimpleMatTerm(model3,"m3_t1","n","u","u","u","u")

        call testModeller%init(3,testVarCont,testMPIController,testPETScController)
        call testModeller%addModel(model1)
        call testModeller%addModel(model2)
        call testModeller%addModel(model3)

        call testManipulator%init(1)
        call testMultiEvaluator%init(3,[1,2,1,3],&
                                     [StringArray("m1_t1"),StringArray("m2_t1"),StringArray("m1_t2"),StringArray("m3_t1")],&
                                     update=.true.)
        call testManipulator%addManipulator(testMultiEvaluator,0)
        call testModeller%setManipulator(testManipulator)

        call testModeller%calculateIdentityMat(testIndexing)
        call testModeller%assemble(withIdentityMat=.true.)

        ! Mutate variables after assembly so stale matrix entries (1.0) differ from updated entries:
        ! n = 2, u = 3 => n^4 + n^3*u + n*u^3 + u^4 = 16 + 24 + 54 + 81 = 175
        testVarCont%variables(1)%entry = 2.0d0
        testVarCont%variables(2)%entry = 3.0d0
        call testModeller%copyVarValuesFrom(testVarCont)

        call testModeller%callManipulator(0)
        call testModeller%copyVarValuesTo(testVarCont)

        @assertEqual(testVarCont%variables(3)%entry,real([0,175,175,175,0],kind=rk),tolerance=1d-12)

        ! Verify each model's modelbound data was updated once (model 1 deduplicated, model 3 not skipped)
        do i = 1,3
            call testModeller%copyDataFromModel(i,"count",countBuf)
            @assertEqual(countBuf,[1.0d0],tolerance=1d-14)
        end do

        call testPETScController%finalize()

    contains

        subroutine initCountingModel(targetModel,numImplicitTerms)
            class(model) ,allocatable ,intent(out) :: targetModel
            integer(ik)               ,intent(in)  :: numImplicitTerms
            type(testCountingMBData) :: mbData

            allocate(targetModel)
            call targetModel%init(numImplicitTerms,0,1,1)
            call mbData%makeDefined()
            call targetModel%setModelData(mbData)
        end subroutine initCountingModel

        subroutine addSimpleMatTerm(targetModel,termName,evolvedVar,implicitVar,reqRow1,reqRow2,reqCol)
            class(model) ,intent(inout) :: targetModel
            character(*) ,intent(in)    :: termName ,evolvedVar ,implicitVar ,reqRow1 ,reqRow2 ,reqCol
            type(testMatrixTerm) :: rawTerm
            class(matrixTerm) ,allocatable :: matTerm
            integer(ik) :: k

            call rawTerm%makeDefined()
            call rawTerm%setEvolvedAndImplicitVar(evolvedVar,implicitVar,testVarCont)
            call rawTerm%setReqVars([stringArray(reqRow1),stringArray(reqRow2)],[stringArray(reqCol)],testVarCont)
            call rawTerm%initRowData(reshape([(xOffset+k,k=1,3)],[1,3]),testMapping,testIndexing)
            allocate(matTerm,source=rawTerm)
            call targetModel%addImplicitTerm(matTerm,[1],[1],termName)
        end subroutine addSimpleMatTerm

    end subroutine test_term_evaluator_multimodel

    subroutine testCountingUpdate(this,hostModel,inputVars,updatePriority)
        class(testCountingMBData) ,intent(inout) :: this
        class(ModelSurrogate)     ,intent(in)    :: hostModel
        class(VariableContainer)  ,intent(in)    :: inputVars
        integer(ik) ,optional     ,intent(in)    :: updatePriority

        this%updateCount = this%updateCount + 1
    end subroutine testCountingUpdate

    subroutine testCountingCopyData(this,name,container)
        class(testCountingMBData)             ,intent(in)    :: this
        character(*)                          ,intent(in)    :: name
        real(rk) ,allocatable ,dimension(..)  ,intent(inout) :: container

        select rank (container)
        rank (1)
            if (.not. allocated(container)) allocate(container(1))
            container(1) = real(this%updateCount,kind=rk)
        rank default
            error stop "container passed to testCountingCopyData is not rank 1"
        end select
    end subroutine testCountingCopyData

    function testCountingGetDataDim(this,name) result(dim)
        class(testCountingMBData) ,intent(in) :: this
        character(*)              ,intent(in) :: name
        integer(ik)                           :: dim

        dim = 0
    end function testCountingGetDataDim


    pure subroutine testAffineMapRow(this,varCont,rowVals,indexingData)
        class(testAffineMapTerm)      ,intent(inout) :: this
        type(VariableContainer)       ,intent(in)    :: varCont
        real(rk) ,dimension(:)        ,intent(inout) :: rowVals
        type(MatrixTermIndexingData)  ,intent(in)    :: indexingData

        real(rk) ,dimension(size(rowVals)) :: gVal

        gVal = this%a1 * varCont%variables(indexingData%rowReqVarIndices(1))%entry(indexingData%localRowIndices) &
             + this%a2 * varCont%variables(indexingData%rowReqVarIndices(2))%entry(indexingData%localRowIndices) &
             + this%c0
        rowVals = 1.0d0 - this%xInit / gVal
    end subroutine testAffineMapRow

    pure function testMapping(inputArray) result(output)

            integer(ik)    ,dimension(:)        ,intent(in) :: inputArray 
            type(intArray) ,allocatable ,dimension(:)       :: output

            allocate(output(size(inputArray)))

            allocate(output(1)%entry(1))
            output(1)%entry(1) = inputArray(1) 

        end function testMapping

end module test_modeller

