nt(in) :: numProc integer(kind=ik), intent(in) :: haloWidth type( Geometry ), intent(in) :: geometryObj logical, intent(in) :: leftBoundary logical, intent(in) :: staggeredVars logical, intent(in) :: interpolate","tags":"","url":"proc/initlogextrap.html"},{"title":"initNormalizationFromJSON – ReMKiT1D","text":"module subroutine initNormalizationFromJSON(this, jsonCont, mpiCont) Interface → Initialize normalization based on config.json, loading temperature, density, and reference ion charge. \nThe resulting object will have the following normalization quantities: density (in m&#94;{-3}) temperature (in eV) reference ion Z velocity (used for the velocity grid) speed (here equal to the velocity) time (normalized to e-i collision time) length (velocity * time) EField (here elMass * velocity/(elCharge * time)) heatFlux (here elMass * density * velocity&#94;3 /2) crossSection (here 1/(time density velocity)) All names taken from key_names module Arguments Type Intent Optional Attributes Name class( BasicNormalization ), intent(inout) :: this type( JSONController ), intent(inout) :: jsonCont JSONController used to get parameters from ./config.json type( MPIController ), intent(inout) :: mpiCont MPIController used with JSONController","tags":"","url":"proc/initnormalizationfromjson.html"},{"title":"calculateMultiplicative – ReMKiT1D","text":"module function calculateMultiplicative(this, inputArray, indices) result(output) Interface → Arguments Type Intent Optional Attributes Name class( MultiplicativeDerivation ), intent(inout) :: this type( RealArray ), intent(in), dimension(:) :: inputArray integer(kind=ik), intent(in), dimension(:) :: indices Return Value real(kind=rk), allocatable, dimension(:)","tags":"","url":"proc/calculatemultiplicative.html"},{"title":"initMultDeriv – ReMKiT1D","text":"module subroutine initMultDeriv(this, innerDeriv, innerIndices, outerDeriv, outerIndices, innerPower, outerPower, innerFuncName) Interface → Initialize multiplicative derivation object Arguments Type Intent Optional Attributes Name class( MultiplicativeDerivation ), intent(inout) :: this class( Derivation ), intent(in) :: innerDeriv integer(kind=ik), intent(in), dimension(:) :: innerIndices class( Derivation ), intent(in), optional :: outerDeriv integer(kind=ik), intent(in), optional, dimension(:) :: outerIndices real(kind=rk), intent(in), optional :: innerPower real(kind=rk), intent(in), optional :: outerPower character(len=*), intent(in), optional :: innerFuncName","tags":"","url":"proc/initmultderiv.html"},{"title":"unityFun – ReMKiT1D","text":"module function unityFun(this, varCont) result(res) Interface → Default multiplicative function - returns a real vector of ones based on evolvedVarName. In general should use passed\nvariable container to construct a vector conforming to the evolved variable Arguments Type Intent Optional Attributes Name class( ExplicitTerm ), intent(in) :: this type( VariableContainer ), intent(in) :: varCont Return Value real(kind=rk), allocatable, dimension(:)","tags":"","url":"proc/unityfun.html"},{"title":"evaluateExpTerm – ReMKiT1D","text":"module function evaluateExpTerm(this, varCont) result(res) Interface → Evaluates the term as multConst * multFun [* operatorTerm%actOn( )] depending on whether the Operator is allocated Arguments Type Intent Optional Attributes Name class( ExplicitTerm ), intent(in) :: this type( VariableContainer ), intent(in) :: varCont Return Value real(kind=rk), allocatable, dimension(:)","tags":"","url":"proc/evaluateexpterm.html"},{"title":"getEvolvedVarName – ReMKiT1D","text":"pure module function getEvolvedVarName(this) result(name) Interface → Get name of the evolved variable of this term Arguments Type Intent Optional Attributes Name class( ExplicitTerm ), intent(in) :: this Return Value character(len=:), allocatable","tags":"","url":"proc/getevolvedvarname.html"},{"title":"simpleUpdate – ReMKiT1D","text":"module subroutine simpleUpdate(this, varCont, modelData, hostModel) Interface